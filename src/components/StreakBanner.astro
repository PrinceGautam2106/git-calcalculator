---
---

<div id="streak-banner" class="group relative overflow-hidden border-b border-black/10 bg-gray-50 py-2.5 dark:border-white/10 dark:bg-[#111]">
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6">
    <div class="flex items-center justify-between gap-3">
      <!-- Left side: Fire Icon & Text Message -->
      <div class="flex items-center gap-1.5 sm:gap-2.5 overflow-hidden min-w-0 flex-1">
        <div id="streak-banner-fire" class="text-base sm:text-xl transition-transform group-hover:scale-110 flex-shrink-0">🔥</div>
        <p id="streak-banner-text" class="text-xs sm:text-sm font-semibold tracking-tight text-black/90 dark:text-white/90 truncate"></p>
      </div>
      
      <!-- Right side: Compact Weekdays tracker -->
      <div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">
        {[...Array(7)].map((_, i) => (
          <div class="flex flex-col items-center gap-0.5 sm:gap-1">
            <span class="text-[8px] sm:text-[9px] font-bold uppercase text-black/45 dark:text-white/45">
              {['M', 'T', 'W', 'T', 'F', 'S', 'S'][i]}
            </span>
            <div 
              class="w-5 h-5 sm:w-6 sm:h-6 rounded-full flex items-center justify-center text-[9px] sm:text-xs font-bold transition-all streak-dot bg-black/5 dark:bg-white/5 text-black/30 dark:text-white/30" 
              data-day={i}
            >
              •
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  import { getStreakData } from '../utils/localStorage';
  import { t } from '../utils/i18n';

  let messages: string[] = [];
  let currentIndex = 0;

  const updateBannerContent = (lang: string) => {
    try {
      const data = getStreakData();
      const streak = data.currentStreak;
      const dots = document.querySelectorAll('.streak-dot');

      const milestones: Record<number, string> = {
        3: t('milestone_3', lang),
        7: t('milestone_7', lang),
        14: t('milestone_14', lang),
        30: t('milestone_30', lang)
      };

      const baseMessage = streak > 0 
        ? `${t('day', lang)} ${streak} ${t('check_in', lang)}` 
        : t('start_today', lang);

      const currentMilestone = milestones[streak] || t('keep_fire', lang);
      
      messages = [
        baseMessage,
        currentMilestone,
        t('track_daily', lang),
        t('stay_consistent', lang)
      ];

      // Set initial message
      const textEl = document.getElementById('streak-banner-text');
      if (textEl && messages.length > 0) {
        textEl.textContent = messages[currentIndex];
      }

      // Update dots for the current calendar week (Monday to Sunday)
      const todayDate = new Date();
      const currentDay = todayDate.getUTCDay();
      const daysToMonday = currentDay === 0 ? 6 : currentDay - 1;
      
      const mondayDate = new Date(todayDate);
      mondayDate.setUTCDate(todayDate.getUTCDate() - daysToMonday);
      
      const todayStr = todayDate.toISOString().split('T')[0];
      const userHistory = data.history || [];

      dots.forEach((dot, i) => {
        const d = new Date(mondayDate);
        d.setUTCDate(mondayDate.getUTCDate() + i);
        const dateStr = d.toISOString().split('T')[0];
        
        const isCompleted = userHistory.includes(dateStr);
        const isToday = dateStr === todayStr;
        const isFuture = d.getTime() > todayDate.getTime() && d.getUTCDate() !== todayDate.getUTCDate();
        
        // Reset classes
        dot.className = "w-5 h-5 sm:w-6 sm:h-6 rounded-full flex items-center justify-center text-[9px] sm:text-xs font-bold transition-all streak-dot";
        dot.setAttribute('title', `${['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][i]} (${dateStr})`);
        
        if (isCompleted) {
          dot.classList.add('bg-gradient-to-br', 'from-[#50e3c2]', 'to-[#0070f3]', 'text-white', 'shadow-[0_0_8px_rgba(80,227,194,0.3)]');
          dot.innerHTML = '✓';
        } else if (isToday) {
          dot.classList.add('border-2', 'border-dashed', 'border-[#50e3c2]', 'text-[#50e3c2]', 'animate-pulse');
          dot.innerHTML = '•';
        } else if (isFuture) {
          dot.classList.add('bg-black/5', 'dark:bg-white/5', 'text-black/20', 'dark:text-white/20', 'border', 'border-black/5', 'dark:border-white/5');
          dot.innerHTML = '';
        } else {
          // Missed past day
          dot.classList.add('bg-black/5', 'dark:bg-white/5', 'text-black/30', 'dark:text-white/30', 'border', 'border-black/10', 'dark:border-white/10');
          dot.innerHTML = '×';
        }
      });

      const fire = document.getElementById('streak-banner-fire');
      if (fire) {
        fire.textContent = streak === 0 ? '🌑' : '🔥';
      }
    } catch (e) {
      console.error('Streak banner error:', e);
    }
  };

  // Initial State
  const savedLang = localStorage.getItem('fc_language') || 'en';
  updateBannerContent(savedLang);

  // Transition animation logic
  const textEl = document.getElementById('streak-banner-text');
  if (textEl) {
    setInterval(() => {
      if (messages.length === 0) return;
      
      // Step 1: Slide out
      textEl.classList.remove('text-slide-active');
      textEl.classList.add('text-slide-exit');
      
      setTimeout(() => {
        // Step 2: Swap content
        currentIndex = (currentIndex + 1) % messages.length;
        textEl.textContent = messages[currentIndex];
        
        // Step 3: Slide in
        textEl.classList.remove('text-slide-exit');
        textEl.classList.add('text-slide-active');
      }, 400); // matches transition time
    }, 4500);
  }

  // Listen for language changes
  window.addEventListener('languageChanged', (e: any) => {
    updateBannerContent(e.detail.language);
  });
</script>

<style>
  .text-slide-active {
    animation: slide-in-fade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .text-slide-exit {
    animation: slide-out-fade 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes slide-in-fade {
    from {
      opacity: 0;
      transform: translateY(8px);
      filter: blur(1px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @keyframes slide-out-fade {
    from {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
    to {
      opacity: 0;
      transform: translateY(-8px);
      filter: blur(1px);
    }
  }
</style>
