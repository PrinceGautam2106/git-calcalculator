---
/**
 * Divider.astro
 * Semantic horizontal rule with optional label.
 *
 * Usage:
 *   <Divider />
 *   <Divider label="or continue with" />
 *   <Divider spacing="xl" />
 */

interface Props {
  label?: string;
  spacing?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
}

const {
  label,
  spacing = 'md',
  class: className = '',
} = Astro.props;

const spacingMap = {
  sm: 'my-3',
  md: 'my-6',
  lg: 'my-8',
  xl: 'my-12',
};

const classes = [spacingMap[spacing], className].join(' ');
---

{label ? (
  <div class={`flex items-center gap-3 ${classes}`} role="separator" aria-label={label}>
    <div class="flex-1 h-px bg-[var(--color-border)]" aria-hidden="true"></div>
    <span class="text-xs text-[var(--color-mute)] whitespace-nowrap select-none font-medium">
      {label}
    </span>
    <div class="flex-1 h-px bg-[var(--color-border)]" aria-hidden="true"></div>
  </div>
) : (
  <hr class={`border-0 border-t border-[var(--color-border)] ${classes}`} />
)}
