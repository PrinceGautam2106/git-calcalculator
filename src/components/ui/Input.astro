---
/**
 * Input.astro
 * Accessible form input with label, helper text, and error state.
 *
 * Usage:
 *   <Input id="weight" label="Weight (kg)" type="number" placeholder="75" />
 *   <Input id="email" label="Email" type="email" error="Invalid email address" />
 *   <Input id="bio" label="Bio" helper="Max 160 characters" />
 */

interface Props {
  id: string;
  name?: string;
  label?: string;
  type?: 'text' | 'email' | 'number' | 'password' | 'tel' | 'url' | 'search';
  placeholder?: string;
  value?: string | number;
  helper?: string;
  error?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  min?: string | number;
  max?: string | number;
  step?: string | number;
  autocomplete?: string;
  class?: string;
  inputClass?: string;
  suffix?: string;   // unit label shown inside input right-side, e.g. "kg"
  prefix?: string;   // icon/text shown inside input left-side, e.g. "$"
}

const {
  id,
  name = id,
  label,
  type = 'text',
  placeholder,
  value,
  helper,
  error,
  required = false,
  disabled = false,
  readonly = false,
  min,
  max,
  step,
  autocomplete,
  class: className = '',
  inputClass = '',
  suffix,
  prefix,
} = Astro.props;

const hasError = Boolean(error);

const wrapperClasses = ['flex flex-col gap-1.5 w-full', className].join(' ');

const inputBaseClasses = [
  'w-full text-sm font-normal font-sans',
  'bg-[var(--color-canvas)] text-[var(--color-ink)]',
  'border rounded-sm',
  'h-9 px-3',
  'transition-colors duration-150',
  'placeholder:text-[var(--color-mute)]',
  'focus:outline-none focus:ring-2 focus:ring-offset-0',
  hasError
    ? 'border-[var(--color-error)] focus:ring-[var(--color-error)]/30'
    : 'border-[var(--color-hairline)] focus:ring-[var(--color-primary)]/30 focus:border-[var(--color-border-focus)]',
  disabled ? 'opacity-50 cursor-not-allowed' : '',
  prefix ? 'pl-8' : '',
  suffix ? 'pr-10' : '',
  inputClass,
].filter(Boolean).join(' ');
---

<div class={wrapperClasses}>
  {label && (
    <label
      for={id}
      class="text-xs font-medium text-[var(--color-body)] flex items-center gap-1"
    >
      {label}
      {required && <span class="text-[var(--color-error)] text-xs" aria-hidden="true">*</span>}
    </label>
  )}

  <div class="relative">
    {prefix && (
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-mute)] text-sm pointer-events-none select-none" aria-hidden="true">
        {prefix}
      </span>
    )}

    <input
      {id}
      {name}
      {type}
      {placeholder}
      value={value}
      {required}
      {disabled}
      readonly={readonly}
      min={min}
      max={max}
      step={step}
      autocomplete={autocomplete}
      aria-invalid={hasError}
      aria-describedby={hasError ? `${id}-error` : (helper ? `${id}-helper` : undefined)}
      class={inputBaseClasses}
    />

    {suffix && (
      <span class="absolute right-3 top-1/2 -translate-y-1/2 text-[var(--color-mute)] text-xs font-mono pointer-events-none select-none" aria-hidden="true">
        {suffix}
      </span>
    )}
  </div>

  {error && (
    <p id={`${id}-error`} class="text-xs text-[var(--color-error)] flex items-center gap-1" role="alert">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
      </svg>
      {error}
    </p>
  )}

  {!error && helper && (
    <p id={`${id}-helper`} class="text-xs text-[var(--color-mute)]">
      {helper}
    </p>
  )}
</div>
