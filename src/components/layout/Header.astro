---
/**
 * Header.astro — Layout component
 * Sticky top nav: logo + desktop nav + dark mode toggle + mobile hamburger
 * Vercel-inspired: border-bottom, glassmorphism backdrop, clean typography
 */

const navLinks = [
  { href: '/',             label: 'Home' },
  { href: '/calculators',  label: 'Calculators' },
  { href: '/history',      label: 'History' },
  { href: '/about',        label: 'About' },
];

const blogCategories = [
  { href: '/blog',               label: 'All Articles',    emoji: '📚' },
  { href: '/blog/nutrition',     label: 'Nutrition',       emoji: '🥗' },
  { href: '/blog/training',      label: 'Training',        emoji: '🏋️' },
  { href: '/blog/fat-loss',      label: 'Fat Loss',        emoji: '🔥' },
  { href: '/blog/muscle-building', label: 'Muscle Building', emoji: '💪' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full"
  style="height: var(--nav-height);"
>
  <!-- Backdrop blur layer -->
  <div class="absolute inset-0 bg-[var(--color-canvas)]/80 backdrop-blur-xl border-b border-[var(--color-hairline)]" aria-hidden="true"></div>

  <div class="relative container-site flex items-center justify-between h-full">

    <!-- ── Logo ── -->
    <a
      href="/"
      class="flex items-center gap-2.5 group shrink-0"
      aria-label="CalaiFitness — Home"
    >
      <span class="text-sm font-semibold text-[var(--color-ink)] tracking-tight transition-colors duration-150 group-hover:text-[var(--color-primary)]">
        CalaiFitness
      </span>
    </a>

    <!-- ── Desktop Nav ── -->
    <nav
      class="hidden md:flex items-center gap-1"
      role="navigation"
      aria-label="Main navigation"
    >
      {navLinks.map(link => (
        <a
          href={link.href}
          class={[
            'relative px-3 py-1.5 text-sm rounded-sm transition-all duration-150',
            'font-medium',
            isActive(link.href)
              ? 'text-[var(--color-ink)] bg-[var(--color-hairline)]'
              : 'text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline)]',
          ].join(' ')}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}

      <!-- Blog Dropdown -->
      <div class="blog-dropdown-wrap" id="blog-dropdown-wrap">
        <button
          id="blog-dropdown-btn"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="blog-dropdown-menu"
          class={[
            'relative flex items-center gap-1 px-3 py-1.5 text-sm rounded-sm transition-all duration-150 font-medium cursor-pointer border-none bg-transparent',
            isActive('/blog')
              ? 'text-[var(--color-ink)] bg-[var(--color-hairline)]'
              : 'text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline)]',
          ].join(' ')}
        >
          Blog
          <svg class="blog-chevron w-3 h-3 transition-transform duration-150" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 9l6 6 6-6"/>
          </svg>
        </button>

        <div
          id="blog-dropdown-menu"
          role="menu"
          aria-label="Blog categories"
          class="blog-dropdown hidden"
        >
          {blogCategories.map(cat => (
            <a
              href={cat.href}
              role="menuitem"
              class={[
                'blog-dropdown-item',
                isActive(cat.href) && cat.href !== '/blog' ? 'active' : '',
                isActive('/blog') && cat.href === '/blog' && currentPath === '/blog' ? 'active' : '',
              ].join(' ')}
            >
              <span class="item-emoji" aria-hidden="true">{cat.emoji}</span>
              {cat.label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <!-- ── Right Actions ── -->
    <div class="flex items-center gap-2">

      <!-- Dark Mode Toggle -->
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="flex items-center justify-center w-8 h-8 rounded-sm border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline)] transition-all duration-150"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg id="icon-sun" class="w-4 h-4 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg id="icon-moon" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden flex items-center justify-center w-8 h-8 rounded-sm border border-[var(--color-hairline)] text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline)] transition-all duration-150"
      >
        <!-- Hamburger open -->
        <svg id="hamburger-icon" class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <!-- Close X -->
        <svg id="close-icon" class="w-4 h-4 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- ── Mobile Menu ── -->
  <div
    id="mobile-menu"
    class="md:hidden hidden absolute top-full left-0 right-0 z-40"
    role="navigation"
    aria-label="Mobile navigation"
  >
    <div class="bg-[var(--color-canvas)]/95 backdrop-blur-xl border-b border-[var(--color-hairline)]">
      <div class="container-site py-3 flex flex-col gap-1">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={[
              'flex items-center gap-2 px-3 py-2.5 text-sm font-medium rounded-sm transition-colors duration-150',
              isActive(link.href)
                ? 'text-[var(--color-ink)] bg-[var(--color-hairline)]'
                : 'text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline)]',
            ].join(' ')}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}

        <!-- Blog section in mobile -->
        <div class="px-3 pt-2 pb-1">
          <p class="text-[0.625rem] font-semibold uppercase tracking-widest text-[var(--color-mute)] mb-1">Blog</p>
        </div>
        {blogCategories.map(cat => (
          <a
            href={cat.href}
            class={[
              'flex items-center gap-2 px-3 py-2.5 text-sm font-medium rounded-sm transition-colors duration-150',
              (isActive(cat.href) && (cat.href !== '/blog' || currentPath === '/blog'))
                ? 'text-[var(--color-ink)] bg-[var(--color-hairline)]'
                : 'text-[var(--color-body)] hover:text-[var(--color-ink)] hover:bg-[var(--color-hairline)]',
            ].join(' ')}
            aria-current={(isActive(cat.href) && (cat.href !== '/blog' || currentPath === '/blog')) ? 'page' : undefined}
          >
            <span aria-hidden="true">{cat.emoji}</span>
            {cat.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  // ── Theme Toggle ──
  const themeToggle = document.getElementById('theme-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    iconSun?.classList.toggle('hidden', !isDark);
    iconMoon?.classList.toggle('hidden', isDark);
    themeToggle?.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
  }

  // Sync on load
  syncThemeIcons();

  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    const next = isDark ? 'light' : 'dark';
    if (typeof window.__setTheme === 'function') {
      window.__setTheme(next);
    } else {
      document.documentElement.classList.remove('dark', 'light');
      document.documentElement.classList.add(next);
      try { localStorage.setItem('theme', next); } catch (_) {}
    }
    syncThemeIcons();
  });

  // ── Mobile Menu ──
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function setMenuOpen(open: boolean) {
    mobileMenu?.classList.toggle('hidden', !open);
    hamburgerIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    mobileMenuBtn?.setAttribute('aria-expanded', String(open));
  }

  mobileMenuBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = mobileMenu?.classList.contains('hidden');
    setMenuOpen(!!isHidden);
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (
      mobileMenu &&
      !mobileMenu.classList.contains('hidden') &&
      !mobileMenu.contains(e.target as Node) &&
      !mobileMenuBtn?.contains(e.target as Node)
    ) {
      setMenuOpen(false);
    }
  });

  // Close on nav item click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });

  // ── Blog Dropdown ──
  const blogDropdownBtn = document.getElementById('blog-dropdown-btn');
  const blogDropdownMenu = document.getElementById('blog-dropdown-menu');
  const blogChevron = blogDropdownBtn?.querySelector('.blog-chevron') as HTMLElement | null;

  function setBlogDropdownOpen(open: boolean) {
    blogDropdownMenu?.classList.toggle('hidden', !open);
    blogDropdownBtn?.setAttribute('aria-expanded', String(open));
    if (blogChevron) {
      blogChevron.style.transform = open ? 'rotate(180deg)' : '';
    }
  }

  blogDropdownBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const isHidden = blogDropdownMenu?.classList.contains('hidden');
    setBlogDropdownOpen(!!isHidden);
  });

  // Close dropdown on outside click
  document.addEventListener('click', (e) => {
    const wrap = document.getElementById('blog-dropdown-wrap');
    if (wrap && !wrap.contains(e.target as Node)) {
      setBlogDropdownOpen(false);
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setBlogDropdownOpen(false);
  });
</script>

<style>
  .blog-dropdown-wrap {
    position: relative;
  }
  .blog-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    padding: 6px;
    z-index: 100;
    animation: dropdownFadeIn 120ms ease;
  }
  @keyframes dropdownFadeIn {
    from { opacity: 0; transform: translateX(-50%) translateY(-4px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
  .blog-dropdown-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-body);
    text-decoration: none;
    border-radius: 4px;
    transition: background 120ms ease, color 120ms ease;
    white-space: nowrap;
  }
  .blog-dropdown-item:hover,
  .blog-dropdown-item.active {
    background: var(--color-hairline);
    color: var(--color-ink);
  }
  .item-emoji { font-size: 1rem; width: 20px; text-align: center; }
</style>
