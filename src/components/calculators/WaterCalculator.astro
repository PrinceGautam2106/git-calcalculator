---
/**
 * WaterCalculator.astro
 * Self-contained Water Intake Calculator widget.
 * Formulas:
 *   Base: 35 ml per kg of body weight
 *   Exercise: 350 ml per 30 minutes of exercise
 *   Imperial conversion: 1 Liter = 33.814 fl oz
 * Zero dependencies · vanilla JS · localStorage history.
 */
---

<div class="water-calc" id="water-calculator" role="main" aria-label="Water Calculator">

  <!-- ── Unit Toggle ── -->
  <div class="unit-toggle-row" role="group" aria-label="Unit system">
    <span class="unit-label">Units</span>
    <div class="unit-toggle" role="tablist">
      <button id="water-unit-metric" class="unit-btn active" role="tab" aria-selected="true" type="button">Metric</button>
      <button id="water-unit-imperial" class="unit-btn" role="tab" aria-selected="false" type="button">Imperial</button>
    </div>
  </div>

  <!-- ── Inputs ── -->
  <div class="water-inputs" id="water-inputs">

    <!-- Weight -->
    <div class="input-group" id="water-weight-metric">
      <label for="water-weight-kg" class="input-label">Weight</label>
      <div class="input-wrap">
        <input type="number" id="water-weight-kg" class="water-input" placeholder="70" min="20" max="400" step="0.1" autocomplete="off" />
        <span class="input-unit">kg</span>
      </div>
    </div>
    <div class="input-group hidden" id="water-weight-imperial">
      <label for="water-weight-lbs" class="input-label">Weight</label>
      <div class="input-wrap">
        <input type="number" id="water-weight-lbs" class="water-input" placeholder="154" min="44" max="880" step="0.1" autocomplete="off" />
        <span class="input-unit">lbs</span>
      </div>
    </div>

    <!-- Daily Exercise Time -->
    <div class="input-group">
      <label for="water-exercise" class="input-label">Daily Exercise Duration</label>
      <div class="input-wrap">
        <input type="number" id="water-exercise" class="water-input" placeholder="30" min="0" max="360" step="5" autocomplete="off" />
        <span class="input-unit">minutes</span>
      </div>
    </div>

  </div><!-- /water-inputs -->

  <!-- ── Calculate Button ── -->
  <button id="water-calc-btn" type="button" class="calc-btn">
    Calculate Water Intake
  </button>

  <!-- ── Error ── -->
  <p id="water-error" class="water-error hidden" role="alert" aria-live="polite"></p>

  <!-- ── Results Panel ── -->
  <div id="water-result" class="water-result hidden" role="region" aria-label="Water intake result" aria-live="polite">
    <div class="result-hero">
      <p class="result-hero-label">Recommended Daily Hydration</p>
      <div class="result-hero-number-row">
        <span id="water-main-number" class="result-main-number">—</span>
        <span id="water-main-unit" class="result-main-unit">L/day</span>
      </div>
      <p id="water-cups-desc" class="result-category">—</p>
    </div>

    <!-- Details breakdown -->
    <div class="details-section">
      <p class="details-title">Hydration Breakdown</p>
      <div class="details-list">
        <div class="detail-row">
          <span>Baseline Needs (based on weight)</span>
          <span id="water-base-display" class="font-mono">—</span>
        </div>
        <div class="detail-row">
          <span>Exercise Replenishment</span>
          <span id="water-exercise-display" class="font-mono">—</span>
        </div>
      </div>
    </div>

    <!-- Save + Reset -->
    <div class="result-actions">
      <button id="water-save-btn" type="button" class="save-btn" aria-label="Save Water Intake to local history">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Save to History
      </button>
      <button id="water-reset-btn" type="button" class="reset-btn" aria-label="Recalculate">
        ← Recalculate
      </button>
    </div>
    <p id="water-saved-msg" class="saved-msg hidden" role="status">Saved ✓</p>
  </div>

</div>

<style>
.water-calc {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-family: var(--font-sans);
}

.unit-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.unit-label {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--color-mute);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.unit-toggle {
  display: inline-flex;
  gap: 2px;
  background-color: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 5px;
  padding: 2px;
}
.unit-btn {
  padding: 4px 14px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-mute);
  background: transparent;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}
.unit-btn.active {
  background-color: var(--color-canvas);
  color: var(--color-ink);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}
.dark .unit-btn.active {
  background-color: var(--color-surface);
  border: 1px solid var(--color-hairline);
  box-shadow: none;
}

.water-inputs { display: flex; flex-direction: column; gap: 10px; }

.input-group { display: flex; flex-direction: column; gap: 4px; }

.input-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-body);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.water-input {
  width: 100%;
  height: 38px;
  padding: 0 80px 0 10px;
  font-size: 0.9375rem;
  font-weight: 500;
  font-family: var(--font-mono);
  color: var(--color-ink);
  background-color: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  outline: none;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}
.water-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.water-input.input-error { border-color: var(--color-error); }

.input-unit {
  position: absolute;
  right: 10px;
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-mute);
  pointer-events: none;
}

.calc-btn {
  width: 100%;
  height: 42px;
  background-color: var(--color-ink);
  color: var(--color-canvas);
  font-size: 0.9375rem;
  font-weight: 600;
  border: 1px solid var(--color-ink);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
}
.calc-btn:hover {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
.calc-btn:active { transform: scale(0.99); }

.water-error {
  font-size: 0.8125rem;
  color: var(--color-error);
  background-color: var(--color-error-muted);
  border: 1px solid color-mix(in srgb, var(--color-error) 25%, transparent);
  border-radius: 4px;
  padding: 8px 12px;
  margin: 0;
}

.water-result {
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-top: 1px solid var(--color-hairline);
  padding-top: 18px;
  animation: fadeUp 280ms ease;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.result-hero {
  text-align: center;
  padding: 8px 0 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-hero-label {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-mute);
  margin: 0 0 4px;
}
.result-hero-number-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4px;
}
.result-main-number {
  font-family: var(--font-mono);
  font-size: 3rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}
.result-main-unit {
  font-size: 1rem;
  color: var(--color-mute);
  font-weight: 600;
}
.result-category {
  font-size: 0.875rem;
  font-weight: 600;
  margin-top: 4px;
  color: var(--color-cyan);
}

.details-section {}
.details-title {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-mute);
  margin: 0 0 8px;
}
.details-list {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  overflow: hidden;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 9px 12px;
  background-color: var(--color-canvas);
  border-bottom: 1px solid var(--color-hairline);
  font-size: 0.8125rem;
  color: var(--color-body);
}
.detail-row:last-child { border-bottom: none; }

.result-actions {
  display: flex;
  gap: 8px;
}
.save-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 36px;
  background-color: transparent;
  color: var(--color-body);
  font-size: 0.8125rem;
  font-weight: 500;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
}
.save-btn:hover {
  background-color: var(--color-canvas-soft);
  border-color: var(--color-hairline-strong);
  color: var(--color-ink);
}
.save-btn.saved { border-color: var(--color-success); color: var(--color-success); }

.reset-btn {
  background: none;
  border: none;
  color: var(--color-mute);
  font-size: 0.8125rem;
  cursor: pointer;
  padding: 0 12px;
  transition: color 150ms ease;
  white-space: nowrap;
}
.reset-btn:hover { color: var(--color-ink); }

.saved-msg {
  font-size: 0.75rem;
  text-align: center;
  color: var(--color-success);
  margin: 0;
  font-weight: 500;
}

.hidden { display: none !important; }
</style>

<script>
const metricBtn = document.getElementById('water-unit-metric') as HTMLButtonElement;
const imperialBtn = document.getElementById('water-unit-imperial') as HTMLButtonElement;
const calcBtn = document.getElementById('water-calc-btn') as HTMLButtonElement;
const errorEl = document.getElementById('water-error') as HTMLParagraphElement;
const resultEl = document.getElementById('water-result') as HTMLDivElement;

const weightKgInput = document.getElementById('water-weight-kg') as HTMLInputElement;
const weightLbsInput = document.getElementById('water-weight-lbs') as HTMLInputElement;
const exerciseInput = document.getElementById('water-exercise') as HTMLInputElement;

const mainNumber = document.getElementById('water-main-number') as HTMLSpanElement;
const mainUnit = document.getElementById('water-main-unit') as HTMLSpanElement;
const cupsDesc = document.getElementById('water-cups-desc') as HTMLParagraphElement;

const baseDisplay = document.getElementById('water-base-display') as HTMLSpanElement;
const exerciseDisplay = document.getElementById('water-exercise-display') as HTMLSpanElement;

const saveBtn = document.getElementById('water-save-btn') as HTMLButtonElement;
const savedMsg = document.getElementById('water-saved-msg') as HTMLParagraphElement;
const resetBtn = document.getElementById('water-reset-btn') as HTMLButtonElement;

let isMetric = true;
let lastLiters = 0;
let lastInputSnapshot: Record<string, any> = {};

function setUnit(metric: boolean) {
  isMetric = metric;
  metricBtn.classList.toggle('active', metric);
  metricBtn.setAttribute('aria-selected', String(metric));
  imperialBtn.classList.toggle('active', !metric);
  imperialBtn.setAttribute('aria-selected', String(!metric));

  document.getElementById('water-weight-metric')?.classList.toggle('hidden', !metric);
  document.getElementById('water-weight-imperial')?.classList.toggle('hidden', metric);

  resultEl.classList.add('hidden');
  clearErrors();
  lastLiters = 0;
}
metricBtn.addEventListener('click', () => setUnit(true));
imperialBtn.addEventListener('click', () => setUnit(false));

function calculate() {
  clearErrors();

  let weightKgVal: number;
  if (isMetric) {
    const kg = parseFloat(weightKgInput.value);
    if (!weightKgInput.value || isNaN(kg) || kg < 20 || kg > 400) {
      showError('Please enter a valid weight between 20 and 400 kg.');
      weightKgInput.classList.add('input-error'); weightKgInput.focus(); return;
    }
    weightKgVal = kg;
  } else {
    const lbs = parseFloat(weightLbsInput.value);
    if (!weightLbsInput.value || isNaN(lbs) || lbs < 44 || lbs > 880) {
      showError('Please enter a valid weight between 44 and 880 lbs.');
      weightLbsInput.classList.add('input-error'); weightLbsInput.focus(); return;
    }
    weightKgVal = lbs * 0.453592;
  }

  const exerciseMin = parseFloat(exerciseInput.value) || 0;
  if (exerciseMin < 0 || exerciseMin > 360) {
    showError('Please enter a valid exercise duration between 0 and 360 minutes.');
    exerciseInput.classList.add('input-error'); exerciseInput.focus(); return;
  }

  // Baseline needs: 35ml per kg of weight
  const baseMl = weightKgVal * 35;
  // Exercise replenishment: 350ml per 30 minutes of exercise
  const exerciseMl = (exerciseMin / 30) * 350;

  const totalMl = baseMl + exerciseMl;
  const totalLiters = totalMl / 1000;
  const totalLitersRounded = Math.round(totalLiters * 10) / 10;

  lastLiters = totalLitersRounded;
  lastInputSnapshot = {
    weightKg: weightKgVal.toFixed(1),
    exerciseMin,
  };

  if (isMetric) {
    mainNumber.textContent = totalLitersRounded.toFixed(1);
    mainUnit.textContent = 'L/day';
    // Cups description (assuming a standard cup is 250ml)
    const cups = Math.round(totalMl / 250);
    cupsDesc.textContent = `Approximately ${cups} cups (250ml each) per day`;

    baseDisplay.textContent = `${(baseMl / 1000).toFixed(2)} Liters`;
    exerciseDisplay.textContent = `+${(exerciseMl / 1000).toFixed(2)} Liters`;
  } else {
    // Convert to Fluid Ounces (1 Liter = 33.814 fl oz)
    const totalFlOz = Math.round(totalLiters * 33.814);
    mainNumber.textContent = totalFlOz.toString();
    mainUnit.textContent = 'fl oz/day';
    // Cups description (assuming standard cup is 8 fl oz)
    const cups = Math.round(totalFlOz / 8);
    cupsDesc.textContent = `Approximately ${cups} cups (8 fl oz each) per day`;

    baseDisplay.textContent = `${Math.round(baseMl / 1000 * 33.814)} fl oz`;
    exerciseDisplay.textContent = `+${Math.round(exerciseMl / 1000 * 33.814)} fl oz`;
  }

  saveBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Save to History`;
  saveBtn.classList.remove('saved');
  savedMsg.classList.add('hidden');

  resultEl.classList.remove('hidden');
  if (window.innerWidth < 1024) {
    setTimeout(() => resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
  }
}

calcBtn.addEventListener('click', calculate);
document.querySelectorAll('#water-calculator input[type="number"]').forEach(input => {
  input.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') calculate(); });
});

function showError(msg: string) {
  errorEl.textContent = msg;
  errorEl.classList.remove('hidden');
}
function clearErrors() {
  errorEl.classList.add('hidden');
  [weightKgInput, weightLbsInput, exerciseInput].forEach(el => el?.classList.remove('input-error'));
}

saveBtn.addEventListener('click', () => {
  if (lastLiters === 0) return;
  const valStr = isMetric ? `${lastLiters} L` : `${Math.round(lastLiters * 33.814)} fl oz`;
  const record = {
    calculator: 'Water Intake',
    value: valStr,
    unit: isMetric ? 'L/day' : 'fl oz/day',
    category: `${lastInputSnapshot.exerciseMin} min exercise`,
    date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    timestamp: Date.now(),
    inputs: lastInputSnapshot,
  };
  try {
    const hist = JSON.parse(localStorage.getItem('fc_history') || '[]');
    hist.unshift(record);
    localStorage.setItem('fc_history', JSON.stringify(hist.slice(0, 50)));

    const last = JSON.parse(localStorage.getItem('fc_last_results') || '[]');
    last.unshift({ calculator: 'Water Intake', value: valStr, date: record.date });
    localStorage.setItem('fc_last_results', JSON.stringify(last.slice(0, 3)));

    saveBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Saved`;
    saveBtn.classList.add('saved');
    savedMsg.classList.remove('hidden');
  } catch {
    showError('Could not save. Storage may be full or disabled.');
  }
});

resetBtn.addEventListener('click', () => {
  resultEl.classList.add('hidden');
  clearErrors();
  lastLiters = 0;
  weightKgInput.value = '';
  weightLbsInput.value = '';
  exerciseInput.value = '';
  weightKgInput.focus();
});
</script>
