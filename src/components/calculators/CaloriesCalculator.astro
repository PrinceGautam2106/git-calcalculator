---
/**
 * CaloriesCalculator.astro
 * Self-contained Daily Calorie Target calculator widget.
 * Formula: Mifflin-St Jeor × Activity Multiplier ± Goal Adjustment.
 * Zero dependencies · vanilla JS · localStorage history.
 */
---

<div class="calories-calc" id="calories-calculator" role="main" aria-label="Calorie Calculator">

  <!-- ── Unit Toggle ── -->
  <div class="unit-toggle-row" role="group" aria-label="Unit system">
    <span class="unit-label">Units</span>
    <div class="unit-toggle" role="tablist">
      <button id="calories-unit-metric" class="unit-btn active" role="tab" aria-selected="true" type="button">Metric</button>
      <button id="calories-unit-imperial" class="unit-btn" role="tab" aria-selected="false" type="button">Imperial</button>
    </div>
  </div>

  <!-- ── Inputs ── -->
  <div class="calories-inputs" id="calories-inputs">

    <!-- Row 1: Age + Gender -->
    <div class="input-row-2">
      <div class="input-group">
        <label for="calories-age" class="input-label">Age</label>
        <div class="input-wrap">
          <input type="number" id="calories-age" class="calories-input" placeholder="30" min="10" max="100" step="1" autocomplete="off" aria-describedby="calories-age-hint" />
          <span class="input-unit" id="calories-age-hint">yrs</span>
        </div>
      </div>
      <div class="input-group">
        <fieldset class="gender-fieldset">
          <legend class="input-label">Gender</legend>
          <div class="gender-toggle" role="group">
            <label class="gender-btn active" id="calories-gender-male-label">
              <input type="radio" name="calories-gender" id="calories-gender-male" value="male" class="sr-only" checked />
              <span aria-hidden="true">♂</span> Male
            </label>
            <label class="gender-btn" id="calories-gender-female-label">
              <input type="radio" name="calories-gender" id="calories-gender-female" value="female" class="sr-only" />
              <span aria-hidden="true">♀</span> Female
            </label>
          </div>
        </fieldset>
      </div>
    </div>

    <!-- Height -->
    <div class="input-group" id="calories-height-metric">
      <label for="calories-height-cm" class="input-label">Height</label>
      <div class="input-wrap">
        <input type="number" id="calories-height-cm" class="calories-input" placeholder="170" min="50" max="280" step="1" autocomplete="off" />
        <span class="input-unit">cm</span>
      </div>
    </div>
    <div class="input-group hidden" id="calories-height-imperial">
      <label class="input-label">Height</label>
      <div class="input-row-2 gap-sm">
        <div class="input-wrap">
          <input type="number" id="calories-height-ft" class="calories-input" placeholder="5" min="1" max="9" step="1" autocomplete="off" aria-label="Feet" />
          <span class="input-unit">ft</span>
        </div>
        <div class="input-wrap">
          <input type="number" id="calories-height-in" class="calories-input" placeholder="7" min="0" max="11" step="1" autocomplete="off" aria-label="Inches" />
          <span class="input-unit">in</span>
        </div>
      </div>
    </div>

    <!-- Weight -->
    <div class="input-group" id="calories-weight-metric">
      <label for="calories-weight-kg" class="input-label">Weight</label>
      <div class="input-wrap">
        <input type="number" id="calories-weight-kg" class="calories-input" placeholder="70" min="20" max="400" step="0.1" autocomplete="off" />
        <span class="input-unit">kg</span>
      </div>
    </div>
    <div class="input-group hidden" id="calories-weight-imperial">
      <label for="calories-weight-lbs" class="input-label">Weight</label>
      <div class="input-wrap">
        <input type="number" id="calories-weight-lbs" class="calories-input" placeholder="154" min="44" max="880" step="0.1" autocomplete="off" />
        <span class="input-unit">lbs</span>
      </div>
    </div>

    <!-- Activity Level -->
    <div class="input-group">
      <label for="calories-activity" class="input-label">Activity Level</label>
      <div class="select-wrap">
        <select id="calories-activity" class="calories-select" aria-label="Select your activity level">
          <option value="1.2" selected>Sedentary — desk job, little or no exercise</option>
          <option value="1.375">Lightly Active — light exercise 1–3 days/week</option>
          <option value="1.55">Moderately Active — moderate exercise 3–5 days/week</option>
          <option value="1.725">Very Active — hard exercise 6–7 days/week</option>
          <option value="1.9">Extra Active — physical job + hard daily exercise</option>
        </select>
        <svg class="select-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>

    <!-- Goal Selection -->
    <div class="input-group">
      <label for="calories-goal" class="input-label">Your Fitness Goal</label>
      <div class="select-wrap">
        <select id="calories-goal" class="calories-select" aria-label="Select your fitness goal">
          <option value="lose" selected>Weight Loss (Calorie Deficit)</option>
          <option value="maintain">Weight Maintenance (TDEE Baseline)</option>
          <option value="build">Muscle Gain (Calorie Surplus)</option>
        </select>
        <svg class="select-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
        </svg>
      </div>
    </div>

  </div><!-- /calories-inputs -->

  <!-- ── Calculate Button ── -->
  <button id="calories-calc-btn" type="button" class="calc-btn" aria-label="Calculate Calories">
    Calculate Calorie Target
  </button>

  <!-- ── Error ── -->
  <p id="calories-error" class="calories-error hidden" role="alert" aria-live="polite"></p>

  <!-- ── Results Panel ── -->
  <div id="calories-result" class="calories-result hidden" role="region" aria-label="Calorie result" aria-live="polite">
    <div class="result-hero">
      <p class="result-hero-label">Your Daily Calorie Target</p>
      <div class="result-hero-number-row">
        <span id="calories-main-number" class="result-main-number">—</span>
        <span class="result-main-unit">kcal/day</span>
      </div>
      <p id="calories-goal-desc" class="result-category">—</p>
    </div>

    <!-- Metrics Details breakdown -->
    <div class="details-section">
      <p class="details-title">Calculation Details</p>
      <div class="details-list">
        <div class="detail-row">
          <span>BMR (Basal Metabolic Rate)</span>
          <span id="calories-bmr-display" class="font-mono">—</span>
        </div>
        <div class="detail-row">
          <span>TDEE (Maintenance)</span>
          <span id="calories-tdee-display" class="font-mono">—</span>
        </div>
        <div class="detail-row">
          <span>Goal Adjustment</span>
          <span id="calories-adjust-display" class="font-mono">—</span>
        </div>
      </div>
    </div>

    <!-- Save + Reset -->
    <div class="result-actions">
      <button id="calories-save-btn" type="button" class="save-btn" aria-label="Save Calories to local history">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Save to History
      </button>
      <button id="calories-reset-btn" type="button" class="reset-btn" aria-label="Recalculate">
        ← Recalculate
      </button>
    </div>
    <p id="calories-saved-msg" class="saved-msg hidden" role="status">Saved ✓</p>
  </div>

</div>

<style>
.calories-calc {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-family: var(--font-sans);
}

.unit-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.unit-label {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--color-mute);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.unit-toggle {
  display: inline-flex;
  gap: 2px;
  background-color: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 5px;
  padding: 2px;
}
.unit-btn {
  padding: 4px 14px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-mute);
  background: transparent;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}
.unit-btn.active {
  background-color: var(--color-canvas);
  color: var(--color-ink);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}
.dark .unit-btn.active {
  background-color: var(--color-surface);
  border: 1px solid var(--color-hairline);
  box-shadow: none;
}

.calories-inputs { display: flex; flex-direction: column; gap: 10px; }

.input-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.gap-sm { gap: 8px; }

.input-group { display: flex; flex-direction: column; gap: 4px; }

.input-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-body);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.calories-input {
  width: 100%;
  height: 38px;
  padding: 0 40px 0 10px;
  font-size: 0.9375rem;
  font-weight: 500;
  font-family: var(--font-mono);
  color: var(--color-ink);
  background-color: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  outline: none;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}
.calories-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.calories-input.input-error { border-color: var(--color-error); }

.input-unit {
  position: absolute;
  right: 10px;
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-mute);
  pointer-events: none;
}

.gender-fieldset {
  border: none;
  padding: 0;
  margin: 0;
}
.gender-toggle {
  display: flex;
  gap: 2px;
  background-color: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  padding: 2px;
  height: 38px;
}
.gender-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-mute);
  border-radius: 3px;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}
.gender-btn.active {
  background-color: var(--color-canvas);
  color: var(--color-ink);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}
.dark .gender-btn.active {
  background-color: var(--color-surface);
  border: 1px solid var(--color-hairline);
}

.select-wrap {
  position: relative;
}
.calories-select {
  width: 100%;
  height: 38px;
  padding: 0 36px 0 10px;
  font-size: 0.8125rem;
  color: var(--color-ink);
  background-color: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  outline: none;
  cursor: pointer;
  appearance: none;
  transition: border-color 150ms ease;
}
.calories-select:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
.select-chevron {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%);
  width: 14px;
  height: 14px;
  color: var(--color-mute);
  pointer-events: none;
}

.calc-btn {
  width: 100%;
  height: 42px;
  background-color: var(--color-ink);
  color: var(--color-canvas);
  font-size: 0.9375rem;
  font-weight: 600;
  border: 1px solid var(--color-ink);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
}
.calc-btn:hover {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
.calc-btn:active { transform: scale(0.99); }

.calories-error {
  font-size: 0.8125rem;
  color: var(--color-error);
  background-color: var(--color-error-muted);
  border: 1px solid color-mix(in srgb, var(--color-error) 25%, transparent);
  border-radius: 4px;
  padding: 8px 12px;
  margin: 0;
}

.calories-result {
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-top: 1px solid var(--color-hairline);
  padding-top: 18px;
  animation: fadeUp 280ms ease;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.result-hero {
  text-align: center;
  padding: 8px 0 4px;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-hero-label {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-mute);
  margin: 0 0 4px;
}
.result-hero-number-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 4px;
}
.result-main-number {
  font-family: var(--font-mono);
  font-size: 3rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}
.result-main-unit {
  font-size: 0.875rem;
  color: var(--color-mute);
  font-weight: 500;
}
.result-category {
  font-size: 0.875rem;
  font-weight: 600;
  margin-top: 4px;
}

.details-section {}
.details-title {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-mute);
  margin: 0 0 8px;
}
.details-list {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  overflow: hidden;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 9px 12px;
  background-color: var(--color-canvas);
  border-bottom: 1px solid var(--color-hairline);
  font-size: 0.8125rem;
  color: var(--color-body);
}
.detail-row:last-child { border-bottom: none; }

.result-actions {
  display: flex;
  gap: 8px;
}
.save-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 36px;
  background-color: transparent;
  color: var(--color-body);
  font-size: 0.8125rem;
  font-weight: 500;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
}
.save-btn:hover {
  background-color: var(--color-canvas-soft);
  border-color: var(--color-hairline-strong);
  color: var(--color-ink);
}
.save-btn.saved { border-color: var(--color-success); color: var(--color-success); }

.reset-btn {
  background: none;
  border: none;
  color: var(--color-mute);
  font-size: 0.8125rem;
  cursor: pointer;
  padding: 0 12px;
  transition: color 150ms ease;
  white-space: nowrap;
}
.reset-btn:hover { color: var(--color-ink); }

.saved-msg {
  font-size: 0.75rem;
  text-align: center;
  color: var(--color-success);
  margin: 0;
  font-weight: 500;
}

.hidden { display: none !important; }
</style>

<script>
const metricBtn = document.getElementById('calories-unit-metric') as HTMLButtonElement;
const imperialBtn = document.getElementById('calories-unit-imperial') as HTMLButtonElement;
const calcBtn = document.getElementById('calories-calc-btn') as HTMLButtonElement;
const errorEl = document.getElementById('calories-error') as HTMLParagraphElement;
const resultEl = document.getElementById('calories-result') as HTMLDivElement;

const ageInput = document.getElementById('calories-age') as HTMLInputElement;
const genderMale = document.getElementById('calories-gender-male') as HTMLInputElement;
const genderFemale = document.getElementById('calories-gender-female') as HTMLInputElement;
const maleLbl = document.getElementById('calories-gender-male-label') as HTMLLabelElement;
const femaleLbl = document.getElementById('calories-gender-female-label') as HTMLLabelElement;

const heightCmGrp = document.getElementById('calories-height-metric') as HTMLDivElement;
const heightFtGrp = document.getElementById('calories-height-imperial') as HTMLDivElement;

const heightCm = document.getElementById('calories-height-cm') as HTMLInputElement;
const heightFt = document.getElementById('calories-height-ft') as HTMLInputElement;
const heightIn = document.getElementById('calories-height-in') as HTMLInputElement;
const weightKg = document.getElementById('calories-weight-kg') as HTMLInputElement;
const weightLbs = document.getElementById('calories-weight-lbs') as HTMLInputElement;
const activitySel = document.getElementById('calories-activity') as HTMLSelectElement;
const goalSel = document.getElementById('calories-goal') as HTMLSelectElement;

const mainNumber = document.getElementById('calories-main-number') as HTMLSpanElement;
const goalDesc = document.getElementById('calories-goal-desc') as HTMLParagraphElement;
const bmrDisplay = document.getElementById('calories-bmr-display') as HTMLSpanElement;
const tdeeDisplay = document.getElementById('calories-tdee-display') as HTMLSpanElement;
const adjustDisplay = document.getElementById('calories-adjust-display') as HTMLSpanElement;

const saveBtn = document.getElementById('calories-save-btn') as HTMLButtonElement;
const savedMsg = document.getElementById('calories-saved-msg') as HTMLParagraphElement;
const resetBtn = document.getElementById('calories-reset-btn') as HTMLButtonElement;

let isMetric = true;
let lastTarget: number | null = null;
let lastInputSnapshot: Record<string, any> = {};

function syncGender() {
  maleLbl.classList.toggle('active', genderMale.checked);
  femaleLbl.classList.toggle('active', genderFemale.checked);
  resultEl.classList.add('hidden');
}

[genderMale, genderFemale].forEach(radio => radio.addEventListener('change', syncGender));
maleLbl.addEventListener('click', () => { genderMale.checked = true; syncGender(); });
femaleLbl.addEventListener('click', () => { genderFemale.checked = true; syncGender(); });

function setUnit(metric: boolean) {
  isMetric = metric;
  metricBtn.classList.toggle('active', metric);
  metricBtn.setAttribute('aria-selected', String(metric));
  imperialBtn.classList.toggle('active', !metric);
  imperialBtn.setAttribute('aria-selected', String(!metric));

  heightCmGrp.classList.toggle('hidden', !metric);
  heightFtGrp.classList.toggle('hidden', metric);
  weightKgGrp.classList.toggle('hidden', !metric);
  weightLbsGrp.classList.toggle('hidden', metric);

  resultEl.classList.add('hidden');
  clearErrors();
  lastTarget = null;
}
metricBtn.addEventListener('click', () => setUnit(true));
imperialBtn.addEventListener('click', () => setUnit(false));

function calculate() {
  clearErrors();
  const ageVal = parseFloat(ageInput.value);
  if (!ageInput.value || isNaN(ageVal) || ageVal < 10 || ageVal > 100) {
    showError('Please enter a valid age between 10 and 100 years.');
    ageInput.classList.add('input-error'); ageInput.focus(); return;
  }

  let heightCmVal: number;
  let weightKgVal: number;

  if (isMetric) {
    const cm = parseFloat(heightCm.value);
    const kg = parseFloat(weightKg.value);
    if (!heightCm.value || isNaN(cm) || cm < 50 || cm > 280) {
      showError('Please enter a valid height between 50 and 280 cm.');
      heightCm.classList.add('input-error'); heightCm.focus(); return;
    }
    if (!weightKg.value || isNaN(kg) || kg < 15 || kg > 400) {
      showError('Please enter a valid weight between 15 and 400 kg.');
      weightKg.classList.add('input-error'); weightKg.focus(); return;
    }
    heightCmVal = cm;
    weightKgVal = kg;
  } else {
    const ft = parseFloat(heightFt.value) || 0;
    const inches = parseFloat(heightIn.value) || 0;
    const totalIn = ft * 12 + inches;
    const lbs = parseFloat(weightLbs.value);
    if (totalIn < 20 || totalIn > 110) {
      showError('Please enter a valid height.');
      heightFt.classList.add('input-error'); heightFt.focus(); return;
    }
    if (!weightLbs.value || isNaN(lbs) || lbs < 33 || lbs > 880) {
      showError('Please enter a valid weight.');
      weightLbs.classList.add('input-error'); weightLbs.focus(); return;
    }
    heightCmVal = totalIn * 2.54;
    weightKgVal = lbs * 0.453592;
  }

  const isMale = genderMale.checked;
  const base = (10 * weightKgVal) + (6.25 * heightCmVal) - (5 * ageVal);
  const bmr = isMale ? base + 5 : base - 161;
  const bmrRounded = Math.round(bmr);

  const multiplier = parseFloat(activitySel.value);
  const tdee = bmrRounded * multiplier;
  const tdeeRounded = Math.round(tdee);

  const goal = goalSel.value;
  let adjust = 0;
  let desc = 'Maintenance (TDEE baseline)';
  let color = 'var(--color-success)';

  if (goal === 'lose') {
    adjust = -500;
    desc = 'Deficit for Weight Loss (−0.5 kg/week)';
    color = 'var(--color-warning)';
  } else if (goal === 'build') {
    adjust = 300;
    desc = 'Surplus for Muscle Gain (+0.25 kg/week)';
    color = 'var(--color-primary)';
  }

  const target = Math.max(tdeeRounded + adjust, 1200); // 1200 kcal safety minimum

  lastTarget = target;
  lastInputSnapshot = {
    age: ageVal,
    gender: isMale ? 'male' : 'female',
    heightCm: Math.round(heightCmVal),
    weightKg: weightKgVal.toFixed(1),
    activity: activitySel.options[activitySel.selectedIndex].text,
    goal: goalSel.options[goalSel.selectedIndex].text,
  };

  mainNumber.textContent = target.toLocaleString();
  goalDesc.textContent = desc;
  goalDesc.style.color = color;

  bmrDisplay.textContent = `${bmrRounded.toLocaleString()} kcal/day`;
  tdeeDisplay.textContent = `${tdeeRounded.toLocaleString()} kcal/day`;
  adjustDisplay.textContent = adjust >= 0 ? `+${adjust} kcal/day` : `${adjust} kcal/day`;

  saveBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Save to History`;
  saveBtn.classList.remove('saved');
  savedMsg.classList.add('hidden');

  resultEl.classList.remove('hidden');
  if (window.innerWidth < 1024) {
    setTimeout(() => resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
  }
}

calcBtn.addEventListener('click', calculate);
document.querySelectorAll('#calories-calculator input[type="number"]').forEach(input => {
  input.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') calculate(); });
});

function showError(msg: string) {
  errorEl.textContent = msg;
  errorEl.classList.remove('hidden');
}
function clearErrors() {
  errorEl.classList.add('hidden');
  [ageInput, heightCm, heightFt, heightIn, weightKg, weightLbs]
    .forEach(el => el?.classList.remove('input-error'));
}

saveBtn.addEventListener('click', () => {
  if (lastTarget === null) return;
  const record = {
    calculator: 'Calorie Target',
    value: lastTarget.toLocaleString(),
    unit: 'kcal/day',
    category: goalSel.value === 'lose' ? 'Lose Fat' : (goalSel.value === 'build' ? 'Build Muscle' : 'Maintain'),
    date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    timestamp: Date.now(),
    inputs: lastInputSnapshot,
  };
  try {
    const hist = JSON.parse(localStorage.getItem('fc_history') || '[]');
    hist.unshift(record);
    localStorage.setItem('fc_history', JSON.stringify(hist.slice(0, 50)));

    const last = JSON.parse(localStorage.getItem('fc_last_results') || '[]');
    last.unshift({ calculator: 'Calorie Target', value: `${lastTarget.toLocaleString()} kcal`, date: record.date });
    localStorage.setItem('fc_last_results', JSON.stringify(last.slice(0, 3)));

    saveBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Saved`;
    saveBtn.classList.add('saved');
    savedMsg.classList.remove('hidden');
  } catch {
    showError('Could not save. Storage may be full or disabled.');
  }
});

resetBtn.addEventListener('click', () => {
  resultEl.classList.add('hidden');
  clearErrors();
  lastTarget = null;
  ageInput.value = '';
  heightCm.value = ''; heightFt.value = ''; heightIn.value = '';
  weightKg.value = ''; weightLbs.value = '';
  ageInput.focus();
});
</script>
