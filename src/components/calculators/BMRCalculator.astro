---
/**
 * BMRCalculator.astro
 * Self-contained Basal Metabolic Rate (BMR) calculator widget.
 * Formula: Mifflin-St Jeor (1990)
 * Zero dependencies · vanilla JS · localStorage history.
 */
---

<div class="bmr-calc" id="bmr-calculator" role="main" aria-label="BMR Calculator">

  <!-- ── Unit Toggle ── -->
  <div class="unit-toggle-row" role="group" aria-label="Unit system">
    <span class="unit-label">Units</span>
    <div class="unit-toggle" role="tablist">
      <button id="bmr-unit-metric" class="unit-btn active" role="tab" aria-selected="true" type="button">Metric</button>
      <button id="bmr-unit-imperial" class="unit-btn" role="tab" aria-selected="false" type="button">Imperial</button>
    </div>
  </div>

  <!-- ── Inputs ── -->
  <div class="bmr-inputs" id="bmr-inputs">

    <!-- Row 1: Age + Gender -->
    <div class="input-row-2">
      <div class="input-group">
        <label for="bmr-age" class="input-label">Age</label>
        <div class="input-wrap">
          <input type="number" id="bmr-age" class="bmr-input" placeholder="30" min="10" max="100" step="1" autocomplete="off" aria-describedby="bmr-age-hint" />
          <span class="input-unit" id="bmr-age-hint">yrs</span>
        </div>
      </div>
      <div class="input-group">
        <fieldset class="gender-fieldset">
          <legend class="input-label">Gender</legend>
          <div class="gender-toggle" role="group">
            <label class="gender-btn active" id="bmr-gender-male-label">
              <input type="radio" name="bmr-gender" id="bmr-gender-male" value="male" class="sr-only" checked />
              <span aria-hidden="true">♂</span> Male
            </label>
            <label class="gender-btn" id="bmr-gender-female-label">
              <input type="radio" name="bmr-gender" id="bmr-gender-female" value="female" class="sr-only" />
              <span aria-hidden="true">♀</span> Female
            </label>
          </div>
        </fieldset>
      </div>
    </div>

    <!-- Height -->
    <div class="input-group" id="bmr-height-metric">
      <label for="bmr-height-cm" class="input-label">Height</label>
      <div class="input-wrap">
        <input type="number" id="bmr-height-cm" class="bmr-input" placeholder="170" min="50" max="280" step="1" autocomplete="off" />
        <span class="input-unit">cm</span>
      </div>
    </div>
    <div class="input-group hidden" id="bmr-height-imperial">
      <label class="input-label">Height</label>
      <div class="input-row-2 gap-sm">
        <div class="input-wrap">
          <input type="number" id="bmr-height-ft" class="bmr-input" placeholder="5" min="1" max="9" step="1" autocomplete="off" aria-label="Feet" />
          <span class="input-unit">ft</span>
        </div>
        <div class="input-wrap">
          <input type="number" id="bmr-height-in" class="bmr-input" placeholder="7" min="0" max="11" step="1" autocomplete="off" aria-label="Inches" />
          <span class="input-unit">in</span>
        </div>
      </div>
    </div>

    <!-- Weight -->
    <div class="input-group" id="bmr-weight-metric">
      <label for="bmr-weight-kg" class="input-label">Weight</label>
      <div class="input-wrap">
        <input type="number" id="bmr-weight-kg" class="bmr-input" placeholder="70" min="20" max="400" step="0.1" autocomplete="off" />
        <span class="input-unit">kg</span>
      </div>
    </div>
    <div class="input-group hidden" id="bmr-weight-imperial">
      <label for="bmr-weight-lbs" class="input-label">Weight</label>
      <div class="input-wrap">
        <input type="number" id="bmr-weight-lbs" class="bmr-input" placeholder="154" min="44" max="880" step="0.1" autocomplete="off" />
        <span class="input-unit">lbs</span>
      </div>
    </div>

  </div><!-- /bmr-inputs -->

  <!-- ── Calculate Button ── -->
  <button id="bmr-calc-btn" type="button" class="calc-btn" aria-label="Calculate BMR">
    Calculate BMR
  </button>

  <!-- ── Error ── -->
  <p id="bmr-error" class="bmr-error hidden" role="alert" aria-live="polite"></p>

  <!-- ── Results Panel ── -->
  <div id="bmr-result" class="bmr-result hidden" role="region" aria-label="BMR result" aria-live="polite">
    <div class="result-hero">
      <p class="result-hero-label">Your Basal Metabolic Rate (BMR)</p>
      <div class="result-hero-number-row">
        <span id="bmr-main-number" class="result-main-number">—</span>
        <span class="result-main-unit">kcal/day</span>
      </div>
      <p class="result-hero-sub">This is the baseline energy needed to survive at complete rest.</p>
    </div>

    <!-- Estimate with Activity Levels -->
    <div class="tdee-estimates" aria-label="Daily calorie needs by activity level">
      <p class="estimates-title">Calculated Energy Needs by Activity</p>
      <div class="estimates-list" id="bmr-estimates-list">
        <!-- Injected via JS -->
      </div>
    </div>

    <!-- Save + Reset -->
    <div class="result-actions">
      <button id="bmr-save-btn" type="button" class="save-btn" aria-label="Save BMR to local history">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
        Save to History
      </button>
      <button id="bmr-reset-btn" type="button" class="reset-btn" aria-label="Recalculate">
        ← Recalculate
      </button>
    </div>
    <p id="bmr-saved-msg" class="saved-msg hidden" role="status">Saved ✓</p>
  </div>

</div>

<style>
.bmr-calc {
  display: flex;
  flex-direction: column;
  gap: 14px;
  font-family: var(--font-sans);
}

.unit-toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.unit-label {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--color-mute);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.unit-toggle {
  display: inline-flex;
  gap: 2px;
  background-color: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 5px;
  padding: 2px;
}
.unit-btn {
  padding: 4px 14px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-mute);
  background: transparent;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}
.unit-btn.active {
  background-color: var(--color-canvas);
  color: var(--color-ink);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}
.dark .unit-btn.active {
  background-color: var(--color-surface);
  border: 1px solid var(--color-hairline);
  box-shadow: none;
}

.bmr-inputs { display: flex; flex-direction: column; gap: 10px; }

.input-row-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.gap-sm { gap: 8px; }

.input-group { display: flex; flex-direction: column; gap: 4px; }

.input-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-body);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.bmr-input {
  width: 100%;
  height: 38px;
  padding: 0 40px 0 10px;
  font-size: 0.9375rem;
  font-weight: 500;
  font-family: var(--font-mono);
  color: var(--color-ink);
  background-color: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  outline: none;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}
.bmr-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.bmr-input.input-error { border-color: var(--color-error); }

.input-unit {
  position: absolute;
  right: 10px;
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-mute);
  pointer-events: none;
}

.gender-fieldset {
  border: none;
  padding: 0;
  margin: 0;
}
.gender-toggle {
  display: flex;
  gap: 2px;
  background-color: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  padding: 2px;
  height: 38px;
}
.gender-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-mute);
  border-radius: 3px;
  cursor: pointer;
  transition: background-color 150ms ease, color 150ms ease;
}
.gender-btn.active {
  background-color: var(--color-canvas);
  color: var(--color-ink);
  box-shadow: 0 1px 2px rgba(0,0,0,0.08);
}
.dark .gender-btn.active {
  background-color: var(--color-surface);
  border: 1px solid var(--color-hairline);
}

.calc-btn {
  width: 100%;
  height: 42px;
  background-color: var(--color-ink);
  color: var(--color-canvas);
  font-size: 0.9375rem;
  font-weight: 600;
  border: 1px solid var(--color-ink);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
}
.calc-btn:hover {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}
.calc-btn:active { transform: scale(0.99); }

.bmr-error {
  font-size: 0.8125rem;
  color: var(--color-error);
  background-color: var(--color-error-muted);
  border: 1px solid color-mix(in srgb, var(--color-error) 25%, transparent);
  border-radius: 4px;
  padding: 8px 12px;
  margin: 0;
}

.bmr-result {
  display: flex;
  flex-direction: column;
  gap: 16px;
  border-top: 1px solid var(--color-hairline);
  padding-top: 18px;
  animation: fadeUp 280ms ease;
}
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.result-hero {
  text-align: center;
  padding: 8px 0 4px;
}
.result-hero-label {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-mute);
  margin: 0 0 4px;
}
.result-hero-number-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6px;
}
.result-main-number {
  font-family: var(--font-mono);
  font-size: 3rem;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--color-ink);
}
.result-main-unit {
  font-size: 0.875rem;
  color: var(--color-mute);
  font-weight: 500;
}
.result-hero-sub {
  font-size: 0.8125rem;
  color: var(--color-mute);
  margin: 6px 0 0;
  line-height: 1.4;
}

.tdee-estimates {}
.estimates-title {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-mute);
  margin: 0 0 8px;
}
.estimates-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  overflow: hidden;
}

.result-actions {
  display: flex;
  gap: 8px;
}
.save-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 36px;
  background-color: transparent;
  color: var(--color-body);
  font-size: 0.8125rem;
  font-weight: 500;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  cursor: pointer;
  transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease;
}
.save-btn:hover {
  background-color: var(--color-canvas-soft);
  border-color: var(--color-hairline-strong);
  color: var(--color-ink);
}
.save-btn.saved { border-color: var(--color-success); color: var(--color-success); }

.reset-btn {
  background: none;
  border: none;
  color: var(--color-mute);
  font-size: 0.8125rem;
  cursor: pointer;
  padding: 0 12px;
  transition: color 150ms ease;
  white-space: nowrap;
}
.reset-btn:hover { color: var(--color-ink); }

.saved-msg {
  font-size: 0.75rem;
  text-align: center;
  color: var(--color-success);
  margin: 0;
  font-weight: 500;
}

.hidden { display: none !important; }
</script>

<script>
const ACTIVITY_FACTORS = [
  { label: 'Sedentary (desk job, no exercise)', factor: 1.2, color: 'var(--color-mute)' },
  { label: 'Lightly Active (1–3 days/week)', factor: 1.375, color: 'var(--color-primary)' },
  { label: 'Moderately Active (3–5 days/week)', factor: 1.55, color: 'var(--color-success)' },
  { label: 'Very Active (6–7 days/week)', factor: 1.725, color: 'var(--color-warning)' },
  { label: 'Extra Active (physical job + daily training)', factor: 1.9, color: 'var(--color-error)' },
];

const metricBtn = document.getElementById('bmr-unit-metric') as HTMLButtonElement;
const imperialBtn = document.getElementById('bmr-unit-imperial') as HTMLButtonElement;
const calcBtn = document.getElementById('bmr-calc-btn') as HTMLButtonElement;
const errorEl = document.getElementById('bmr-error') as HTMLParagraphElement;
const resultEl = document.getElementById('bmr-result') as HTMLDivElement;

const ageInput = document.getElementById('bmr-age') as HTMLInputElement;
const genderMale = document.getElementById('bmr-gender-male') as HTMLInputElement;
const genderFemale = document.getElementById('bmr-gender-female') as HTMLInputElement;
const maleLbl = document.getElementById('bmr-gender-male-label') as HTMLLabelElement;
const femaleLbl = document.getElementById('bmr-gender-female-label') as HTMLLabelElement;

const heightCmGrp = document.getElementById('bmr-height-metric') as HTMLDivElement;
const heightFtGrp = document.getElementById('bmr-height-imperial') as HTMLDivElement;
const weightKgGrp = document.getElementById('bmr-weight-metric') as HTMLDivElement;
const weightLbsGrp = document.getElementById('bmr-weight-imperial') as HTMLDivElement;

const heightCm = document.getElementById('bmr-height-cm') as HTMLInputElement;
const heightFt = document.getElementById('bmr-height-ft') as HTMLInputElement;
const heightIn = document.getElementById('bmr-height-in') as HTMLInputElement;
const weightKg = document.getElementById('bmr-weight-kg') as HTMLInputElement;
const weightLbs = document.getElementById('bmr-weight-lbs') as HTMLInputElement;

const mainNumber = document.getElementById('bmr-main-number') as HTMLSpanElement;
const estimatesList = document.getElementById('bmr-estimates-list') as HTMLDivElement;
const saveBtn = document.getElementById('bmr-save-btn') as HTMLButtonElement;
const savedMsg = document.getElementById('bmr-saved-msg') as HTMLParagraphElement;
const resetBtn = document.getElementById('bmr-reset-btn') as HTMLButtonElement;

let isMetric = true;
let lastBMR: number | null = null;
let lastInputSnapshot: Record<string, any> = {};

function syncGender() {
  maleLbl.classList.toggle('active', genderMale.checked);
  femaleLbl.classList.toggle('active', genderFemale.checked);
}

[genderMale, genderFemale].forEach(radio => radio.addEventListener('change', syncGender));
maleLbl.addEventListener('click', () => { genderMale.checked = true; syncGender(); });
femaleLbl.addEventListener('click', () => { genderFemale.checked = true; syncGender(); });

function setUnit(metric: boolean) {
  isMetric = metric;
  metricBtn.classList.toggle('active', metric);
  metricBtn.setAttribute('aria-selected', String(metric));
  imperialBtn.classList.toggle('active', !metric);
  imperialBtn.setAttribute('aria-selected', String(!metric));

  heightCmGrp.classList.toggle('hidden', !metric);
  heightFtGrp.classList.toggle('hidden', metric);
  weightKgGrp.classList.toggle('hidden', !metric);
  weightLbsGrp.classList.toggle('hidden', metric);

  resultEl.classList.add('hidden');
  clearErrors();
  lastBMR = null;
}
metricBtn.addEventListener('click', () => setUnit(true));
imperialBtn.addEventListener('click', () => setUnit(false));

function calculate() {
  clearErrors();
  const ageVal = parseFloat(ageInput.value);
  if (!ageInput.value || isNaN(ageVal) || ageVal < 10 || ageVal > 100) {
    showError('Please enter a valid age between 10 and 100 years.');
    ageInput.classList.add('input-error');
    ageInput.focus();
    return;
  }

  let heightCmVal: number;
  let weightKgVal: number;

  if (isMetric) {
    const cm = parseFloat(heightCm.value);
    const kg = parseFloat(weightKg.value);
    if (!heightCm.value || isNaN(cm) || cm < 50 || cm > 280) {
      showError('Please enter a valid height between 50 and 280 cm.');
      heightCm.classList.add('input-error'); heightCm.focus(); return;
    }
    if (!weightKg.value || isNaN(kg) || kg < 15 || kg > 400) {
      showError('Please enter a valid weight between 15 and 400 kg.');
      weightKg.classList.add('input-error'); weightKg.focus(); return;
    }
    heightCmVal = cm;
    weightKgVal = kg;
  } else {
    const ft = parseFloat(heightFt.value) || 0;
    const inches = parseFloat(heightIn.value) || 0;
    const totalIn = ft * 12 + inches;
    const lbs = parseFloat(weightLbs.value);
    if (totalIn < 20 || totalIn > 110) {
      showError('Please enter a valid height.');
      heightFt.classList.add('input-error'); heightFt.focus(); return;
    }
    if (!weightLbs.value || isNaN(lbs) || lbs < 33 || lbs > 880) {
      showError('Please enter a valid weight.');
      weightLbs.classList.add('input-error'); weightLbs.focus(); return;
    }
    heightCmVal = totalIn * 2.54;
    weightKgVal = lbs * 0.453592;
  }

  const isMale = genderMale.checked;
  const base = (10 * weightKgVal) + (6.25 * heightCmVal) - (5 * ageVal);
  const bmr = isMale ? base + 5 : base - 161;
  const bmrRounded = Math.round(bmr);

  lastBMR = bmrRounded;
  lastInputSnapshot = {
    age: ageVal,
    gender: isMale ? 'male' : 'female',
    heightCm: Math.round(heightCmVal),
    weightKg: weightKgVal.toFixed(1),
  };

  mainNumber.textContent = bmrRounded.toLocaleString();

  estimatesList.innerHTML = ACTIVITY_FACTORS.map(a => {
    const calories = Math.round(bmrRounded * a.factor);
    return `
      <div style="display:flex;justify-content:space-between;align-items:center;padding:9px 12px;background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);">
        <div style="display:flex;flex-direction:column;gap:1px">
          <span style="font-size:0.8125rem;color:var(--color-ink);font-weight:500">${a.label}</span>
          <span style="font-size:0.6875rem;color:var(--color-mute)">BMR × ${a.factor}</span>
        </div>
        <span style="font-family:var(--font-mono);font-size:0.875rem;font-weight:600;color:var(--color-ink)">${calories.toLocaleString()} kcal</span>
      </div>
    `;
  }).join('');

  const lastRow = estimatesList.querySelector('div:last-child') as HTMLElement;
  if (lastRow) lastRow.style.borderBottom = 'none';

  saveBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Save to History`;
  saveBtn.classList.remove('saved');
  savedMsg.classList.add('hidden');

  resultEl.classList.remove('hidden');
  if (window.innerWidth < 1024) {
    setTimeout(() => resultEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
  }
}

calcBtn.addEventListener('click', calculate);
document.querySelectorAll('#bmr-calculator input[type="number"]').forEach(input => {
  input.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') calculate(); });
});

function showError(msg: string) {
  errorEl.textContent = msg;
  errorEl.classList.remove('hidden');
}
function clearErrors() {
  errorEl.classList.add('hidden');
  [ageInput, heightCm, heightFt, heightIn, weightKg, weightLbs]
    .forEach(el => el?.classList.remove('input-error'));
}

saveBtn.addEventListener('click', () => {
  if (lastBMR === null) return;
  const record = {
    calculator: 'BMR',
    value: lastBMR.toLocaleString(),
    unit: 'kcal/day',
    category: lastInputSnapshot.gender === 'male' ? 'Male' : 'Female',
    date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
    timestamp: Date.now(),
    inputs: lastInputSnapshot,
  };
  try {
    const hist = JSON.parse(localStorage.getItem('fc_history') || '[]');
    hist.unshift(record);
    localStorage.setItem('fc_history', JSON.stringify(hist.slice(0, 50)));

    const last = JSON.parse(localStorage.getItem('fc_last_results') || '[]');
    last.unshift({ calculator: 'BMR', value: `${lastBMR.toLocaleString()} kcal/day`, date: record.date });
    localStorage.setItem('fc_last_results', JSON.stringify(last.slice(0, 3)));

    saveBtn.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Saved`;
    saveBtn.classList.add('saved');
    savedMsg.classList.remove('hidden');
  } catch {
    showError('Could not save. Storage may be full or disabled.');
  }
});

resetBtn.addEventListener('click', () => {
  resultEl.classList.add('hidden');
  clearErrors();
  lastBMR = null;
  ageInput.value = '';
  heightCm.value = ''; heightFt.value = ''; heightIn.value = '';
  weightKg.value = ''; weightLbs.value = '';
  ageInput.focus();
});
</script>
