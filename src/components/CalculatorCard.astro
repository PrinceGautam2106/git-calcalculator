---
interface Props {
  title: string;
  description: string;
  icon: string;
  slug: string;
  lastResult?: string;
}

const { title, description, icon, slug, lastResult } = Astro.props;
---

<a 
  href={`/calculator/${slug}`}
  class="group block rounded-lg border border-white/10 bg-[#111] p-6 transition-colors hover:border-[#0070f3]"
>
  <div class="mb-4 text-3xl">{icon}</div>
  <h3 class="mb-2 text-lg font-semibold">{title}</h3>
  <p class="mb-4 text-sm text-white/60">{description}</p>
  {lastResult && (
    <div class="mt-4 border-t border-white/10 pt-4">
      <p class="font-mono text-xs text-white/40">Last result</p>
      <p class="mt-1 font-mono text-sm text-[#50e3c2]">{lastResult}</p>
    </div>
  )}
</a>
