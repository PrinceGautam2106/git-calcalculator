---
---

<div class="relative inline-block text-left" id="lang-selector-container">
  <button 
    type="button" 
    id="lang-btn" 
    class="flex items-center gap-2 rounded-lg border border-black/10 bg-black/5 px-3 py-2 text-sm font-medium transition-all hover:border-black/20 hover:bg-black/10 focus:outline-none focus:ring-2 focus:ring-black/20 dark:border-white/10 dark:bg-white/5 dark:hover:border-white/20 dark:hover:bg-white/10 dark:focus:ring-white/20"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span id="lang-flag" class="text-lg leading-none">🌐</span>
    <span id="lang-text" class="hidden sm:inline">Language</span>
    <svg class="h-4 w-4 text-black/40 dark:text-white/40 transition-transform duration-200" id="lang-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div 
    id="lang-menu" 
    class="absolute right-0 mt-2 w-56 origin-top-right scale-95 opacity-0 invisible transition-all duration-200 ease-out rounded-xl border border-black/10 bg-white/90 dark:border-white/10 dark:bg-black/90 backdrop-blur-xl shadow-lg dark:shadow-2xl z-50 ring-1 ring-black ring-opacity-5 focus:outline-none"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby="lang-btn"
  >
    <div class="p-2 space-y-1" role="none">
      <div class="px-3 py-2 text-xs font-semibold text-black/40 dark:text-white/40 uppercase tracking-wider" role="none">
        Select Language
      </div>
      <div id="lang-options-list" class="space-y-1">
        <!-- Options will be rendered here to ensure consistency with active state -->
      </div>
    </div>
  </div>
</div>

<script>
  const LANGUAGES = {
    en: { name: 'English', flag: '🇬🇧' },
    es: { name: 'Español', flag: '🇪🇸' },
    fr: { name: 'Français', flag: '🇫🇷' },
    de: { name: 'Deutsch', flag: '🇩🇪' },
    hi: { name: 'हिन्दी', flag: '🇮🇳' },
    pt: { name: 'Português', flag: '🇧🇷' },
    zh: { name: '中文', flag: '🇨🇳' },
    ja: { name: '日本語', flag: '🇯🇵' }
  };

  const container = document.getElementById('lang-selector-container');
  const langBtn = document.getElementById('lang-btn');
  const langMenu = document.getElementById('lang-menu');
  const langArrow = document.getElementById('lang-arrow');
  const langText = document.getElementById('lang-text');
  const langFlag = document.getElementById('lang-flag');
  const optionsList = document.getElementById('lang-options-list');

  let isOpen = false;

  const toggleMenu = (show?: boolean) => {
    isOpen = show !== undefined ? show : !isOpen;
    if (isOpen) {
      langMenu.classList.remove('opacity-0', 'invisible', 'scale-95');
      langMenu.classList.add('opacity-100', 'visible', 'scale-100');
      langArrow.classList.add('rotate-180');
      langBtn.setAttribute('aria-expanded', 'true');
    } else {
      langMenu.classList.add('opacity-0', 'invisible', 'scale-95');
      langMenu.classList.remove('opacity-100', 'visible', 'scale-100');
      langArrow.classList.remove('rotate-180');
      langBtn.setAttribute('aria-expanded', 'false');
    }
  };

  const renderOptions = (currentLang: string) => {
    optionsList.innerHTML = Object.entries(LANGUAGES).map(([code, data]) => `
      <button 
        data-lang="${code}" 
        class="w-full text-left px-3 py-2 rounded-lg text-sm transition-all flex items-center justify-between group ${code === currentLang ? 'bg-black/10 text-black dark:bg-white/10 dark:text-white' : 'text-black/60 hover:bg-black/5 hover:text-black dark:text-white/60 dark:hover:bg-white/5 dark:hover:text-white'}"
        role="menuitem"
      >
        <div class="flex items-center gap-3">
          <span class="text-lg">${data.flag}</span>
          <span>${data.name}</span>
        </div>
        ${code === currentLang ? `
          <svg class="h-4 w-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
        ` : ''}
      </button>
    `).join('');

    // Re-attach listeners
    optionsList.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-lang');
        if (lang) {
          updateDisplay(lang);
          toggleMenu(false);
        }
      });
    });
  };

  const updateDisplay = (lang: string) => {
    const langData = LANGUAGES[lang as keyof typeof LANGUAGES];
    if (langData) {
      langFlag.textContent = langData.flag;
      langText.textContent = langData.name;
      localStorage.setItem('fc_language', lang);
      document.documentElement.lang = lang;
      renderOptions(lang);
      window.dispatchEvent(new CustomEvent('languageChanged', { detail: { language: lang } }));
    }
  };

  // Initial State
  const savedLang = localStorage.getItem('fc_language') || 'en';
  updateDisplay(savedLang);

  // Toggle on click
  langBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMenu();
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!container.contains(e.target as Node)) {
      toggleMenu(false);
    }
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu(false);
    }
  });
</script>
