---
/**
 * CalculatorLayout.astro
 * ─────────────────────────────────────────────────────────────
 * The master layout for every calculator page on CalaiFitness.
 *
 * ARCHITECTURE: Article-first, tool-embedded.
 * Google ranks pages with BOTH depth of content AND utility.
 * This layout treats the calculator as a feature of an in-depth guide,
 * not a guide bolted onto a tool.
 *
 * Slots:
 *   calculator   — The interactive tool widget
 *   what-is      — Educational "What is X?" content (3-4 paragraphs)
 *   how-to       — Formula breakdown with math display
 *   ranges       — Ranges table / "What your number means"
 *   extra        — Optional additional sections (e.g. research notes)
 *
 * Props:
 *   title            — Page <title> and H1 base (keyword first)
 *   description      — Meta description (≤155 chars)
 *   keyword          — Primary keyword, e.g. "BMI calculator"
 *   canonicalPath    — URL path, e.g. "/calculator/bmi"
 *   formula          — Formula name, e.g. "Mifflin-St Jeor (1990)"
 *   lastModified     — ISO date or Date object for schema + display
 *   faqs             — FAQ items for FAQPage JSON-LD + accordion
 *   relatedCalculators — Cards for internal linking section
 *   ogImage          — Optional custom OG image path
 */

import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

export interface FAQItem {
  question: string;
  answer: string;
}

export interface RelatedCalculator {
  name: string;
  href: string;
  emoji: string;
  description?: string;
}

interface Props {
  title: string;
  description: string;
  keyword: string;
  canonicalPath: string;
  formula: string;
  lastModified: Date | string;
  faqs?: FAQItem[];
  relatedCalculators?: RelatedCalculator[];
  ogImage?: string;
  accuracyRating?: string;
}

const {
  title,
  description,
  keyword,
  canonicalPath,
  formula,
  lastModified,
  faqs = [],
  relatedCalculators = [],
  ogImage,
  accuracyRating = '±3–5%',
} = Astro.props;

/* ── Derived values ── */
const SITE_URL   = 'https://www.calaifitness.com';
const SITE_NAME  = 'CalaiFitness';
const canonical  = `${SITE_URL}${canonicalPath}`;
const ogImageUrl = ogImage
  ? `${SITE_URL}${ogImage}`
  : `${SITE_URL}/og-image.jpg`;

// Formatted date
const modDate = lastModified instanceof Date
  ? lastModified
  : new Date(lastModified);

const displayDate = modDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const isoDate = modDate.toISOString();

/* ── Breadcrumb segments ── */
const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Calculators', href: '/calculators' },
  { name: title, href: canonicalPath },
];

/* ── JSON-LD Schemas ── */

// 1. BreadcrumbList
const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.href.startsWith('http') ? b.href : `${SITE_URL}${b.href}`,
  })),
};

// 2. SoftwareApplication (the interactive tool)
const softwareSchema = {
  '@type': 'SoftwareApplication',
  name: title,
  description,
  url: canonical,
  applicationCategory: 'HealthApplication',
  applicationSubCategory: 'FitnessApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  keywords: keyword,
};

// 3. Article (the educational content)
const articleSchema = {
  '@type': 'Article',
  headline: title,
  description,
  url: canonical,
  datePublished: isoDate,
  dateModified: isoDate,
  author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
  },
  image: ogImageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  about: { '@type': 'Thing', name: keyword },
};

// 4. FAQPage
const faqSchema = faqs.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

// Combined @graph
const graphNodes = [breadcrumbSchema, softwareSchema, articleSchema];
if (faqSchema) graphNodes.push(faqSchema);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': graphNodes,
});

// Dev pretty-print
const isDev = import.meta.env.DEV;
const jsonLdOutput = isDev
  ? JSON.stringify(JSON.parse(jsonLd), null, 2)
  : jsonLd;
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ── SEO Core ── -->
    <title>{title} | {SITE_NAME}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE_NAME} />
    <meta name="keywords" content={`${keyword}, free ${keyword}, ${keyword} online, fitness calculator`} />

    <!-- ── Open Graph ── -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={`${title} | ${SITE_NAME}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${SITE_NAME}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="article:modified_time" content={isoDate} />

    <!-- ── Twitter / X ── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@calaifitness" />
    <meta name="twitter:title" content={`${title} | ${SITE_NAME}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- ── Favicon ── -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0A0A0A" />

    <!-- ── Font Preconnect ── -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- ── No-Flash Dark Mode ── -->
    <script is:inline>
      (function () {
        var s = ''; try { s = localStorage.getItem('theme') || ''; } catch (_) {}
        var d = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var t = s === 'dark' || s === 'light' ? s : (d ? 'dark' : 'light');
        document.documentElement.classList.remove('dark', 'light');
        document.documentElement.classList.add(t);
        try { localStorage.setItem('theme', t); } catch (_) {}
      })();
    </script>

    <!-- ── Structured Data (@graph) ── -->
    <script type="application/ld+json" set:html={jsonLdOutput} />

    <!-- ── Analytics ── -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YT6DG8JVDP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YT6DG8JVDP');
    </script>

    <!-- ── AdSense ── -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9326184680057918" crossorigin="anonymous"></script>

    <slot name="head" />
  </head>

  <body>
    <Header />

    <main id="main-content">
      <div class="calc-page-root">

        <!-- ═══════════════════════════════════════════
             MOBILE: stacked layout
             DESKTOP: 2-col (article + sidebar)
        ════════════════════════════════════════════ -->

        <!-- ── Left: Article Column ── -->
        <article class="calc-article" itemscope itemtype="https://schema.org/Article">

          <!-- ─────────────────────────────────────
               §1  BREADCRUMB
          ────────────────────────────────────── -->
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <ol role="list">
              {breadcrumbs.map((b, i) => (
                <li>
                  {i < breadcrumbs.length - 1 ? (
                    <>
                      <a href={b.href} class="breadcrumb-link">{b.name}</a>
                      <span class="breadcrumb-sep" aria-hidden="true">›</span>
                    </>
                  ) : (
                    <span class="breadcrumb-current" aria-current="page">{b.name}</span>
                  )}
                </li>
              ))}
            </ol>
          </nav>

          <!-- ─────────────────────────────────────
               §2  PAGE HEADER
          ────────────────────────────────────── -->
          <header class="calc-header">
            <h1 class="calc-h1" itemprop="headline">{title}</h1>

            <div class="calc-meta" role="complementary" aria-label="Page details">
              <span class="meta-item">
                <svg class="meta-icon" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 00-1-1H6zm1 5a1 1 0 011 1v2a1 1 0 01-2 0V8a1 1 0 011-1z"/>
                </svg>
                Formula: <strong class="meta-value">{formula}</strong>
              </span>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span class="meta-item">
                <svg class="meta-icon" fill="none" viewBox="0 0 16 16" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m0 4a4 4 0 100 8 4 4 0 000-8zm0 0V3"/>
                </svg>
                Updated: <time datetime={isoDate} itemprop="dateModified" class="meta-value">{displayDate}</time>
              </span>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span class="meta-item">
                <span aria-hidden="true">⏱</span>
                <span class="meta-value">30-second result</span>
              </span>
            </div>

            <!-- Short intro paragraph — keyword dense, user-first -->
            <p class="calc-intro" itemprop="description">
              Use our free <strong>{keyword}</strong> to get an instant, science-backed result
              in under 30 seconds. All calculations run entirely in your browser —
              no data leaves your device, no account required.
            </p>
          </header>

          <!-- ─────────────────────────────────────
               §3  CALCULATOR WIDGET
               (mobile: shows here; desktop: sticky sidebar-right via CSS)
          ────────────────────────────────────── -->
          <div class="calc-widget-inline" id="calculator-tool" aria-label="Calculator tool">
            <div class="widget-card">
              <div class="widget-card-header">
                <div class="widget-title-row">
                  <span class="widget-label" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </span>
                  <h2 class="widget-heading">Calculator</h2>
                  <span class="widget-badge">Free</span>
                </div>
                <p class="widget-privacy-note">
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  100% private · runs in your browser
                </p>
              </div>

              <div class="widget-body" id="calculator-mobile-target">
                <div id="calculator-slot-holder">
                  <slot name="calculator" />
                </div>
              </div>
            </div>
          </div>

          <!-- ─────────────────────────────────────
               §4  WHAT IS [METRIC]
          ────────────────────────────────────── -->
          <section class="content-section" aria-labelledby="what-is-heading">
            <h2 id="what-is-heading" class="section-h2">What Is {title}?</h2>
            <div class="prose-content" itemprop="articleBody">
              <slot name="what-is">
                <!-- Fallback prose if slot not provided -->
                <p>
                  The <strong>{keyword}</strong> is a validated tool used to estimate a key
                  health or fitness metric based on inputs such as height, weight, age, and
                  activity level. Understanding this metric is fundamental to setting accurate,
                  science-based fitness goals.
                </p>
                <p>
                  Unlike generic online tools, our calculator uses only peer-reviewed formulas
                  and clearly shows you the formula used, its known accuracy, and what the
                  research says your result means for your health.
                </p>
              </slot>
            </div>
          </section>

          <!-- ─────────────────────────────────────
               §5  HOW TO CALCULATE [METRIC]
          ────────────────────────────────────── -->
          <section class="content-section" aria-labelledby="how-to-heading">
            <h2 id="how-to-heading" class="section-h2">How to Calculate — The {formula} Formula</h2>
            <div class="prose-content">
              <slot name="how-to">
                <!-- Fallback formula display -->
                <p>
                  This calculator uses the <strong>{formula}</strong> equation — one of the
                  most widely validated formulas in the peer-reviewed literature.
                </p>
                <div class="formula-block" role="math" aria-label="Formula display">
                  <p class="formula-label">Formula ({formula})</p>
                  <code class="formula-code"><slot name="formula-code" /></code>
                  <p class="formula-source">Source: See individual calculator page for citation</p>
                </div>
              </slot>
            </div>
          </section>

          <!-- ─────────────────────────────────────
               §6  RANGES / WHAT YOUR NUMBER MEANS
          ────────────────────────────────────── -->
          <section class="content-section" aria-labelledby="ranges-heading">
            <h2 id="ranges-heading" class="section-h2">What Does Your Result Mean?</h2>
            <div class="prose-content">
              <slot name="ranges">
                <p class="text-body-md text-[var(--color-body)]">
                  See the result categories displayed directly in the calculator above.
                  Each range is based on current WHO or clinical guidelines.
                </p>
              </slot>
            </div>
          </section>

          <!-- ─────────────────────────────────────
               §7  EXTRA SLOT (optional)
          ────────────────────────────────────── -->
          <slot name="extra" />

          <!-- ─────────────────────────────────────
               §8  FAQ SECTION
          ────────────────────────────────────── -->
          {faqs.length > 0 && (
            <section class="content-section" aria-labelledby="faq-heading">
              <h2 id="faq-heading" class="section-h2">Frequently Asked Questions</h2>
              <div class="faq-list" role="list">
                {faqs.map((faq, i) => (
                  <div class="faq-item" role="listitem">
                    <details class="faq-details" id={`faq-${i}`}>
                      <summary class="faq-summary">
                        <h3 class="faq-question">{faq.question}</h3>
                        <svg
                          class="faq-chevron"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          aria-hidden="true"
                        >
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                      </summary>
                      <div class="faq-answer">
                        <p>{faq.answer}</p>
                      </div>
                    </details>
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- ─────────────────────────────────────
               §9  RELATED CALCULATORS
          ────────────────────────────────────── -->
          {relatedCalculators.length > 0 && (
            <section class="content-section" aria-labelledby="related-heading">
              <h2 id="related-heading" class="section-h2">Next Steps</h2>
              <p class="section-intro">
                Now that you have your {title.toLowerCase().replace('calculator', '').trim()} result,
                use these tools to build a complete picture of your health metrics.
              </p>

              <div class="related-grid" role="list" aria-label="Related calculators">
                {relatedCalculators.map(rel => (
                  <a
                    href={rel.href}
                    class="related-card"
                    role="listitem"
                    aria-label={`${rel.name}: ${rel.description ?? ''}`}
                  >
                    <span class="related-emoji" aria-hidden="true">{rel.emoji}</span>
                    <div class="related-text">
                      <span class="related-name">{rel.name}</span>
                      {rel.description && (
                        <span class="related-desc">{rel.description}</span>
                      )}
                    </div>
                    <svg class="related-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </a>
                ))}
              </div>
            </section>
          )}
        </article>

        <!-- ── Right: Sticky Sidebar (desktop only) ── -->
        <aside class="calc-sidebar" aria-label="Calculator information and tools">

          <!-- Calculator Widget (desktop position) -->
          <div class="sidebar-widget" id="calculator-tool-desktop">
            <div class="widget-card">
              <div class="widget-card-header">
                <div class="widget-title-row">
                  <span class="widget-label" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </span>
                  <h2 class="widget-heading">Calculator</h2>
                  <span class="widget-badge">Free</span>
                </div>
                <p class="widget-privacy-note">
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  100% private · runs in your browser
                </p>
              </div>
              <div class="widget-body" id="calculator-desktop-target">
                <!-- Teleported here on desktop screen sizes -->
              </div>
            </div>
          </div>

          <!-- Quick Stats Card -->
          <div class="sidebar-card" aria-label="Calculator statistics">
            <h3 class="sidebar-card-title">Quick Stats</h3>
            <dl class="stats-list">
              <div class="stat-row">
                <dt class="stat-label">Formula</dt>
                <dd class="stat-value font-medium">{formula}</dd>
              </div>
              <div class="stat-row">
                <dt class="stat-label">Accuracy</dt>
                <dd class="stat-value">
                  <span class="accuracy-badge">{accuracyRating}</span>
                </dd>
              </div>
              <div class="stat-row">
                <dt class="stat-label">Last updated</dt>
                <dd class="stat-value">
                  <time datetime={isoDate}>{displayDate}</time>
                </dd>
              </div>
              <div class="stat-row">
                <dt class="stat-label">Privacy</dt>
                <dd class="stat-value text-[var(--color-success)]">On-device only</dd>
              </div>
              <div class="stat-row">
                <dt class="stat-label">Cost</dt>
                <dd class="stat-value text-[var(--color-success)]">Always free</dd>
              </div>
            </dl>
          </div>

          <!-- Share Card -->
          <div class="sidebar-card" aria-label="Share this calculator">
            <h3 class="sidebar-card-title">Share This Tool</h3>
            <p class="sidebar-card-body">Found this useful? Send the link to a friend.</p>
            <button
              id="copy-link-btn"
              type="button"
              class="share-btn"
              aria-label="Copy calculator link to clipboard"
              data-url={canonical}
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span id="copy-link-text">Copy link</span>
            </button>
          </div>

          <!-- Newsletter Card -->
          <div class="sidebar-card newsletter-card" aria-label="Subscribe to fitness tips">
            <h3 class="sidebar-card-title">Evidence-Based Tips</h3>
            <p class="sidebar-card-body">
              Weekly articles on nutrition, training, and body composition. Science only — no pseudoscience.
            </p>
            <form
              class="newsletter-form"
              id="newsletter-form"
              aria-label="Newsletter signup"
              novalidate
            >
              <label for="newsletter-email" class="sr-only">Email address</label>
              <input
                type="email"
                id="newsletter-email"
                name="email"
                placeholder="your@email.com"
                autocomplete="email"
                required
                class="newsletter-input"
                aria-required="true"
                aria-describedby="newsletter-hint"
              />
              <p id="newsletter-hint" class="newsletter-hint">No spam. Unsubscribe any time.</p>
              <button type="submit" class="newsletter-btn">
                Subscribe Free
              </button>
            </form>
          </div>
        </aside>

      </div><!-- /calc-page-root -->
    </main>

    <Footer />

    <!-- ── Theme toggle dispatch ── -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        window.__setTheme = function (t) {
          var root = document.documentElement;
          root.classList.remove('dark', 'light');
          root.classList.add(t);
          try { localStorage.setItem('theme', t); } catch (_) {}
          window.dispatchEvent(new CustomEvent('themeChange', { detail: { theme: t } }));
        };
      });
    </script>

    <!-- ── Copy Link ── -->
    <script>
      const btn = document.getElementById('copy-link-btn');
      const txt = document.getElementById('copy-link-text');
      if (btn && txt) {
        btn.addEventListener('click', async () => {
          const url = btn.dataset.url ?? window.location.href;
          try {
            await navigator.clipboard.writeText(url);
            txt.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              txt.textContent = 'Copy link';
              btn.classList.remove('copied');
            }, 2000);
          } catch (_) {
            // Fallback for older browsers
            const input = document.createElement('input');
            input.value = url;
            document.body.appendChild(input);
            input.select();
            document.execCommand('copy');
            document.body.removeChild(input);
            txt.textContent = 'Copied!';
            setTimeout(() => { txt.textContent = 'Copy link'; }, 2000);
          }
        });
