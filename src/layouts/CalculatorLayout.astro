    <!-- Teleport calculator widget script -->
    <script is:inline>
      (function() {
        function reposition() {
          var slotHolder = document.getElementById('calculator-slot-holder');
          var desktopTarget = document.getElementById('calculator-desktop-target');
          var mobileTarget = document.getElementById('calculator-mobile-target');

          if (!slotHolder) return;

          if (window.innerWidth >= 1024) {
            if (desktopTarget && !desktopTarget.contains(slotHolder)) {
              desktopTarget.appendChild(slotHolder);
            }
          } else {
            if (mobileTarget && !mobileTarget.contains(slotHolder)) {
              mobileTarget.appendChild(slotHolder);
            }
          }
        }

        // Run immediately and on resize/load events
        window.addEventListener('resize', reposition);
        document.addEventListener('DOMContentLoaded', reposition);
        reposition();
        setTimeout(reposition, 20);
        setTimeout(reposition, 200);
      })();
    </script>

