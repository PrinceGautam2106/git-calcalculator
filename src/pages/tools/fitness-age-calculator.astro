<script>
const calcBtn = document.getElementById('fa-calc-btn') as HTMLButtonElement;
const errorEl = document.getElementById('fa-error') as HTMLParagraphElement;
const resultEl = document.getElementById('fa-result') as HTMLDivElement;

const ageInput = document.getElementById('fa-age') as HTMLInputElement;
const genderSelect = document.getElementById('fa-gender') as HTMLSelectElement;
const rhrInput = document.getElementById('fa-rhr') as HTMLInputElement;
const waistInput = document.getElementById('fa-waist') as HTMLInputElement;
const activitySelect = document.getElementById('fa-activity') as HTMLSelectElement;

const mainNumber = document.getElementById('fa-main-number') as HTMLSpanElement;
const revealDesc = document.getElementById('fa-reveal-desc') as HTMLSpanElement;

const vo2Display = document.getElementById('fa-vo2-display') as HTMLSpanElement;
const avgVo2Display = document.getElementById('fa-average-vo2-display') as HTMLSpanElement;

const shareBtn = document.getElementById('fa-share-btn') as HTMLButtonElement;
const shareMsg = document.getElementById('fa-share-msg') as HTMLParagraphElement;

let lastCalculatedAge = 0;
let lastChronologicalAge = 0;

function calculate() {
  clearErrors();

  const age = parseFloat(ageInput.value);
  const rhr = parseFloat(rhrInput.value);
  const waist = parseFloat(waistInput.value);

  if (isNaN(age) || age < 20 || age > 90) {
    showError('Biological estimations are validated for ages between 20 and 90.');
    ageInput.classList.add('input-error'); ageInput.focus(); return;
  }
  if (isNaN(rhr) || rhr < 30 || rhr > 120) {
    showError('Please enter a valid resting heart rate between 30 and 120 bpm.');
    rhrInput.classList.add('input-error'); rhrInput.focus(); return;
  }
  if (isNaN(waist) || waist < 40 || waist > 200) {
    showError('Please enter a valid waist circumference.');
    waistInput.classList.add('input-error'); waistInput.focus(); return;
  }

  const isMale = genderSelect.value === 'male';
  const actLevel = parseFloat(activitySelect.value); // 1 to 4

  // NTNU Regression formulas:
  // Male: 79.9 - (0.39 * Age) - (0.137 * Waist cm) - (0.095 * RHR) + (4.0 * Activity level)
  // Female: 56.3 - (0.37 * Age) - (0.090 * Waist cm) - (0.090 * RHR) + (3.3 * Activity level)
  let vo2Max = 0;
  if (isMale) {
    vo2Max = 79.9 - (0.39 * age) - (0.137 * waist) - (0.095 * rhr) + (4.0 * actLevel);
  } else {
    vo2Max = 56.3 - (0.37 * age) - (0.090 * waist) - (0.090 * rhr) + (3.3 * actLevel);
  }

  // Baseline standard averages mapping (HUNT study baselines)
  // Average VO2 Max at Age = Base - (slope * Age)
  // Male base: 54, slope: 0.3
  // Female base: 44, slope: 0.3
  const expectedAvgVo2 = isMale ? 54 - (0.3 * age) : 44 - (0.3 * age);

  // Compute fitness age
  // Higher VO2 Max = younger fitness age.
  // 1 unit of VO2 Max above average = approx 1.5 years younger (clamped)
  const diff = expectedAvgVo2 - vo2Max;
  let fitnessAge = Math.round(age + (diff * 1.5));

  // Clamps: min 18, max chronological age + 15
  fitnessAge = Math.max(18, Math.min(fitnessAge, age + 15));

  lastCalculatedAge = fitnessAge;
  lastChronologicalAge = age;

  // Reveal description
  let desc = '';
  if (fitnessAge < age) {
    desc = `🎉 Excellent! Your biological fitness age is ${age - fitnessAge} years younger than actual.`;
  } else if (fitnessAge === age) {
    desc = '⚖️ Normal. Your biological fitness age matches your chronological age.';
  } else {
    desc = `⚠️ Your biological fitness age is ${fitnessAge - age} years older than actual. Cardio recommended.`;
  }

  // Populate UI
  mainNumber.textContent = fitnessAge.toString();
  revealDesc.textContent = desc;

  vo2Display.textContent = `${vo2Max.toFixed(1)} ml/kg/min`;
  avgVo2Display.textContent = `${expectedAvgVo2.toFixed(1)} ml/kg/min`;

  shareBtn.innerHTML = `🔗 Copy Share Message`;
  shareBtn.classList.remove('copied');
  shareMsg.classList.add('hidden');

  resultEl.classList.remove('hidden');
}

calcBtn.addEventListener('click', calculate);

shareBtn.addEventListener('click', () => {
  if (lastCalculatedAge === 0) return;
  const msg = `I calculated my biological fitness age on CalaiFitness! Chronological age: ${lastChronologicalAge} | Biological fitness age: ${lastCalculatedAge}. Calculate yours free: https://www.calaifitness.com/tools/fitness-age-calculator`;
  
  navigator.clipboard.writeText(msg).then(() => {
    shareBtn.innerHTML = `✓ Copied`;
    shareBtn.classList.add('copied');
    shareMsg.classList.remove('hidden');
  }).catch(() => {
    showError('Could not write to clipboard. Copy manually: ' + msg);
  });
});

function showError(msg: string) {
  errorEl.textContent = msg;
  errorEl.classList.remove('hidden');
}
function clearErrors() {
  errorEl.classList.add('hidden');
  [ageInput, rhrInput, waistInput].forEach(el => el?.classList.remove('input-error'));
}
</script>
