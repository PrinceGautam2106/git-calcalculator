<script>
const metricBtn = document.getElementById('plan-unit-metric') as HTMLButtonElement;
const imperialBtn = document.getElementById('plan-unit-imperial') as HTMLButtonElement;
const calcBtn = document.getElementById('plan-calc-btn') as HTMLButtonElement;
const errorEl = document.getElementById('plan-error') as HTMLParagraphElement;
const resultsEl = document.getElementById('plan-results') as HTMLDivElement;

const ageInput = document.getElementById('plan-age') as HTMLInputElement;
const genderSelect = document.getElementById('plan-gender') as HTMLSelectElement;
const heightCmInput = document.getElementById('plan-height-cm') as HTMLInputElement;
const heightFtInput = document.getElementById('plan-height-ft') as HTMLInputElement;
const heightInInput = document.getElementById('plan-height-in') as HTMLInputElement;
const weightKgInput = document.getElementById('plan-weight-kg') as HTMLInputElement;
const weightLbsInput = document.getElementById('plan-weight-lbs') as HTMLInputElement;
const goalWeightInput = document.getElementById('plan-goal-weight') as HTMLInputElement;
const goalUnitLabel = document.getElementById('plan-goal-unit') as HTMLSpanElement;
const weeksInput = document.getElementById('plan-weeks') as HTMLInputElement;
const activitySelect = document.getElementById('plan-activity') as HTMLSelectElement;

const targetCalDisplay = document.getElementById('plan-target-cal') as HTMLSpanElement;
const warningDisplay = document.getElementById('plan-safety-warning') as HTMLParagraphElement;
const tdeeDisplay = document.getElementById('plan-tdee-display') as HTMLSpanElement;
const deficitDisplay = document.getElementById('plan-deficit-display') as HTMLSpanElement;
const rateDisplay = document.getElementById('plan-rate-display') as HTMLSpanElement;

const macroP = document.getElementById('plan-macro-p') as HTMLSpanElement;
const macroC = document.getElementById('plan-macro-c') as HTMLSpanElement;
const macroF = document.getElementById('plan-macro-f') as HTMLSpanElement;
const projectionList = document.getElementById('plan-projection-list') as HTMLDivElement;

const downloadBtn = document.getElementById('plan-download-btn') as HTMLButtonElement;

let isMetric = true;
let lastTargetPlan: Record<string, any> | null = null;

function setUnit(metric: boolean) {
  isMetric = metric;
  metricBtn.classList.toggle('active', metric);
  imperialBtn.classList.toggle('active', !metric);

  document.getElementById('plan-h-metric')?.classList.toggle('hidden', !metric);
  document.getElementById('plan-h-imperial')?.classList.toggle('hidden', metric);
  document.getElementById('plan-w-metric')?.classList.toggle('hidden', !metric);
  document.getElementById('plan-w-imperial')?.classList.toggle('hidden', metric);

  goalUnitLabel.textContent = metric ? 'kg' : 'lbs';
  resultsEl.classList.add('hidden');
  clearErrors();
}
metricBtn.addEventListener('click', () => setUnit(true));
imperialBtn.addEventListener('click', () => setUnit(false));

function calculate() {
  clearErrors();

  const age = parseFloat(ageInput.value);
  if (isNaN(age) || age < 10 || age > 100) {
    showError('Please enter a valid age between 10 and 100.');
    ageInput.classList.add('input-error'); ageInput.focus(); return;
  }

  let heightCm = 0;
  let currentKg = 0;
  let goalKg = 0;

  if (isMetric) {
    heightCm = parseFloat(heightCmInput.value);
    currentKg = parseFloat(weightKgInput.value);
    goalKg = parseFloat(goalWeightInput.value);

    if (isNaN(heightCm) || heightCm < 50 || heightCm > 280) {
      showError('Please enter a valid height.');
      heightCmInput.classList.add('input-error'); heightCmInput.focus(); return;
    }
    if (isNaN(currentKg) || currentKg < 20 || currentKg > 400) {
      showError('Please enter a valid weight.');
      weightKgInput.classList.add('input-error'); weightKgInput.focus(); return;
    }
    if (isNaN(goalKg) || goalKg < 20 || goalKg > 400) {
      showError('Please enter a valid target weight.');
      goalWeightInput.classList.add('input-error'); goalWeightInput.focus(); return;
    }
  } else {
    const ft = parseFloat(heightFtInput.value) || 0;
    const inch = parseFloat(heightInInput.value) || 0;
    const totalInches = ft * 12 + inch;
    const currentLbs = parseFloat(weightLbsInput.value);
    const goalLbs = parseFloat(goalWeightInput.value);

    if (totalInches < 20 || totalInches > 110) {
      showError('Please enter a valid height.');
      heightFtInput.classList.add('input-error'); heightFtInput.focus(); return;
    }
    if (isNaN(currentLbs) || currentLbs < 44 || currentLbs > 880) {
      showError('Please enter a valid weight.');
      weightLbsInput.classList.add('input-error'); weightLbsInput.focus(); return;
    }
    if (isNaN(goalLbs) || goalLbs < 44 || goalLbs > 880) {
      showError('Please enter a valid target weight.');
      goalWeightInput.classList.add('input-error'); goalWeightInput.focus(); return;
    }

    heightCm = totalInches * 2.54;
    currentKg = currentLbs * 0.453592;
    goalKg = goalLbs * 0.453592;
  }

  const weeks = parseFloat(weeksInput.value);
  if (isNaN(weeks) || weeks < 4 || weeks > 24) {
    showError('Please select a planning timeline between 4 and 24 weeks.');
    weeksInput.classList.add('input-error'); weeksInput.focus(); return;
  }

  if (goalKg >= currentKg) {
    showError('Target weight must be less than current weight to plan a calorie deficit.');
    goalWeightInput.classList.add('input-error'); goalWeightInput.focus(); return;
  }

  // Calculate BMR & TDEE (Mifflin-St Jeor)
  const isMale = genderSelect.value === 'male';
  const base = (10 * currentKg) + (6.25 * heightCm) - (5 * age);
  const bmr = isMale ? base + 5 : base - 161;
  const activityMult = parseFloat(activitySelect.value);
  const tdee = Math.round(bmr * activityMult);

  // Calorie deficit calculation (1 kg fat = 7,700 kcal)
  const totalLossKg = currentKg - goalKg;
  const weeklyLossKg = totalLossKg / weeks;
  const dailyDeficitCal = (weeklyLossKg * 7700) / 7;
  const targetCalories = Math.round(tdee - dailyDeficitCal);

  // Safety boundaries
  const safetyMin = isMale ? 1500 : 1200;
  const isUnsafe = targetCalories < safetyMin;
  const adjustedTarget = Math.max(targetCalories, 1000); // hard limit

  warningDisplay.classList.toggle('hidden', !isUnsafe);

  // Macro split recommendations: Protein 2g/kg, Fats 25% of calories, Carbs remainder
  const proteinGrams = Math.round(currentKg * 2.0);
  const proteinKcal = proteinGrams * 4;
  const fatKcal = Math.round(adjustedTarget * 0.25);
  const fatGrams = Math.round(fatKcal / 9);
  const carbKcal = Math.max(adjustedTarget - proteinKcal - fatKcal, 0);
  const carbGrams = Math.round(carbKcal / 4);

  // Week by week projection
  let projectionHtml = '';
  const weightArr: number[] = [];

  for (let w = 1; w <= weeks; w++) {
    const currentWeightProj = currentKg - (w * weeklyLossKg);
    const weightDisplayVal = isMetric ? currentWeightProj : currentWeightProj * 2.20462;
    const unitText = isMetric ? 'kg' : 'lbs';

    weightArr.push(currentWeightProj);

    projectionHtml += `
      <div style="display:flex; justify-content:space-between; align-items:center; padding:9px 12px; background:var(--color-canvas); border-bottom:1px solid var(--color-hairline);">
        <span style="font-size:0.8125rem; font-weight:500; color:var(--color-ink)">Week ${w}</span>
        <span style="font-family:var(--font-mono); font-size:0.875rem; font-weight:600; color:var(--color-primary)">
          ${weightDisplayVal.toFixed(1)} ${unitText}
        </span>
      </div>
    `;
  }

  // Populate UI
  targetCalDisplay.textContent = adjustedTarget.toLocaleString();
  tdeeDisplay.textContent = `${tdee.toLocaleString()} kcal`;
  deficitDisplay.textContent = `-${Math.round(dailyDeficitCal)} kcal/day`;
  
  const lossRateDisplay = isMetric ? `${weeklyLossKg.toFixed(2)} kg/wk` : `${(weeklyLossKg * 2.20462).toFixed(2)} lbs/wk`;
  rateDisplay.textContent = lossRateDisplay;

  macroP.textContent = `${proteinGrams}g`;
  macroC.textContent = `${carbGrams}g`;
  macroF.textContent = `${fatGrams}g`;

  projectionList.innerHTML = projectionHtml;
  const lastRow = projectionList.querySelector('div:last-child') as HTMLElement;
  if (lastRow) lastRow.style.borderBottom = 'none';

  // Cache data for print layout
  lastTargetPlan = {
    age,
    gender: genderSelect.value,
    height: isMetric ? `${Math.round(heightCm)} cm` : `${heightFtInput.value}'${heightInInput.value}"`,
    startWeight: isMetric ? `${weightKgInput.value} kg` : `${weightLbsInput.value} lbs`,
    goalWeight: isMetric ? `${goalWeightInput.value} kg` : `${goalWeightInput.value} lbs`,
    timeline: `${weeks} weeks`,
    calories: adjustedTarget,
    protein: `${proteinGrams}g`,
    carbs: `${carbGrams}g`,
    fat: `${fatGrams}g`,
    rate: lossRateDisplay,
    weeksList: weightArr.map((w, idx) => ({
      week: idx + 1,
      weight: isMetric ? `${w.toFixed(1)} kg` : `${(w * 2.20462).toFixed(1)} lbs`
    }))
  };

  resultsEl.classList.remove('hidden');
}

calcBtn.addEventListener('click', calculate);

downloadBtn.addEventListener('click', () => {
  if (!lastTargetPlan) return;
  const plan = lastTargetPlan;

  // Open clean printable layout
  const printWindow = window.open('', '_blank');
  if (!printWindow) return;

  const html = `
    <!DOCTYPE html>
    <html>
    <head>
      <title>My 12-Week Weight Loss Plan — CalaiFitness</title>
      <style>
        body { font-family: -apple-system, sans-serif; color: #111; padding: 40px; line-height: 1.5; }
        h1 { border-bottom: 2px solid #111; padding-bottom: 10px; font-size: 24px; }
        .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 30px; }
        .card { padding: 15px; border: 1px solid #ddd; border-radius: 4px; background: #f9f9f9; }
        .val { font-size: 20px; font-weight: bold; color: #3b82f6; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background: #f5f5f5; }
      </style>
    </head>
    <body>
      <h1>My CalaiFitness Weight Loss & Deficit Plan</h1>
      <div class="grid">
        <div class="card">
          <h3>Target Intake</h3>
          <div class="val">${plan.calories} kcal/day</div>
        </div>
        <div class="card">
          <h3>Daily Deficit Rate</h3>
          <div class="val">${plan.rate}</div>
        </div>
        <div class="card">
          <h3>Macronutrients</h3>
          <p>Protein: <strong>${plan.protein}</strong> | Carbs: <strong>${plan.carbs}</strong> | Fats: <strong>${plan.fat}</strong></p>
        </div>
        <div class="card">
          <h3>Profile Overview</h3>
          <p>Age: ${plan.age} | Height: ${plan.height} | Starting: ${plan.startWeight} | Target: ${plan.goalWeight}</p>
        </div>
      </div>

      <h2>Week-by-Week Roadmap</h2>
      <table>
        <thead>
          <tr>
            <th>Timeline Milestone</th>
            <th>Target Bodyweight</th>
          </tr>
        </thead>
        <tbody>
          ${plan.weeksList.map((w: any) => `
            <tr>
              <td>End of Week ${w.week}</td>
              <td><strong>${w.weight}</strong></td>
            </tr>
          `).join('')}
        </tbody>
      </table>
      <p style="margin-top: 40px; font-size: 11px; color: #888; text-align: center;">Generated on CalaiFitness.com — 100% private, on-device calculations.</p>
      <script>window.print();<\/script>
    </body>
    </html>
  `;
  printWindow.document.write(html);
  printWindow.document.close();
});

function showError(msg: string) {
  errorEl.textContent = msg;
  errorEl.classList.remove('hidden');
}
function clearErrors() {
  errorEl.classList.add('hidden');
  [ageInput, heightCmInput, heightFtInput, heightInInput, weightKgInput, weightLbsInput, goalWeightInput, weeksInput]
    .forEach(el => el?.classList.remove('input-error'));
}
</script>
