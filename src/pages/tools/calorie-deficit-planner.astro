import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

export const prerender = true;

const faqs = [
  {
    question: 'What is a calorie deficit?',
    answer: 'A calorie deficit occurs when you consume fewer calories from food and drink than your body expends to maintain its functions and physical activity. When in a deficit, your body mobilizes stored energy (primarily body fat) to cover the energy shortage, resulting in weight loss.',
  },
  {
    question: 'How large of a calorie deficit is safe?',
    answer: 'A safe and sustainable deficit is between 300 and 500 calories per day, which translates to losing 0.3 to 0.5 kg (approx. 0.5 to 1.0 lb) of fat per week. Deficits exceeding 1,000 calories per day are generally discouraged as they increase muscle loss, cause metabolic adaptation, and lead to nutrient deficiencies.',
  },
  {
    question: 'What is the minimum safe calorie target per day?',
    answer: 'To safeguard metabolic, hormonal, and thyroid health, daily intake should not drop below 1,200 calories for adult women or 1,500 calories for adult men, unless supervised by a medical professional or clinical dietitian.',
  },
  {
    question: 'Does metabolic rate slow down during a deficit?',
    answer: 'Yes. As you lose weight, your body requires less energy to move and survive, lowering your TDEE. Additionally, the body adapts through adaptive thermogenesis (slightly reducing subconscious movement and heat output). Recalculating your deficit every 4–6 weeks helps navigate this natural adaptive slowdown.',
  },
  {
    question: 'How do I track my progress on the 12-week plan?',
    answer: 'Weigh yourself daily in the morning, immediately after waking and using the bathroom. Take the average of your weight at the end of each week. This weekly average removes daily water fluctuations and gives you a true progress trend to evaluate against your planner.',
  },
  {
    question: 'How much protein should I eat during a calorie deficit?',
    answer: 'Maintaining a high protein intake (1.8 to 2.4 grams per kilogram of body weight) is critical during a deficit. This ensures that the weight lost comes from fat stores rather than metabolically active skeletal muscle tissue.',
  },
];

const relatedCalculators = [
  {
    name: 'Calorie Target',
    href: '/calculator/calories',
    emoji: '🍎',
    description: 'Set daily calories for your goal',
  },
  {
    name: 'Macro Split',
    href: '/calculator/macros',
    emoji: '🥗',
    description: 'Grams of carbs, protein, and fat',
  },
  {
    name: 'TDEE Calculator',
    href: '/calculator/tdee',
