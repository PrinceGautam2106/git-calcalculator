<script>
// Percentage distributions by diet style:
// standard: 30% P / 40% C / 30% F
// lowcarb: 35% P / 25% C / 40% F
// highprotein: 40% P / 35% C / 25% F
// keto: 20% P / 5% C / 75% F
const DIET_SPLITS = {
  standard:    { p: 30, c: 40, f: 30 },
  lowcarb:     { p: 35, c: 25, f: 40 },
  highprotein: { p: 40, c: 35, f: 25 },
  keto:        { p: 20, c: 5,  f: 75 },
};

const modeCalcBtn = document.getElementById('macro-mode-calc') as HTMLButtonElement;
const modeManualBtn = document.getElementById('macro-mode-manual') as HTMLButtonElement;
const calcBtn = document.getElementById('macro-calc-btn') as HTMLButtonElement;
const errorEl = document.getElementById('macro-error') as HTMLParagraphElement;
const resultsEl = document.getElementById('macro-results') as HTMLDivElement;

const calcFields = document.getElementById('macro-calc-fields') as HTMLDivElement;
const manualFields = document.getElementById('macro-manual-fields') as HTMLDivElement;
const goalGroup = document.getElementById('macro-goal-group') as HTMLDivElement;

const ageInput = document.getElementById('macro-age') as HTMLInputElement;
const genderSelect = document.getElementById('macro-gender') as HTMLSelectElement;
const heightInput = document.getElementById('macro-height') as HTMLInputElement;
const weightInput = document.getElementById('macro-weight') as HTMLInputElement;
const activitySelect = document.getElementById('macro-activity') as HTMLSelectElement;

const manualCalInput = document.getElementById('macro-calories') as HTMLInputElement;
const goalSelect = document.getElementById('macro-goal') as HTMLSelectElement;
const dietSelect = document.getElementById('macro-diet') as HTMLSelectElement;

const targetKcalDisplay = document.getElementById('macro-target-kcal') as HTMLSpanElement;
const valP = document.getElementById('macro-val-p') as HTMLSpanElement;
const valC = document.getElementById('macro-val-c') as HTMLSpanElement;
const valF = document.getElementById('macro-val-f') as HTMLSpanElement;

const pctP = document.getElementById('macro-pct-p') as HTMLSpanElement;
const pctC = document.getElementById('macro-pct-c') as HTMLSpanElement;
const pctF = document.getElementById('macro-pct-f') as HTMLSpanElement;

const pieChart = document.getElementById('macro-pie-chart') as HTMLDivElement;

let isCalculateMode = true;

modeCalcBtn.addEventListener('click', () => {
  isCalculateMode = true;
  modeCalcBtn.classList.add('active');
  modeManualBtn.classList.remove('active');
  calcFields.classList.remove('hidden');
  manualFields.classList.add('hidden');
  goalGroup.classList.remove('hidden');
  resultsEl.classList.add('hidden');
  clearErrors();
});

modeManualBtn.addEventListener('click', () => {
  isCalculateMode = false;
  modeManualBtn.classList.add('active');
  modeCalcBtn.classList.remove('active');
  calcFields.classList.add('hidden');
  manualFields.classList.remove('hidden');
  goalGroup.classList.add('hidden');
  resultsEl.classList.add('hidden');
  clearErrors();
});

function calculate() {
  clearErrors();

  let calories = 0;

  if (isCalculateMode) {
    const age = parseFloat(ageInput.value);
    const height = parseFloat(heightInput.value);
    const weight = parseFloat(weightInput.value);

    if (isNaN(age) || age < 10 || age > 100) {
      showError('Please enter a valid age between 10 and 100.');
      ageInput.classList.add('input-error'); ageInput.focus(); return;
    }
    if (isNaN(height) || height < 50 || height > 280) {
      showError('Please enter a valid height.');
      heightInput.classList.add('input-error'); heightInput.focus(); return;
    }
    if (isNaN(weight) || weight < 20 || weight > 400) {
      showError('Please enter a valid weight.');
      weightInput.classList.add('input-error'); weightInput.focus(); return;
    }

    const isMale = genderSelect.value === 'male';
    const base = (10 * weight) + (6.25 * height) - (5 * age);
    const bmr = isMale ? base + 5 : base - 161;
    const activityMult = parseFloat(activitySelect.value);
    const tdee = Math.round(bmr * activityMult);

    const goal = goalSelect.value;
    let adjust = 0;
    if (goal === 'lose') adjust = -500;
    else if (goal === 'build') adjust = 300;

    calories = Math.max(tdee + adjust, 1200);
  } else {
    calories = parseFloat(manualCalInput.value);
    if (isNaN(calories) || calories < 800 || calories > 10000) {
      showError('Please enter a valid daily calorie target between 800 and 10,000.');
      manualCalInput.classList.add('input-error'); manualCalInput.focus(); return;
    }
  }

  // Get selected diet split
  const diet = dietSelect.value as keyof typeof DIET_SPLITS;
  const split = DIET_SPLITS[diet] || DIET_SPLITS.standard;

  // Calculate grams: Protein/Carbs 4 kcal/g, Fat 9 kcal/g
  const proteinG = Math.round((calories * (split.p / 100)) / 4);
  const carbsG = Math.round((calories * (split.c / 100)) / 4);
  const fatG = Math.round((calories * (split.f / 100)) / 9);

  // Display
  targetKcalDisplay.textContent = Math.round(calories).toLocaleString();
  valP.textContent = `${proteinG}g`;
  valC.textContent = `${carbsG}g`;
  valF.textContent = `${fatG}g`;

  pctP.textContent = `${split.p}%`;
  pctC.textContent = `${split.c}%`;
  pctF.textContent = `${split.f}%`;

  // Draw CSS Pie chart conic-gradient
  // Protein starts at 0, Carb starts after Protein, Fat starts after Carb
  const pStop = split.p;
  const cStop = split.p + split.c;
  // Use tailwind/css hexes: primary (#3b82f6), cyan (#06b6d4), warning (#f59e0b)
  const gradient = `conic-gradient(#3b82f6 0% ${pStop}%, #06b6d4 ${pStop}% ${cStop}%, #f59e0b ${cStop}% 100%)`;
  pieChart.style.background = gradient;

  resultsEl.classList.remove('hidden');
}

calcBtn.addEventListener('click', calculate);

function showError(msg: string) {
  errorEl.textContent = msg;
  errorEl.classList.remove('hidden');
}
function clearErrors() {
  errorEl.classList.add('hidden');
  [ageInput, heightInput, weightInput, manualCalInput].forEach(el => el?.classList.remove('input-error'));
}
</script>
