import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import LeanMassCalculator from '../../components/calculators/LeanMassCalculator.astro';

export const prerender = true;

const faqs = [
  {
    question: 'What is lean body mass (LBM)?',
    answer: 'Lean body mass is the total weight of everything in your body except for fat tissue. This includes your skeletal muscles, bones, organs, connective tissues, skin, and body water. It represents your metabolically active tissue, and maintaining a high level of LBM is essential for a fast metabolism, physical strength, and general health.',
  },
  {
    question: 'How does the Boer formula calculate lean body mass?',
    answer: 'The Boer formula is a mathematical model developed in 1984 that estimates lean body mass based on height, weight, and biological sex. It is widely used in medical settings to compute drug dosages (especially for oncology and anesthesiology) because it provides highly consistent estimations across varying heights and weights.',
  },
  {
    question: 'What is the difference between lean body mass and muscle mass?',
    answer: 'Lean body mass (LBM) refers to your entire fat-free mass, which includes bones, water, organs, and connective tissue alongside muscle. Muscle mass (specifically skeletal muscle mass) is just one component of LBM. While you can build skeletal muscle through strength training, it is only a subset of your overall lean body mass.',
  },
  {
    question: 'Why is lean body mass important for weight loss?',
    answer: 'Lean body mass determines your resting metabolic rate. Muscle tissue burns roughly three times more calories than fat tissue even at rest. When you lose weight, preserving LBM (by lifting weights and consuming adequate protein) ensures your metabolism stays high, making it far easier to maintain your weight loss over time.',
  },
  {
    question: 'How do I increase my lean body mass?',
    answer: 'To increase lean body mass, you must stimulate muscle growth (hypertrophy) through progressive resistance training (such as lifting weights) and supply your body with adequate building blocks. This means consuming sufficient daily protein (1.6 to 2.2 grams per kilogram of weight) and maintaining a small caloric surplus.',
  },
  {
    question: 'Does body water affect lean body mass measurements?',
    answer: 'Yes. Since water is fat-free, all body water is classified as part of your lean body mass. Consequently, changes in hydration status (such as muscle glycogen storage, sodium retention, or dehydration) will cause temporary shifts in your estimated lean body mass, even if your actual muscle or bone mass has not changed.',
  },
  {
    question: 'What is a healthy lean body mass percentage?',
    answer: 'Lean body mass percentage is the inverse of your body fat percentage. For men, a healthy LBM range is 76% to 90% (corresponding to 10% to 24% body fat). For women, a healthy LBM range is 68% to 80% (corresponding to 20% to 32% body fat). Athletic individuals will have higher percentages.',
  },
  {
    question: 'Is the Boer formula accurate for obese individuals?',
    answer: 'The Boer formula is highly accurate for normal and overweight individuals. However, for severely obese individuals (BMI > 35), the formula can sometimes underestimate lean body mass. For clinically obese populations, alternative clinical equations (like the Janmahasatian formula) are occasionally preferred in pharmacology.',
  },
];

