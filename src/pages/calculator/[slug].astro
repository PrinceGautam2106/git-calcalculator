---
import Layout from '../../layouts/Layout.astro';
import InputFlow from '../../components/calculators/InputFlow.astro';
import { calculatorRegistry } from '../../utils/calculators';

export function getStaticPaths() {
  return Object.keys(calculatorRegistry).map(slug => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;

// Validate slug
if (!slug || !(slug in calculatorRegistry)) {
  return Astro.redirect('/404');
}

const calc = calculatorRegistry[slug as keyof typeof calculatorRegistry];
---

<Layout title={`${calc.label} — FitnessCalculator`} description={calc.metaDescription || calc.description}>
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6 py-8 sm:py-12">
    <a href="/" class="mb-4 sm:mb-6 inline-flex items-center gap-2 text-xs sm:text-sm text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white">
      ← Back to home
    </a>
    
    <div class="mb-6 sm:mb-8">
      <div class="mb-3 sm:mb-4 text-4xl sm:text-5xl">{calc.icon}</div>
      <h1 class="mb-1 sm:mb-2 text-2xl sm:text-4xl font-bold">{calc.label}</h1>
      <p class="text-sm sm:text-lg text-black/60 dark:text-white/60">{calc.description}</p>
    </div>

    <InputFlow calculatorSlug={slug} requiredFields={calc.fields} />

    <!-- Content Sections -->
    {slug === 'bmi' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is BMI?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Body Mass Index (BMI) is a number calculated from your height and weight. It is a widely used screening tool to identify whether a person is underweight, at a healthy weight, overweight, or obese. BMI does not directly measure body fat, but research shows it correlates with more direct measurements of body fat.</p>

        <h3 class="mb-3 text-xl font-semibold">The BMI formula</h3>
        <p class="mb-2 text-black/70 dark:text-white/70"><strong>Metric:</strong> BMI = weight (kg) ÷ height (m)²</p>
        <p class="mb-6 text-black/70 dark:text-white/70"><strong>Imperial:</strong> BMI = 703 × weight (lb) ÷ height (in)²</p>

        <h3 class="mb-3 text-xl font-semibold">How to interpret your BMI result</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Below 18.5</strong> — Underweight. You may need to gain weight. Consider speaking with a doctor or dietitian.</li>
          <li><strong>18.5 – 24.9</strong> — Healthy weight. Maintain your current habits with balanced nutrition and regular exercise.</li>
          <li><strong>25.0 – 29.9</strong> — Overweight. Small changes to diet and activity can make a significant difference.</li>
          <li><strong>30.0 and above</strong> — Obese. Consult a healthcare professional for a personalised plan.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Limitations of BMI</h3>
        <p class="mb-6 text-black/70 dark:text-white/70">BMI does not account for muscle mass, bone density, age, or fat distribution. Athletes may have a high BMI due to muscle, not fat. For a more complete picture, use BMI alongside our <a href="/calculator/bodyfat" class="text-blue-600 dark:text-blue-400 hover:underline">Body Fat calculator</a> and <a href="/calculator/idealweight" class="text-blue-600 dark:text-blue-400 hover:underline">Ideal Weight calculator</a>.</p>

        <h3 class="mb-3 text-xl font-semibold">What to do after calculating your BMI</h3>
        <p class="text-black/70 dark:text-white/70">Use your BMI result as a starting point, not a final verdict. Pair it with your <a href="/calculator/tdee" class="text-blue-600 dark:text-blue-400 hover:underline">TDEE</a> to understand your calorie needs, and your <a href="/calculator/macros" class="text-blue-600 dark:text-blue-400 hover:underline">Macro split</a> to plan your nutrition.</p>
      </section>
    )}

    {slug === 'bmr' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is BMR?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Your Basal Metabolic Rate (BMR) is the number of calories your body burns while completely at rest — just to keep your heart beating, lungs breathing, and organs functioning. It is the minimum energy your body needs to survive.</p>

        <h3 class="mb-3 text-xl font-semibold">The formula used (Mifflin-St Jeor)</h3>
        <p class="mb-2 text-black/70 dark:text-white/70"><strong>Men:</strong> BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) + 5</p>
        <p class="mb-6 text-black/70 dark:text-white/70"><strong>Women:</strong> BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) − 161</p>
        <p class="mb-6 text-black/70 dark:text-white/70">This is the most accurate BMR formula validated by clinical research for the general population.</p>

        <h3 class="mb-3 text-xl font-semibold">How to use your BMR</h3>
        <p class="mb-6 text-black/70 dark:text-white/70">BMR on its own only tells you what you burn doing nothing. To find the calories you actually need each day, you must factor in your activity level — that is your <a href="/calculator/tdee" class="text-blue-600 dark:text-blue-400 hover:underline">TDEE (Total Daily Energy Expenditure)</a>. Your BMR is the foundation of your TDEE calculation.</p>

        <h3 class="mb-3 text-xl font-semibold">BMR vs TDEE — what is the difference?</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>BMR</strong> = calories burned at complete rest (no movement at all)</li>
          <li><strong>TDEE</strong> = BMR × activity multiplier (accounts for your daily movement and exercise)</li>
        </ul>
        <p class="text-black/70 dark:text-white/70">Always use TDEE for calorie planning, not BMR alone.</p>
      </section>
    )}

    {slug === 'tdee' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is TDEE?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Total Daily Energy Expenditure (TDEE) is the total number of calories you burn in a full day, including exercise, daily movement, and basic body functions. It is the most important number for any calorie-based fitness goal.</p>

        <h3 class="mb-3 text-xl font-semibold">How TDEE is calculated</h3>
        <p class="mb-3 text-black/70 dark:text-white/70">TDEE = BMR × Activity Multiplier</p>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Sedentary (desk job, little exercise):</strong> BMR × 1.2</li>
          <li><strong>Lightly active (1–3 days/week exercise):</strong> BMR × 1.375</li>
          <li><strong>Moderately active (3–5 days/week):</strong> BMR × 1.55</li>
          <li><strong>Very active (6–7 days/week hard exercise):</strong> BMR × 1.725</li>
          <li><strong>Extra active (physical job + hard training):</strong> BMR × 1.9</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">How to use your TDEE result</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>To lose weight:</strong> Eat 300–500 calories below your TDEE per day. This creates a safe deficit for 0.5–1 lb loss per week.</li>
          <li><strong>To maintain weight:</strong> Eat at your TDEE.</li>
          <li><strong>To gain muscle:</strong> Eat 250–500 calories above your TDEE with adequate protein.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Next steps after finding your TDEE</h3>
        <p class="text-black/70 dark:text-white/70">Use your TDEE to set your calorie target in the <a href="/calculator/calories" class="text-blue-600 dark:text-blue-400 hover:underline">Calorie calculator</a>, then use the <a href="/calculator/macros" class="text-blue-600 dark:text-blue-400 hover:underline">Macro calculator</a> to split those calories into protein, carbs, and fat.</p>
      </section>
    )}

    {slug === 'bodyfat' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is body fat percentage?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Body fat percentage is the proportion of your total body weight that is fat mass, as opposed to lean mass (muscle, bone, organs, water). It is a more accurate measure of fitness than weight or BMI alone.</p>

        <h3 class="mb-3 text-xl font-semibold">Healthy body fat ranges</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Essential fat (men):</strong> 2–5% | <strong>Essential fat (women):</strong> 10–13%</li>
          <li><strong>Athletes (men):</strong> 6–13% | <strong>Athletes (women):</strong> 14–20%</li>
          <li><strong>Fitness (men):</strong> 14–17% | <strong>Fitness (women):</strong> 21–24%</li>
          <li><strong>Acceptable (men):</strong> 18–24% | <strong>Acceptable (women):</strong> 25–31%</li>
          <li><strong>Obese (men):</strong> 25%+ | <strong>Obese (women):</strong> 32%+</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Method used in this calculator</h3>
        <p class="mb-6 text-black/70 dark:text-white/70">This calculator uses the <strong>US Navy circumference method</strong> (measurements of neck, waist, and hips) and the <strong>BMI-based estimation formula</strong>. For the most accurate result, use a DEXA scan or hydrostatic weighing at a medical facility.</p>

        <h3 class="mb-3 text-xl font-semibold">What to do next</h3>
        <p class="text-black/70 dark:text-white/70">Pair your body fat result with your <a href="/calculator/leanmass" class="text-blue-600 dark:text-blue-400 hover:underline">Lean Body Mass calculator</a> to understand exactly how much muscle you carry, and use your <a href="/calculator/tdee" class="text-blue-600 dark:text-blue-400 hover:underline">TDEE</a> to plan calorie targets around your composition goals.</p>
      </section>
    )}

    {slug === 'idealweight' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is ideal weight?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Ideal weight is an estimated healthy weight range for your height and frame. There is no single "correct" ideal weight — different medical formulas give different results, which is why this calculator shows all five and lets you see the range.</p>

        <h3 class="mb-3 text-xl font-semibold">The 5 formulas used</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Devine formula (1974):</strong> The most commonly used in clinical medicine and pharmacy for drug dosing.</li>
          <li><strong>Robinson formula (1983):</strong> A revision of Devine, considered slightly more accurate for women.</li>
          <li><strong>Miller formula (1983):</strong> Gives lower estimates, often used as a conservative baseline.</li>
          <li><strong>Hamwi formula (1964):</strong> The oldest method, still used widely in dietetics.</li>
          <li><strong>BMI-based range:</strong> The healthy BMI range (18.5–24.9) back-calculated to your height.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">How to use your result</h3>
        <p class="text-black/70 dark:text-white/70">Look at the range across all formulas, not a single number. Your healthiest weight sits somewhere within that range depending on your muscle mass and bone density. Use this alongside your <a href="/calculator/bmi" class="text-blue-600 dark:text-blue-400 hover:underline">BMI</a> and <a href="/calculator/bodyfat" class="text-blue-600 dark:text-blue-400 hover:underline">Body Fat</a> results for a complete picture.</p>
      </section>
    )}

    {slug === 'calories' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">How many calories should I eat per day?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Your daily calorie target depends on your Total Daily Energy Expenditure (TDEE) and your specific goal. There is no universal number — it changes based on your body, activity, and goal.</p>

        <h3 class="mb-3 text-xl font-semibold">Calorie targets by goal</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Weight loss:</strong> TDEE minus 300–500 calories/day. Produces 0.5–1 lb of fat loss per week safely.</li>
          <li><strong>Aggressive weight loss:</strong> TDEE minus 500–750 calories/day. Do not go below 1,200 calories (women) or 1,500 calories (men) without medical supervision.</li>
          <li><strong>Maintenance:</strong> Eat at your TDEE.</li>
          <li><strong>Muscle gain (lean bulk):</strong> TDEE plus 200–300 calories/day with high protein intake.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Why calorie quality matters too</h3>
        <p class="mb-6 text-black/70 dark:text-white/70">Hitting your calorie number is only half the equation. Use the <a href="/calculator/macros" class="text-blue-600 dark:text-blue-400 hover:underline">Macro calculator</a> to ensure your calories come from the right balance of protein, carbohydrates, and fat for your goal.</p>

        <h3 class="mb-3 text-xl font-semibold">How often should I recalculate?</h3>
        <p class="text-black/70 dark:text-white/70">Recalculate your calorie target every 4–6 weeks, or whenever your weight changes by more than 5 lbs, your activity level changes, or you switch goals. Your TDEE changes as your body changes.</p>
      </section>
    )}

    {slug === 'macros' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What are macros?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Macronutrients (macros) are the three categories of nutrients that provide calories: protein, carbohydrates, and fat. Every food you eat is made up of some combination of these three. Tracking macros is more precise than tracking calories alone because it ensures your body gets the right nutrients for your specific goal.</p>

        <h3 class="mb-3 text-xl font-semibold">Standard macro splits by goal</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Weight loss:</strong> 40% protein / 30% carbs / 30% fat — higher protein preserves muscle while in a deficit.</li>
          <li><strong>Muscle gain:</strong> 30% protein / 50% carbs / 20% fat — carbs fuel training and recovery.</li>
          <li><strong>Maintenance / balanced:</strong> 30% protein / 40% carbs / 30% fat.</li>
          <li><strong>Keto / low-carb:</strong> 25–30% protein / 5–10% carbs / 60–70% fat.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Calorie values per gram</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Protein:</strong> 4 calories per gram</li>
          <li><strong>Carbohydrates:</strong> 4 calories per gram</li>
          <li><strong>Fat:</strong> 9 calories per gram</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">What to do with your macro numbers</h3>
        <p class="text-black/70 dark:text-white/70">Your macro result tells you exactly how many grams of protein, carbs, and fat to target each day. Use a food tracking approach to hit these targets. If you have not calculated your calorie target yet, start with the <a href="/calculator/tdee" class="text-blue-600 dark:text-blue-400 hover:underline">TDEE calculator</a> first.</p>
      </section>
    )}

    {slug === 'water' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">How much water should I drink per day?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Daily water needs vary significantly by body weight, activity level, climate, and diet. The common "8 glasses a day" rule is not based on individual physiology. Your personal hydration target depends on your specific situation.</p>

        <h3 class="mb-3 text-xl font-semibold">General guidelines</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Baseline:</strong> Approximately 35 ml of water per kg of body weight per day.</li>
          <li><strong>Add for exercise:</strong> 500–1,000 ml extra for every hour of moderate-to-intense exercise.</li>
          <li><strong>Add for hot climate:</strong> 500–1,000 ml extra on hot or humid days.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Signs you are not drinking enough</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li>Dark yellow urine (target pale yellow)</li>
          <li>Fatigue or headaches mid-day</li>
          <li>Reduced exercise performance</li>
          <li>Feeling hungry when you may actually be thirsty</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Water from food</h3>
        <p class="text-black/70 dark:text-white/70">Approximately 20% of your daily water intake typically comes from food (fruits, vegetables, soups). This calculator gives your total water target from all sources.</p>
      </section>
    )}

    {slug === 'heartrate' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is target heart rate?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Your target heart rate (THR) is the heart rate range you should aim for during exercise to achieve a specific training effect. Different zones produce different results — fat burning, cardiovascular fitness, or peak performance.</p>

        <h3 class="mb-3 text-xl font-semibold">Heart rate training zones</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Zone 1 — Warm up (50–60% max HR):</strong> Very light effort. Good for recovery days and warm-up.</li>
          <li><strong>Zone 2 — Fat burn (60–70% max HR):</strong> Moderate effort. The most efficient zone for burning fat as fuel. Best for long, steady-state cardio.</li>
          <li><strong>Zone 3 — Aerobic (70–80% max HR):</strong> Improves cardiovascular endurance. Comfortable but challenging.</li>
          <li><strong>Zone 4 — Anaerobic (80–90% max HR):</strong> Hard effort. Builds speed and fitness. Not sustainable for long periods.</li>
          <li><strong>Zone 5 — Max effort (90–100% max HR):</strong> Maximum intensity. Used in short bursts only. Develops peak athletic performance.</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Maximum heart rate formula used</h3>
        <p class="mb-6 text-black/70 dark:text-white/70">This calculator uses the <strong>Tanaka formula</strong>: Max HR = 208 − (0.7 × age). This is more accurate than the older "220 − age" formula, particularly for adults over 40.</p>

        <h3 class="mb-3 text-xl font-semibold">How to monitor your heart rate during exercise</h3>
        <p class="text-black/70 dark:text-white/70">A heart rate monitor or fitness watch gives the most accurate real-time readings. Use your zones to structure workouts — spend more time in Zone 2 for fat loss and aerobic base building, and use Zone 4–5 intervals sparingly for fitness gains.</p>
      </section>
    )}

    {slug === 'leanmass' && (
      <section class="calculator-info mt-12 max-w-4xl">
        <h2 class="mb-4 text-2xl font-bold">What is lean body mass?</h2>
        <p class="mb-6 text-black/70 dark:text-white/70">Lean Body Mass (LBM) is the weight of everything in your body except fat — including muscle, bone, water, organs, and connective tissue. It is the part of your body that is metabolically active and burns calories.</p>

        <h3 class="mb-3 text-xl font-semibold">Formulas used</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li><strong>Boer formula:</strong> Men: LBM = (0.407 × weight kg) + (0.267 × height cm) − 19.2 | Women: LBM = (0.252 × weight kg) + (0.473 × height cm) − 48.3</li>
          <li><strong>James formula:</strong> Men: LBM = 1.1 × weight − 128 × (weight/height)² | Women: LBM = 1.07 × weight − 148 × (weight/height)²</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Why lean body mass matters</h3>
        <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
          <li>Higher lean mass = higher BMR = more calories burned at rest</li>
          <li>Preserving lean mass during weight loss is critical — crash diets lose muscle, not just fat</li>
          <li>Tracking LBM over time shows whether your training is building muscle or losing it</li>
        </ul>

        <h3 class="mb-3 text-xl font-semibold">Next steps</h3>
        <p class="text-black/70 dark:text-white/70">Combine your LBM with your <a href="/calculator/bodyfat" class="text-blue-600 dark:text-blue-400 hover:underline">Body Fat percentage</a> to get a complete picture of your body composition. Use a high-protein diet (1.6–2.2g protein per kg of bodyweight) to preserve and build lean mass.</p>
      </section>
    )}
  </div>
</Layout>
