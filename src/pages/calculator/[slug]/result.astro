  function renderInsights(result, calculatorSlug, inputData) {
    const insights = generateInsights(calculatorSlug, result, inputData);
    const insightsGrid = document.getElementById('insights-grid')!;
    insightsGrid.innerHTML = insights.map((insight, i) => `
      <div class="insight-card rounded-lg border border-black/10 bg-gray-50 p-6 dark:border-white/10 dark:bg-[#111]" style="animation-delay: ${i * 100}ms">
        <div class="mb-3 text-3xl">${insight.icon}</div>
        <h4 class="mb-2 font-semibold">${insight.label}</h4>
        <p class="text-sm text-black/60 dark:text-white/60">${insight.text}</p>
      </div>
    `).join('');
  }

  function renderActionPlan(result, calculatorSlug, inputData) {
    const actions = generateActionPlan(calculatorSlug, result, inputData);
    const actionPlan = document.getElementById('action-plan')!;
    actionPlan.innerHTML = actions.map((action, i) => `
      <div class="action-card flex gap-4 rounded-lg border border-black/10 bg-gray-50 p-4 dark:border-white/10 dark:bg-[#111]" style="animation-delay: ${i * 100}ms">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-black/10 font-semibold dark:bg-white/10">${i + 1}</div>
        <div>
          <h4 class="mb-1 font-semibold">${action.icon} ${action.title}</h4>
          <p class="text-sm text-black/60 dark:text-white/60">${action.description}</p>
        </div>
      </div>
    `).join('');
  }

  function renderRelatedCalcs(calculatorSlug) {
    const related = getRelatedCalculators(calculatorSlug);
    const relatedCalcs = document.getElementById('related-calcs')!;
    relatedCalcs.innerHTML = related.map(slug => {
      const calc = calculatorRegistry[slug];
      return `
        <a href="/calculator/${slug}" class="block rounded-lg border border-black/10 bg-gray-50 p-6 transition-colors hover:border-[#0070f3] dark:border-white/10 dark:bg-[#111]">
          <div class="mb-3 text-3xl">${calc.icon}</div>
          <h4 class="mb-1 font-semibold">${calc.label}</h4>
          <p class="text-sm text-black/60 dark:text-white/60">${calc.description}</p>
        </a>
      `;
    }).join('');
  }

  function generateInsights(slug, result, input) {
    if (slug === 'bmi') {
      const bmr = Math.round((10 * input.weight) + (6.25 * input.height) - (5 * input.age) + (input.gender === 'male' ? 5 : -161));
      const idealWeight = 22 * Math.pow(input.height / 100, 2);
      const diff = Math.abs(input.weight - idealWeight);
      return [
        { icon: '⚡', label: 'Metabolism', text: `Your BMR suggests you burn ${bmr} calories at rest daily` },
        { icon: '🎯', label: 'Your goal', text: `To reach ideal weight, adjust by ${Math.round(diff)}kg over 12–16 weeks` },
        { icon: '💧', label: 'Daily target', text: `Drink ${Math.round(input.weight * 0.035)}L of water. Stay hydrated for optimal metabolism` }
      ];
    } else if (slug === 'tdee') {
      const protein = Math.round(input.weight * 2);
      return [
        { icon: '🔥', label: 'Daily burn', text: `You burn ${result.value} calories per day with your activity level` },
        { icon: '🥩', label: 'Protein target', text: `Aim for ${protein}g protein daily to support your activity` },
        { icon: '📊', label: 'Adjustment', text: `Subtract 500 for weight loss, add 300 for muscle gain` }
      ];
    } else if (slug === 'calories') {
      return [
        { icon: '🎯', label: 'Your target', text: `${result.value} calories per day to reach your goal` },
        { icon: '⏱', label: 'Timeline', text: `Expect ~0.5kg change per week at this rate` },
        { icon: '🍽', label: 'Meal planning', text: `Split into 3–4 meals of 400–600 calories each` }
      ];
    } else if (slug === 'macros') {
      return [
        { icon: '🥩', label: 'Protein', text: `${result.breakdown.protein}g daily — 4 calories per gram` },
        { icon: '🥑', label: 'Fat', text: `${result.breakdown.fat}g daily — essential for hormones` },
        { icon: '🍚', label: 'Carbs', text: `${result.breakdown.carbs}g daily — fuel for workouts` }
      ];
    } else if (slug === 'sleep') {
      const isBedtime = input.sleepMode === 'bedtime';
      const timeTarget = result.value;
      const formattedTime = formatToAmPm(timeTarget);
      return [
        { icon: '⏰', label: 'Optimal Time', text: `Aim to ${isBedtime ? 'sleep' : 'wake up'} at ${formattedTime} to complete 5 full sleep cycles` },
        { icon: '🌀', label: 'Sleep Cycle', text: 'Each cycle is ~90 minutes. Waking up mid-cycle causes that groggy feeling' },
        { icon: '💤', label: 'Wind Down', text: 'Start your bedtime routine 30–45 minutes before sleep time to lower heart rate' }
      ];
    } else if (slug === 'pace') {
      const paceVal = result.value;
      const category = result.category;
      return [
        { icon: '🏃‍♂️', label: 'Runner Level', text: `Your pace of ${paceVal} ranks you as an ${category} level runner.` },
        { icon: '📈', label: 'Race Ready', text: 'Use Riegel\'s predicted times as your starting goal targets for races.' },
        { icon: '🫁', label: 'Aerobic Base', text: 'To improve your pace, run 80% of your miles at a slower, conversational effort.' }
      ];
    }
    return [
      { icon: '📊', label: 'Your result', text: result.advice || 'See breakdown above' },
      { icon: '🎯', label: 'Next steps', text: 'Track this metric weekly to monitor progress' },
      { icon: '💪', label: 'Stay consistent', text: 'Small daily actions compound into big results' }
    ];
  }

  function generateActionPlan(slug, result, input) {
    if (slug === 'bmi' || slug === 'calories') {
      const calories = slug === 'calories' ? result.value : Math.round((10 * input.weight) + (6.25 * input.height) - (5 * input.age)) * 1.5 - 500;
      const protein = Math.round(input.weight * 2);
      const water = Math.round(input.weight * 0.035 * 10) / 10;
      return [
        { icon: '🍽', title: `Eat ${calories} calories/day`, description: 'A moderate deficit is safe and sustainable' },
        { icon: '🥩', title: `Hit ${protein}g protein`, description: 'Preserves muscle while losing fat' },
        { icon: '🚶', title: 'Walk 8,000 steps', description: 'Burns ~300 extra calories, lowest injury risk' },
        { icon: '💧', title: `Drink ${water}L water`, description: 'Boosts metabolism by up to 30% for 1 hour' },
        { icon: '😴', title: 'Sleep 7–9 hours', description: 'Poor sleep raises cortisol, causes fat storage' }
      ];
    } else if (slug === 'sleep') {
      const isBedtime = input.sleepMode === 'bedtime';
      const bestTime = formatToAmPm(result.value);
      return [
        { icon: '🔔', title: `${isBedtime ? 'Bedtime alarm' : 'Wake up target'} at ${bestTime}`, description: `Set a reminder to ${isBedtime ? 'wind down and prepare for sleep' : 'wake up'} at this exact time` },
        { icon: '📱', title: 'No screens 1 hour before', description: 'Blue light suppresses melatonin, delaying your sleep latency' },
        { icon: '☕', title: 'Cut caffeine by 2 PM', description: 'Caffeine has a half-life of 6 hours, disrupting deep sleep phases' },
        { icon: '🌡️', title: 'Cool bedroom (18°C / 65°F)', description: 'A cooler room temperature mimics the body\'s natural temperature drop during sleep' },
        { icon: '🧘', title: '14-min sleep buffer', description: 'Go to bed 15 minutes before your target sleep time to allow your mind to settle' }
      ];
    } else if (slug === 'pace') {
      return [
        { icon: '🚦', title: '80/20 Rule training', description: 'Keep 80% of weekly runs easy (conversational pace) and only 20% hard (tempo/intervals) to build endurance.' },
        { icon: '⏱️', title: 'Practice pacing consistency', description: 'Focus on running even splits (same pace for every km) rather than starting too fast and burning out.' },
        { icon: '👟', title: 'Add a long run weekly', description: 'Gradually increase your longest run distance by 10% each week to build metabolic efficiency.' },
        { icon: '💪', title: 'Strength train twice a week', description: 'Focus on squats, lunges, and calf raises to build running economy and prevent injuries.' },
        { icon: '💤', title: 'Prioritize recovery', description: 'Your muscles grow stronger during rest. Ensure you get 7-9 hours of sleep and adequate protein.' }
      ];
    } else if (slug === 'macros') {
      return [
        { icon: '🥩', title: `${result.breakdown.protein}g protein`, description: 'Spread across 4 meals for optimal absorption' },
        { icon: '🥑', title: `${result.breakdown.fat}g fat`, description: 'Prioritize unsaturated fats from nuts, fish, olive oil' },
        { icon: '🍚', title: `${result.breakdown.carbs}g carbs`, description: 'Time around workouts for best performance' },
        { icon: '📱', title: 'Track in MyFitnessPal', description: 'Log food for 2 weeks to build awareness' },
        { icon: '⚖️', title: 'Weigh weekly', description: 'Same time, same conditions — track trends not daily fluctuations' }
      ];
    } else if (slug === 'water') {
      return [
        { icon: '💧', title: `Drink ${result.value}L daily`, description: 'About 8–10 cups spread throughout the day' },
        { icon: '🏃', title: 'Add 500ml per workout', description: 'Replace fluids lost through sweat' },
        { icon: '⏰', title: 'Drink on a schedule', description: 'Set hourly reminders until it becomes habit' },
        { icon: '🥤', title: 'Start meals with water', description: 'Helps with portion control and digestion' },
        { icon: '🚰', title: 'Carry a bottle', description: 'Visual reminder and easy access encourages consistency' }
      ];
    }
    return [
      { icon: '📊', title: 'Track this metric', description: 'Measure weekly to monitor progress' },
      { icon: '🎯', title: 'Set a goal', description: 'Use this baseline to set realistic targets' },
      { icon: '💪', title: 'Stay consistent', description: 'Small daily actions compound into big results' }
    ];
  }

  function getRelatedCalculators(slug) {
    const relationships = {
      bmi: ['bodyfat', 'calories', 'idealweight'],
      bmr: ['tdee', 'calories', 'macros'],
      tdee: ['calories', 'macros', 'water'],
      bodyfat: ['bmi', 'leanmass', 'idealweight'],
      calories: ['macros', 'tdee', 'water'],
      macros: ['calories', 'tdee', 'water'],
      water: ['tdee', 'macros', 'heartrate'],
      heartrate: ['tdee', 'water', 'bmr'],
      leanmass: ['bodyfat', 'bmi', 'macros'],
      idealweight: ['bmi', 'bodyfat', 'calories']
    };
    return relationships[slug] || ['bmi', 'tdee', 'calories'];
  }

  function renderNextSteps(slug) {
    const nextCalcs = getRelatedCalculators(slug).slice(0, 2);
    const nextStepsContainer = document.getElementById('next-steps')!;
    nextStepsContainer.innerHTML = nextCalcs.map(calcSlug => {
      const calc = calculatorRegistry[calcSlug];
      return `
        <a href="/calculator/${calcSlug}" class="flex-1 rounded-lg border border-black/10 bg-white py-4 px-4 text-center transition-colors hover:bg-black/5 dark:border-white/10 dark:bg-white/5 dark:hover:bg-white/10">
          <div class="mb-2 text-2xl">${calc.icon}</div>
          <div class="text-sm font-semibold">→ ${calc.label}</div>
        </a>
      `;
    }).join('');
  }

  function formatToAmPm(timeStr) {
    if (!timeStr) return '';
    const [hStr, mStr] = timeStr.split(':');
    let h = parseInt(hStr);
    const m = parseInt(mStr);
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12;
    h = h ? h : 12;
    const mFormatted = m.toString().padStart(2, '0');
    return `${h}:${mFormatted} ${ampm}`;
  }
</script>

