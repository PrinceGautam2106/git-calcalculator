---
import Layout from '../../../layouts/Layout.astro';
import ResultsDashboard from '../../../components/charts/ResultsDashboard.astro';
import { calculatorRegistry } from '../../../utils/calculators';

export function getStaticPaths() {
  return Object.keys(calculatorRegistry).map(slug => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;

if (!slug || !(slug in calculatorRegistry)) {
  return Astro.redirect('/404');
}

const calc = calculatorRegistry[slug as keyof typeof calculatorRegistry];

// Calculate result server-side for SSR
let result, inputData;
if (typeof window === 'undefined') {
  // Server-side: pass empty props, will hydrate client-side
  result = { value: '0', unit: '', advice: '' };
  inputData = {};
} else {
  // This won't run, but TypeScript needs it
  result = { value: '0', unit: '' };
  inputData = {};
}
---

<Layout title={`Result — ${calc.label}`}>
  <div class="mx-auto max-w-5xl px-6 py-12">

    <a href={`/calculator/${slug}`} class="mb-6 inline-flex items-center gap-2 text-sm text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white">
      ← Recalculate
    </a>

    <div class="mb-8 flex items-center gap-4">
      <div class="text-6xl">{calc.icon}</div>
      <div>
        <h1 class="text-3xl font-bold">{calc.label}</h1>
        <p class="text-black/60 dark:text-white/60">Your personalized results</p>
      </div>
    </div>

    <div id="dashboard-root"></div>

    <div class="mt-8 flex gap-4">
      <button id="save-result" class="flex-1 rounded-lg border border-black/10 bg-black py-3 font-semibold text-white transition-all hover:opacity-90 dark:border-white/10 dark:bg-white dark:text-black">
        💾 Save to history
      </button>
      <a href="/" class="flex-1 rounded-lg border border-black/10 py-3 text-center font-semibold transition-colors hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5">
        ← Back to home
      </a>
    </div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js" defer></script>

<script>
  import { calculatorRegistry } from '../../../utils/calculators';
  import { recordCheckIn } from '../../../utils/localStorage';

  const slug = window.location.pathname.split('/')[2];
  const calc = calculatorRegistry[slug];
  const inputData = JSON.parse(localStorage.getItem(`fc_calc_${slug}`) || '{}');
  const result = calc.fn(inputData);

  // Record check-in and show confetti/milestone
  const streakResult = recordCheckIn();
  if (streakResult.milestone && streakResult.message) {
    setTimeout(() => {
      // @ts-ignore
      if (window.confetti) {
        // @ts-ignore
        confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
      }
      // @ts-ignore
      window.showNotification(streakResult.message, 'milestone');
    }, 500);
  }

  // Render dashboard client-side
  renderDashboard(result, slug, inputData);

  // Listen for theme changes to update chart
  window.addEventListener('themeChanged', () => {
    renderChart(result, slug);
  });

  // Auto-save to history
  saveToHistory();

  function saveToHistory() {
    const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
    const newEntry = {
      calculator: calc.label,
      slug,
      value: result.value,
      unit: result.unit,
      date: new Date().toLocaleDateString(),
      timestamp: Date.now()
    };

    // Check if duplicate (same calculator and same value today)
    const isDuplicate = history.length > 0 && 
      history[0].slug === slug && 
      history[0].value === result.value && 
      history[0].date === newEntry.date;

    if (!isDuplicate) {
      history.unshift(newEntry);
      localStorage.setItem('fc_history', JSON.stringify(history.slice(0, 50)));

      const lastResults = history.slice(0, 3).map(h => ({
        calculator: h.calculator,
        value: `${h.value} ${h.unit}`,
        date: h.date
      }));
      localStorage.setItem('fc_last_results', JSON.stringify(lastResults));
    }
  }

  // Manual save button (optional now, but keeps feedback)
  document.getElementById('save-result')!.onclick = () => {
    // @ts-ignore
    window.showNotification('Result is automatically saved to your history');
  };

  function renderDashboard(result, calculatorSlug, inputData) {
    const root = document.getElementById('dashboard-root');

    root!.innerHTML = `
      <div class="space-y-8">
        <!-- SECTION 1: Hero Metric -->
        <div class="rounded-lg border border-black/10 bg-gray-50 p-8 text-center dark:border-white/10 dark:bg-[#111]">
          <div class="mb-4">
            <span id="hero-number" class="font-mono text-6xl font-bold" data-target="${result.value}">0</span>
            <span class="ml-2 text-2xl text-black/60 dark:text-white/60">${result.unit}</span>
          </div>
          ${result.category ? `
            <div class="mb-4">
              <span class="inline-block rounded-full px-4 py-1.5 text-sm font-medium" style="background: ${result.color}20; color: ${result.color}">
                ${result.category}
              </span>
            </div>
          ` : ''}
          ${result.advice ? `<p class="text-lg text-black/80 dark:text-white/80">${result.advice}</p>` : ''}
        </div>

        <!-- SECTION 2: Visual Chart -->
        <div class="rounded-lg border border-black/10 bg-gray-50 p-8 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-6 text-xl font-semibold">Visual breakdown</h3>
          <div class="mx-auto max-w-2xl">
            <canvas id="result-chart"></canvas>
          </div>
        </div>

        <!-- SECTION 3: Insights -->
        <div>
          <h3 class="mb-4 text-xl font-semibold">What this means for you</h3>
          <div id="insights-grid" class="grid gap-4 md:grid-cols-3"></div>
        </div>

        <!-- SECTION 4: Action Plan -->
        <div>
          <h3 class="mb-4 text-xl font-semibold">Your personalized action plan</h3>
          <div id="action-plan" class="space-y-3"></div>
        </div>

        <!-- SECTION 5: Related Calculators -->
        <div>
          <h3 class="mb-4 text-xl font-semibold">You might also want to check...</h3>
          <div id="related-calcs" class="grid gap-4 md:grid-cols-3"></div>
        </div>
      </div>
    `;

    animateHeroNumber();
    renderChart(result, calculatorSlug);
    renderInsights(result, calculatorSlug, inputData);
    renderActionPlan(result, calculatorSlug, inputData);
    renderRelatedCalcs(calculatorSlug);
  }

  function animateHeroNumber() {
    const heroNumber = document.getElementById('hero-number')!;
    const target = heroNumber.dataset.target!;
    const isRange = target.includes('–') || target.includes('/');

    if (!isRange && !isNaN(parseFloat(target))) {
      const finalValue = parseFloat(target);
      const duration = 600;
      const steps = 30;
      const increment = finalValue / steps;
      let current = 0;

      const timer = setInterval(() => {
        current += increment;
        if (current >= finalValue) {
          heroNumber.textContent = target;
          clearInterval(timer);
        } else {
          heroNumber.textContent = (Math.round(current * 10) / 10).toString();
        }
      }, duration / steps);
    } else {
      heroNumber.textContent = target;
    }
  }

  async function renderChart(result, calculatorSlug) {
    // Load Chart.js dynamically
    if (!window.Chart) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js';
      document.head.appendChild(script);
      await new Promise(resolve => script.onload = resolve);
    }

    const ctx = document.getElementById('result-chart').getContext('2d');
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? 'rgba(255, 255, 255, 0.6)' : 'rgba(0, 0, 0, 0.6)';
    const gridColor = isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
    const emptyColor = isDark ? '#333' : '#eee';

    let chartConfig = {
      options: {
        responsive: true,
        plugins: {
          legend: {
            labels: { color: textColor }
          }
        },
        scales: {
          x: {
            ticks: { color: textColor },
            grid: { color: gridColor }
          },
          y: {
            ticks: { color: textColor },
            grid: { color: gridColor }
          }
        }
      }
    };

    if (calculatorSlug === 'bmi') {
      const bmi = parseFloat(result.value);
      Object.assign(chartConfig, {
        type: 'bar',
        data: {
          labels: ['Underweight', 'Normal', 'Overweight', 'Obese'],
          datasets: [{
            label: 'Your BMI',
            data: [
              bmi < 18.5 ? bmi : 0,
              bmi >= 18.5 && bmi < 25 ? bmi : 0,
              bmi >= 25 && bmi < 30 ? bmi : 0,
              bmi >= 30 ? bmi : 0
            ],
            backgroundColor: ['#0070f3', '#50e3c2', '#f5a623', '#ff6b6b']
          }]
        },
        options: {
          ...chartConfig.options,
          indexAxis: 'y',
          scales: { 
            x: { ...chartConfig.options.scales.x, max: 40 },
            y: chartConfig.options.scales.y
          },
          plugins: { ...chartConfig.options.plugins, legend: { display: false } }
        }
      });
    } else if (calculatorSlug === 'bodyfat') {
      const bf = parseFloat(result.value);
      Object.assign(chartConfig, {
        type: 'doughnut',
        data: {
          labels: ['Body Fat', 'Lean Mass'],
          datasets: [{
            data: [bf, 100 - bf],
            backgroundColor: [result.color, emptyColor],
            borderWidth: 0
          }]
        },
        options: {
          ...chartConfig.options,
          cutout: '70%',
          scales: {} // Remove scales for doughnut
        }
      });
    } else if (calculatorSlug === 'macros' && result.breakdown) {
      Object.assign(chartConfig, {
        type: 'bar',
        data: {
          labels: ['Macros'],
          datasets: [
            { label: 'Protein', data: [result.breakdown.protein], backgroundColor: '#50e3c2' },
            { label: 'Fat', data: [result.breakdown.fat], backgroundColor: '#f5a623' },
            { label: 'Carbs', data: [result.breakdown.carbs], backgroundColor: '#0070f3' }
          ]
        },
        options: {
          ...chartConfig.options,
          indexAxis: 'y',
          scales: { 
            x: { ...chartConfig.options.scales.x, stacked: true }, 
            y: { ...chartConfig.options.scales.y, stacked: true } 
          }
        }
      });
    } else if (result.breakdown) {
      const labels = Object.keys(result.breakdown);
      const values = Object.values(result.breakdown).map(v => parseFloat(v) || 0);
      Object.assign(chartConfig, {
        type: 'bar',
        data: {
          labels: labels.map(l => l.replace(/([A-Z])/g, ' $1').trim()),
          datasets: [{
            label: 'Breakdown',
            data: values,
            backgroundColor: '#50e3c2'
          }]
        },
        options: {
          ...chartConfig.options,
          plugins: { ...chartConfig.options.plugins, legend: { display: false } }
        }
      });
    }

    if (chartConfig.type) {
      new Chart(ctx, chartConfig);
    }
  }

  function renderInsights(result, calculatorSlug, inputData) {
    const insights = generateInsights(calculatorSlug, result, inputData);
    const insightsGrid = document.getElementById('insights-grid')!;
    insightsGrid.innerHTML = insights.map((insight, i) => `
      <div class="insight-card rounded-lg border border-black/10 bg-gray-50 p-6 dark:border-white/10 dark:bg-[#111]" style="animation-delay: ${i * 100}ms">
        <div class="mb-3 text-3xl">${insight.icon}</div>
        <h4 class="mb-2 font-semibold">${insight.label}</h4>
        <p class="text-sm text-black/60 dark:text-white/60">${insight.text}</p>
      </div>
    `).join('');
  }

  function renderActionPlan(result, calculatorSlug, inputData) {
    const actions = generateActionPlan(calculatorSlug, result, inputData);
    const actionPlan = document.getElementById('action-plan')!;
    actionPlan.innerHTML = actions.map((action, i) => `
      <div class="action-card flex gap-4 rounded-lg border border-black/10 bg-gray-50 p-4 dark:border-white/10 dark:bg-[#111]" style="animation-delay: ${i * 100}ms">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-black/10 font-semibold dark:bg-white/10">${i + 1}</div>
        <div>
          <h4 class="mb-1 font-semibold">${action.icon} ${action.title}</h4>
          <p class="text-sm text-black/60 dark:text-white/60">${action.description}</p>
        </div>
      </div>
    `).join('');
  }

  function renderRelatedCalcs(calculatorSlug) {
    const related = getRelatedCalculators(calculatorSlug);
    const relatedCalcs = document.getElementById('related-calcs')!;
    relatedCalcs.innerHTML = related.map(slug => {
      const calc = calculatorRegistry[slug];
      return `
        <a href="/calculator/${slug}" class="block rounded-lg border border-black/10 bg-gray-50 p-6 transition-colors hover:border-[#0070f3] dark:border-white/10 dark:bg-[#111]">
          <div class="mb-3 text-3xl">${calc.icon}</div>
          <h4 class="mb-1 font-semibold">${calc.label}</h4>
          <p class="text-sm text-black/60 dark:text-white/60">${calc.description}</p>
        </a>
      `;
    }).join('');
  }

  function generateInsights(slug, result, input) {
    if (slug === 'bmi') {
      const bmr = Math.round((10 * input.weight) + (6.25 * input.height) - (5 * input.age) + (input.gender === 'male' ? 5 : -161));
      const idealWeight = 22 * Math.pow(input.height / 100, 2);
      const diff = Math.abs(input.weight - idealWeight);
      return [
        { icon: '⚡', label: 'Metabolism', text: `Your BMR suggests you burn ${bmr} calories at rest daily` },
        { icon: '🎯', label: 'Your goal', text: `To reach ideal weight, adjust by ${Math.round(diff)}kg over 12–16 weeks` },
        { icon: '💧', label: 'Daily target', text: `Drink ${Math.round(input.weight * 0.035)}L of water. Stay hydrated for optimal metabolism` }
      ];
    } else if (slug === 'tdee') {
      const protein = Math.round(input.weight * 2);
      return [
        { icon: '🔥', label: 'Daily burn', text: `You burn ${result.value} calories per day with your activity level` },
        { icon: '🥩', label: 'Protein target', text: `Aim for ${protein}g protein daily to support your activity` },
        { icon: '📊', label: 'Adjustment', text: `Subtract 500 for weight loss, add 300 for muscle gain` }
      ];
    } else if (slug === 'calories') {
      return [
        { icon: '🎯', label: 'Your target', text: `${result.value} calories per day to reach your goal` },
        { icon: '⏱', label: 'Timeline', text: `Expect ~0.5kg change per week at this rate` },
        { icon: '🍽', label: 'Meal planning', text: `Split into 3–4 meals of 400–600 calories each` }
      ];
    } else if (slug === 'macros') {
      return [
        { icon: '🥩', label: 'Protein', text: `${result.breakdown.protein}g daily — 4 calories per gram` },
        { icon: '🥑', label: 'Fat', text: `${result.breakdown.fat}g daily — essential for hormones` },
        { icon: '🍚', label: 'Carbs', text: `${result.breakdown.carbs}g daily — fuel for workouts` }
      ];
    }
    return [
      { icon: '📊', label: 'Your result', text: result.advice || 'See breakdown above' },
      { icon: '🎯', label: 'Next steps', text: 'Track this metric weekly to monitor progress' },
      { icon: '💪', label: 'Stay consistent', text: 'Small daily actions compound into big results' }
    ];
  }

  function generateActionPlan(slug, result, input) {
    if (slug === 'bmi' || slug === 'calories') {
      const calories = slug === 'calories' ? result.value : Math.round((10 * input.weight) + (6.25 * input.height) - (5 * input.age)) * 1.5 - 500;
      const protein = Math.round(input.weight * 2);
      const water = Math.round(input.weight * 0.035 * 10) / 10;
      return [
        { icon: '🍽', title: `Eat ${calories} calories/day`, description: 'A moderate deficit is safe and sustainable' },
        { icon: '🥩', title: `Hit ${protein}g protein`, description: 'Preserves muscle while losing fat' },
        { icon: '🚶', title: 'Walk 8,000 steps', description: 'Burns ~300 extra calories, lowest injury risk' },
        { icon: '💧', title: `Drink ${water}L water`, description: 'Boosts metabolism by up to 30% for 1 hour' },
        { icon: '😴', title: 'Sleep 7–9 hours', description: 'Poor sleep raises cortisol, causes fat storage' }
      ];
    } else if (slug === 'macros') {
      return [
        { icon: '🥩', title: `${result.breakdown.protein}g protein`, description: 'Spread across 4 meals for optimal absorption' },
        { icon: '🥑', title: `${result.breakdown.fat}g fat`, description: 'Prioritize unsaturated fats from nuts, fish, olive oil' },
        { icon: '🍚', title: `${result.breakdown.carbs}g carbs`, description: 'Time around workouts for best performance' },
        { icon: '📱', title: 'Track in MyFitnessPal', description: 'Log food for 2 weeks to build awareness' },
        { icon: '⚖️', title: 'Weigh weekly', description: 'Same time, same conditions — track trends not daily fluctuations' }
      ];
    } else if (slug === 'water') {
      return [
        { icon: '💧', title: `Drink ${result.value}L daily`, description: 'About 8–10 cups spread throughout the day' },
        { icon: '🏃', title: 'Add 500ml per workout', description: 'Replace fluids lost through sweat' },
        { icon: '⏰', title: 'Drink on a schedule', description: 'Set hourly reminders until it becomes habit' },
        { icon: '🥤', title: 'Start meals with water', description: 'Helps with portion control and digestion' },
        { icon: '🚰', title: 'Carry a bottle', description: 'Visual reminder and easy access encourages consistency' }
      ];
    }
    return [
      { icon: '📊', title: 'Track this metric', description: 'Measure weekly to monitor progress' },
      { icon: '🎯', title: 'Set a goal', description: 'Use this baseline to set realistic targets' },
      { icon: '💪', title: 'Stay consistent', description: 'Small daily actions compound into big results' }
    ];
  }

  function getRelatedCalculators(slug) {
    const relationships = {
      bmi: ['bodyfat', 'calories', 'idealweight'],
      bmr: ['tdee', 'calories', 'macros'],
      tdee: ['calories', 'macros', 'water'],
      bodyfat: ['bmi', 'leanmass', 'idealweight'],
      calories: ['macros', 'tdee', 'water'],
      macros: ['calories', 'tdee', 'water'],
      water: ['tdee', 'macros', 'heartrate'],
      heartrate: ['tdee', 'water', 'bmr'],
      leanmass: ['bodyfat', 'bmi', 'macros'],
      idealweight: ['bmi', 'bodyfat', 'calories']
    };
    return relationships[slug] || ['bmi', 'tdee', 'calories'];
  }
</script>

<style>
  .insight-card, .action-card {
    opacity: 0;
    animation: fade-slide-in 400ms ease forwards;
  }

  @keyframes fade-slide-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  canvas {
    max-height: 300px;
  }
</style>
