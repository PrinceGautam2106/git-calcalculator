---
export const prerender = true;

import Layout from '../../../layouts/Layout.astro';
import ResultsDashboard from '../../../components/charts/ResultsDashboard.astro';
import { calculatorRegistry } from '../../../utils/calculators';

export function getStaticPaths() {
  return Object.keys(calculatorRegistry).map(slug => ({
    params: { slug }
  }));
}

const { slug } = Astro.params;

if (!slug || !(slug in calculatorRegistry)) {
  return Astro.redirect('/404');
}

const calc = calculatorRegistry[slug as keyof typeof calculatorRegistry];

// Calculate result server-side for SSR
let result, inputData;
if (typeof window === 'undefined') {
  // Server-side: pass empty props, will hydrate client-side
  result = { value: '0', unit: '', advice: '' };
  inputData = {};
} else {
  // This won't run, but TypeScript needs it
  result = { value: '0', unit: '' };
  inputData = {};
}
---

<Layout title={`Result — ${calc.label}`}>
  <div class="mx-auto max-w-5xl px-6 py-12">

    <a href={`/calculator/${slug}`} class="mb-6 inline-flex items-center gap-2 text-sm text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white">
      ← Recalculate
    </a>

    <div class="mb-8 flex items-center gap-4">
      <div class="text-6xl">{calc.icon}</div>
      <div>
        <h1 class="text-3xl font-bold">{calc.label}</h1>
        <p class="text-black/60 dark:text-white/60">Your personalized results</p>
      </div>
    </div>

    <div id="dashboard-root"></div>

    <div class="mt-8 flex gap-4">
      <button id="save-result" class="flex-1 rounded-lg border border-black/10 bg-black py-3 font-semibold text-white transition-all hover:opacity-90 dark:border-white/10 dark:bg-white dark:text-black">
        💾 Save to history
      </button>
      <a href="/" class="flex-1 rounded-lg border border-black/10 py-3 text-center font-semibold transition-colors hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5">
        ← Back to home
      </a>
    </div>
  </div>
</Layout>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js" defer></script>

<style>
  @media (max-width: 480px) {
    #bmr-visual-breakdown > div[style*="grid-template-columns: 1fr 1fr 1fr"] {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script>
  import { calculatorRegistry } from '../../../utils/calculators';
  import { recordCheckIn } from '../../../utils/localStorage';

  const slug = window.location.pathname.split('/')[2];
  const calc = calculatorRegistry[slug];
  const inputData = JSON.parse(localStorage.getItem(`fc_calc_${slug}`) || '{}');
  const result = calc.fn(inputData);

  // Record check-in and show confetti/milestone
  const streakResult = recordCheckIn();
  if (streakResult.milestone && streakResult.message) {
    setTimeout(() => {
      // @ts-ignore
      if (window.confetti) {
        // @ts-ignore
        confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });
      }
      // @ts-ignore
      window.showNotification(streakResult.message, 'milestone');
    }, 500);
  }

  // Render dashboard client-side
  renderDashboard(result, slug, inputData);

  // Listen for theme changes to update chart
  window.addEventListener('themeChanged', () => {
    renderChart(result, slug);
  });

  // Auto-save to history
  saveToHistory();

  function saveToHistory() {
    const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
    const newEntry = {
      calculator: calc.label,
      slug,
      value: result.value,
      unit: result.unit,
      date: new Date().toLocaleDateString(),
      timestamp: Date.now()
    };

    // Check if duplicate (same calculator and same value today)
    const isDuplicate = history.length > 0 && 
      history[0].slug === slug && 
      history[0].value === result.value && 
      history[0].date === newEntry.date;

    if (!isDuplicate) {
      history.unshift(newEntry);
      localStorage.setItem('fc_history', JSON.stringify(history.slice(0, 50)));

      const lastResults = history.slice(0, 3).map(h => ({
        calculator: h.calculator,
        value: `${h.value} ${h.unit}`,
        date: h.date
      }));
      localStorage.setItem('fc_last_results', JSON.stringify(lastResults));
    }
  }

  // Manual save button (optional now, but keeps feedback)
  document.getElementById('save-result')!.onclick = () => {
    // @ts-ignore
    window.showNotification('Result is automatically saved to your history');
  };

  function renderDashboard(result, calculatorSlug, inputData) {
    const root = document.getElementById('dashboard-root');

    root!.innerHTML = `
      <div class="space-y-8">
        <!-- SECTION 1: Hero Metric -->
        <div class="rounded-lg border border-black/10 bg-gray-50 p-8 text-center dark:border-white/10 dark:bg-[#111]">
          <div class="mb-4">
            <span id="hero-number" class="font-mono text-6xl font-bold" data-target="${result.value}">0</span>
            <span class="ml-2 text-2xl text-black/60 dark:text-white/60">${result.unit}</span>
          </div>
          ${result.category ? `
            <div class="mb-4">
              <span class="inline-block rounded-full px-4 py-1.5 text-sm font-medium" style="background: ${result.color}20; color: ${result.color}">
                ${result.category}
              </span>
            </div>
          ` : ''}
          ${result.advice ? `<p class="text-lg text-black/80 dark:text-white/80">${result.advice}</p>` : ''}
        </div>

        <!-- SECTION 1.5: Result Breakdown Details -->
        <div id="breakdown-details-container"></div>

        <!-- SECTION 2: Visual Chart -->
        <div id="chart-container" class="rounded-lg border border-black/10 bg-gray-50 p-8 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-6 text-xl font-semibold">Visual breakdown</h3>
          <div class="mx-auto max-w-2xl">
            <canvas id="result-chart"></canvas>
          </div>
        </div>

        <!-- SECTION 3: Insights -->
        <div>
          <h3 class="mb-4 text-xl font-semibold">What this means for you</h3>
          <div id="insights-grid" class="grid gap-4 md:grid-cols-3"></div>
        </div>

        <!-- SECTION 4: Action Plan -->
        <div>
          <h3 class="mb-4 text-xl font-semibold">Your personalized action plan</h3>
          <div id="action-plan" class="space-y-3"></div>
        </div>

        <!-- SECTION 5: Related Calculators -->
        <div>
          <h3 class="mb-4 text-xl font-semibold">You might also want to check...</h3>
          <div id="related-calcs" class="grid gap-4 md:grid-cols-3"></div>
        </div>

        <!-- SECTION 6: Next Steps -->
        <div class="rounded-lg border border-black/10 bg-gray-50 p-8 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-4 text-xl font-semibold">What to calculate next</h3>
          <div id="next-steps" class="flex flex-col gap-3 sm:flex-row sm:gap-4"></div>
        </div>
      </div>
    `;

    animateHeroNumber();
    renderChart(result, calculatorSlug);
    renderBreakdownDetails(result, calculatorSlug, inputData);
    renderInsights(result, calculatorSlug, inputData);
    renderActionPlan(result, calculatorSlug, inputData);
    renderRelatedCalcs(calculatorSlug);
    renderNextSteps(calculatorSlug);
  }

  function animateHeroNumber() {
    const heroNumber = document.getElementById('hero-number')!;
    const target = heroNumber.dataset.target!;
    const isRange = target.includes('–') || target.includes('/');

    if (!isRange && !isNaN(parseFloat(target))) {
      const finalValue = parseFloat(target);
      const duration = 600;
      const steps = 30;
      const increment = finalValue / steps;
      let current = 0;

      const timer = setInterval(() => {
        current += increment;
        if (current >= finalValue) {
          heroNumber.textContent = target;
          clearInterval(timer);
        } else {
          heroNumber.textContent = (Math.round(current * 10) / 10).toString();
        }
      }, duration / steps);
    } else {
      heroNumber.textContent = target;
    }
  }

  async function renderChart(result, calculatorSlug) {
    const container = document.getElementById('chart-container');
    const noChartSlugs = ['sleep', 'pace', 'deficit', 'heartrate', 'armybf', 'protein'];
    if (noChartSlugs.includes(calculatorSlug)) {
      if (container) container.style.display = 'none';
      return;
    } else {
      if (container) container.style.display = 'block';
    }

    // Load Chart.js dynamically
    if (!window.Chart) {
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js';
      document.head.appendChild(script);
      await new Promise(resolve => script.onload = resolve);
    }

    const ctx = document.getElementById('result-chart').getContext('2d');
    const isDark = document.documentElement.classList.contains('dark');
    const textColor = isDark ? 'rgba(255, 255, 255, 0.6)' : 'rgba(0, 0, 0, 0.6)';
    const gridColor = isDark ? 'rgba(255, 255, 255, 0.1)' : 'rgba(0, 0, 0, 0.1)';
    const emptyColor = isDark ? '#333' : '#eee';

    let chartConfig = {
      options: {
        responsive: true,
        plugins: {
          legend: {
            labels: { color: textColor }
          }
        },
        scales: {
          x: {
            ticks: { color: textColor },
            grid: { color: gridColor }
          },
          y: {
            ticks: { color: textColor },
            grid: { color: gridColor }
          }
        }
      }
    };

    if (calculatorSlug === 'bmi') {
      const bmi = parseFloat(result.value);
      Object.assign(chartConfig, {
        type: 'bar',
        data: {
          labels: ['Underweight', 'Normal', 'Overweight', 'Obese'],
          datasets: [{
            label: 'Your BMI',
            data: [
              bmi < 18.5 ? bmi : 0,
              bmi >= 18.5 && bmi < 25 ? bmi : 0,
              bmi >= 25 && bmi < 30 ? bmi : 0,
              bmi >= 30 ? bmi : 0
            ],
            backgroundColor: ['#0070f3', '#50e3c2', '#f5a623', '#ff6b6b']
          }]
        },
        options: {
          ...chartConfig.options,
          indexAxis: 'y',
          scales: { 
            x: { ...chartConfig.options.scales.x, max: 40 },
            y: chartConfig.options.scales.y
          },
          plugins: { ...chartConfig.options.plugins, legend: { display: false } }
        }
      });
    } else if (calculatorSlug === 'bodyfat') {
      const bf = parseFloat(result.value);
      Object.assign(chartConfig, {
        type: 'doughnut',
        data: {
          labels: ['Body Fat', 'Lean Mass'],
          datasets: [{
            data: [bf, 100 - bf],
            backgroundColor: [result.color, emptyColor],
            borderWidth: 0
          }]
        },
        options: {
          ...chartConfig.options,
          cutout: '70%',
          scales: {} // Remove scales for doughnut
        }
      });
    } else if (calculatorSlug === 'macros' && result.breakdown) {
      Object.assign(chartConfig, {
        type: 'bar',
        data: {
          labels: ['Macros'],
          datasets: [
            { label: 'Protein', data: [result.breakdown.protein], backgroundColor: '#50e3c2' },
            { label: 'Fat', data: [result.breakdown.fat], backgroundColor: '#f5a623' },
            { label: 'Carbs', data: [result.breakdown.carbs], backgroundColor: '#0070f3' }
          ]
        },
        options: {
          ...chartConfig.options,
          indexAxis: 'y',
          scales: { 
            x: { ...chartConfig.options.scales.x, stacked: true }, 
            y: { ...chartConfig.options.scales.y, stacked: true } 
          }
        }
      });
    } else if (result.breakdown) {
      const labels = Object.keys(result.breakdown);
      const values = Object.values(result.breakdown).map(v => parseFloat(v) || 0);
      Object.assign(chartConfig, {
        type: 'bar',
        data: {
          labels: labels.map(l => l.replace(/([A-Z])/g, ' $1').trim()),
          datasets: [{
            label: 'Breakdown',
            data: values,
            backgroundColor: '#50e3c2'
          }]
        },
        options: {
          ...chartConfig.options,
          plugins: { ...chartConfig.options.plugins, legend: { display: false } }
        }
      });
    }

    if (chartConfig.type) {
      new Chart(ctx, chartConfig);
    }
  }
  function renderBreakdownDetails(result, calculatorSlug, inputData) {
    const container = document.getElementById('breakdown-details-container');
    const breakdown = generateBreakdownDetails(calculatorSlug, result, inputData);
    
    if (breakdown) {
      container!.innerHTML = breakdown;
    }
  }

  function generateBreakdownDetails(slug, result, input) {
    if (slug === 'bmr') {
      const bmr = parseInt(result.value);
      const gender = input.gender;
      const safeFloor = gender === 'male' ? 1500 : 1200;
      
      return `
        <div id="bmr-visual-breakdown" style="margin-top: 1.5rem;">
          <!-- 3 context cards -->
          <p style="font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 10px;">What your BMR means in real terms</p>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 1.25rem;">
            <div style="background: var(--surface-1); border: 0.5px solid var(--border); border-radius: 10px; padding: 12px; text-align: center;">
              <div style="font-size: 20px; margin-bottom: 4px;">😴</div>
              <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 4px;">Asleep all day</div>
              <div style="font-size: 17px; font-weight: 500; color: var(--text-primary);">${Math.round(bmr * 0.95).toLocaleString()}</div>
              <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">cal burned</div>
            </div>

            <div style="background: var(--surface-1); border: 0.5px solid var(--border-strong); border-radius: 10px; padding: 12px; text-align: center;">
              <div style="font-size: 20px; margin-bottom: 4px;">🫀</div>
              <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 4px;">Your BMR</div>
              <div style="font-size: 17px; font-weight: 500; color: var(--text-primary);">${bmr.toLocaleString()}</div>
              <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">complete rest</div>
            </div>

            <div style="background: var(--surface-1); border: 0.5px solid var(--border); border-radius: 10px; padding: 12px; text-align: center;">
              <div style="font-size: 20px; margin-bottom: 4px;">🚶</div>
              <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 4px;">Light day</div>
              <div style="font-size: 17px; font-weight: 500; color: var(--text-primary);">${Math.round(bmr * 1.375).toLocaleString()}</div>
              <div style="font-size: 10px; color: var(--text-muted); margin-top: 2px;">cal (BMR × 1.375)</div>
            </div>
          </div>

          <!-- Breakdown rows -->
          <div style="border-top: 0.5px solid var(--border); padding-top: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 0.5px solid var(--border); font-size: 13px;">
              <span style="color: var(--text-secondary);">Calories burned per hour at rest</span>
              <span style="font-weight: 500; color: var(--text-primary);">${Math.round(bmr / 24)} cal/hr</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 0.5px solid var(--border); font-size: 13px;">
              <span style="color: var(--text-secondary);">Calories burned during 8 hrs sleep</span>
              <span style="font-weight: 500; color: var(--text-primary);">${Math.round((bmr / 24) * 8)} cal</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 0.5px solid var(--border); font-size: 13px;">
              <span style="color: var(--text-secondary);">Never eat below (safe floor)</span>
              <span style="font-weight: 500; color: var(--text-primary);">${safeFloor.toLocaleString()} cal</span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 7px 0; font-size: 13px;">
              <span style="color: var(--text-secondary);">Formula used</span>
              <span style="font-weight: 500; color: var(--text-primary);">Mifflin-St Jeor</span>
            </div>
          </div>

          <!-- Dynamic interpretation -->
          <div style="background: var(--surface-1); border: 0.5px solid var(--border); border-radius: 8px; padding: 10px 14px; margin-top: 1rem; font-size: 13px; color: var(--text-secondary); line-height: 1.6;">
            ${bmr < 1400 
              ? `Your BMR of ${bmr.toLocaleString()} cal is on the lower end. This is completely normal for a smaller body frame or lighter weight. The most important rule: never eat below your BMR — doing so forces your body to burn muscle tissue for fuel.`
              : bmr < 1800 
              ? `Your BMR of ${bmr.toLocaleString()} cal is in the average range for adults. Your actual daily needs are higher once activity is factored in — calculate your TDEE next to find the real number to use for any calorie goal.`
              : bmr < 2200
              ? `Your BMR of ${bmr.toLocaleString()} cal is above average. Your body burns a significant amount of energy just to exist. This gives you more flexibility when setting calorie targets for weight loss or muscle gain.`
              : `Your BMR of ${bmr.toLocaleString()} cal is high — your body is a significant calorie burner at rest. This is typical for taller, heavier, or younger individuals. Use your TDEE to get the full daily burn number including your activity.`
            }
          </div>

          <!-- Next calculator links -->
          <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 1rem; padding-top: 1rem; border-top: 0.5px solid var(--border);">
            <span style="font-size: 12px; color: var(--text-muted);">Calculate next →</span>
            <a href="/calculator/tdee" style="font-size: 13px; padding: 5px 12px; border-radius: 99px; border: 0.5px solid var(--border); color: var(--text-secondary); text-decoration: none; background: var(--surface-1);">⚡ TDEE</a>
            <a href="/calculator/calories" style="font-size: 13px; padding: 5px 12px; border-radius: 99px; border: 0.5px solid var(--border); color: var(--text-secondary); text-decoration: none; background: var(--surface-1);">🍎 Calories</a>
          </div>
        </div>
      `;
    } else if (slug === 'water') {
      const waterL = parseFloat(result.value);
      const cups = Math.round(waterL * 4.227);
      return `
        <div class="rounded-lg border border-black/10 bg-gray-50 p-6 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-4 text-lg font-semibold">Breakdown</h3>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Daily water intake</p>
              <p class="text-2xl font-bold text-[#50e3c2]">${waterL}L</p>
            </div>
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Approximately</p>
              <p class="text-2xl font-bold">${cups} cups</p>
            </div>
          </div>
          <p class="mt-4 text-sm text-black/60 dark:text-white/60">${result.advice}</p>
        </div>
      `;
    } else if (slug === 'leanmass') {
      const lbm = parseInt(result.value);
      const fatMass = input.weight - lbm;
      const bodyFatPercent = (fatMass / input.weight * 100).toFixed(1);
      return `
        <div class="rounded-lg border border-black/10 bg-gray-50 p-6 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-4 text-lg font-semibold">Body Composition Breakdown</h3>
          <div class="grid gap-4 md:grid-cols-3">
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Lean Body Mass</p>
              <p class="text-2xl font-bold text-[#50e3c2]">${lbm}kg</p>
            </div>
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Fat Mass</p>
              <p class="text-2xl font-bold text-[#f5a623]">${Math.round(fatMass)}kg</p>
            </div>
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Body Fat %</p>
              <p class="text-2xl font-bold">${bodyFatPercent}%</p>
            </div>
          </div>
        </div>
      `;
    } else if (slug === 'calories') {
      const calories = parseInt(result.value);
      const weeklyChange = (calories - 2500) * 7 / 7700;
      return `
        <div class="rounded-lg border border-black/10 bg-gray-50 p-6 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-4 text-lg font-semibold">Calorie Breakdown</h3>
          <div class="grid gap-4 md:grid-cols-2">
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Daily target</p>
              <p class="text-2xl font-bold text-[#50e3c2]">${calories} kcal/day</p>
            </div>
            <div class="rounded-lg border border-black/5 p-4 dark:border-white/5">
              <p class="text-sm text-black/60 dark:text-white/60">Weekly change</p>
              <p class="text-2xl font-bold">${weeklyChange > 0 ? '+' : ''}${weeklyChange.toFixed(2)}kg</p>
            </div>
          </div>
          <p class="mt-4 text-sm text-black/60 dark:text-white/60">This is your personalized target based on your stats and goal.</p>
        </div>
      `;
    } else if (slug === 'idealweight') {
      const range = result.value.split('–');
      return `
        <div class="rounded-lg border border-black/10 bg-gray-50 p-6 dark:border-white/10 dark:bg-[#111]">
          <h3 class="mb-4 text-lg font-semibold">Ideal Weight Range</h3>
          <div class="rounded-lg border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#0a0a0a]">
            <p class="text-sm text-black/60 dark:text-white/60 mb-2">Your healthy weight range</p>
            <p class="text-3xl font-bold text-[#50e3c2]">${result.value} ${result.unit}</p>
            <p class="mt-3 text-xs text-black/40 dark:text-white/40">Based on 5 medical formulas (Devine, Robinson, Miller, Hamwi, BMI method)</p>
          </div>
          <p class="mt-4 text-sm text-black/60 dark:text-white/60">Your ideal weight depends on your muscle mass and bone density. Aim for somewhere within this range.</p>
        </div>
      `;
    } else if (slug === 'sleep') {
      const times = result.breakdown || {};
      const isBedtime = input.sleepMode === 'bedtime';
      const targetLabel = isBedtime ? 'Bedtimes (When to sleep)' : 'Wake Times (When to wake up)';
      
      let inputTimeStr = '';
      if (isBedtime && input.wakeTime) {
        inputTimeStr = formatToAmPm(typeof input.wakeTime === 'object' ? `${String(input.wakeTime.hours).padStart(2, '0')}:${String(input.wakeTime.minutes).padStart(2, '0')}` : input.wakeTime);
      } else if (!isBedtime && input.sleepTime) {
        inputTimeStr = formatToAmPm(typeof input.sleepTime === 'object' ? `${String(input.sleepTime.hours).padStart(2, '0')}:${String(input.sleepTime.minutes).padStart(2, '0')}` : input.sleepTime);
      }

      const list = [
        { cycles: 6, time: times['6cycles'], label: 'Excellent', duration: '9.0 hours', color: '#50e3c2', desc: 'Wake up feeling fully rested and energized.' },
        { cycles: 5, time: times['5cycles'], label: 'Optimal', duration: '7.5 hours', color: '#0070f3', desc: 'The recommended standard for healthy adults.', isRecommended: true },
        { cycles: 4, time: times['4cycles'], label: 'Sufficient', duration: '6.0 hours', color: '#f5a623', desc: 'Enough sleep to function, but slightly below ideal.' },
