    padding: 16px;
    white-space: pre;
    overflow-x: auto;
  }
  .formula-source {
    font-size: 0.6875rem;
    color: var(--color-mute);
    padding: 8px 16px;
    border-top: 1px solid var(--color-hairline);
    margin: 0;
    font-style: italic;
    line-height: 1.5;
  }
</style>
