---
import Layout from '../../layouts/Layout.astro';
import InputFlow from '../../components/calculators/InputFlow.astro';
import { calculatorRegistry } from '../../utils/calculators';

const slug = 'calories';
const calc = calculatorRegistry[slug];
---

<Layout title={`${calc.label} — FitnessCalculator`} description={calc.metaDescription || calc.description}>
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6 py-8 sm:py-12">
    <a href="/" class="mb-4 sm:mb-6 inline-flex items-center gap-2 text-xs sm:text-sm text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white">
      ← Back to home
    </a>
    
    <div class="mb-6 sm:mb-8">
      <div class="mb-3 sm:mb-4 text-4xl sm:text-5xl">{calc.icon}</div>
      <h1 class="mb-1 sm:mb-2 text-2xl sm:text-4xl font-bold">{calc.label}</h1>
      <p class="text-sm sm:text-lg text-black/60 dark:text-white/60">{calc.description}</p>
    </div>

    <InputFlow calculatorSlug={slug} requiredFields={calc.fields} />

    <section class="calculator-info mt-12 max-w-4xl">
      <h2 class="mb-4 text-2xl font-bold">How many calories should I eat per day?</h2>
      <p class="mb-6 text-black/70 dark:text-white/70">Your daily calorie target depends on your Total Daily Energy Expenditure (TDEE) and your specific goal. There is no universal number — it changes based on your body, activity, and goal.</p>

      <h3 class="mb-3 text-xl font-semibold">Calorie targets by goal</h3>
      <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
        <li><strong>Weight loss:</strong> TDEE minus 300–500 calories/day. Produces 0.5–1 lb of fat loss per week safely.</li>
        <li><strong>Aggressive weight loss:</strong> TDEE minus 500–750 calories/day. Do not go below 1,200 calories (women) or 1,500 calories (men) without medical supervision.</li>
        <li><strong>Maintenance:</strong> Eat at your TDEE.</li>
        <li><strong>Muscle gain (lean bulk):</strong> TDEE plus 200–300 calories/day with high protein intake.</li>
      </ul>

      <h3 class="mb-3 text-xl font-semibold">Why calorie quality matters too</h3>
      <p class="mb-6 text-black/70 dark:text-white/70">Hitting your calorie number is only half the equation. Use the <a href="/calculator/macros" class="text-blue-600 dark:text-blue-400 hover:underline">Macro calculator</a> to ensure your calories come from the right balance of protein, carbohydrates, and fat for your goal.</p>

      <h3 class="mb-3 text-xl font-semibold">How often should I recalculate?</h3>
      <p class="text-black/70 dark:text-white/70">Recalculate your calorie target every 4–6 weeks, or whenever your weight changes by more than 5 lbs, your activity level changes, or you switch goals. Your TDEE changes as your body changes.</p>
    </section>
  </div>
</Layout>

<script>
  // Breakdown section appears after result is calculated
  document.addEventListener('DOMContentLoaded', () => {
    const calculateBtn = document.getElementById('calculate-btn');
    if (calculateBtn) {
      calculateBtn.addEventListener('click', () => {
        setTimeout(() => {
          const breakdownSection = document.querySelector('.calculator-info');
          if (breakdownSection) {
            breakdownSection.scrollIntoView({ behavior: 'smooth' });
          }
        }, 300);
      });
    }
  });
</script>
