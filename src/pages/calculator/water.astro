---
import Layout from '../../layouts/Layout.astro';
import InputFlow from '../../components/calculators/InputFlow.astro';
import { calculatorRegistry } from '../../utils/calculators';

const slug = 'water';
const calc = calculatorRegistry[slug];
---

<Layout title={`${calc.label} — FitnessCalculator`} description={calc.metaDescription || calc.description}>
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6 py-8 sm:py-12">
    <a href="/" class="mb-4 sm:mb-6 inline-flex items-center gap-2 text-xs sm:text-sm text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white">
      ← Back to home
    </a>
    
    <div class="mb-6 sm:mb-8">
      <div class="mb-3 sm:mb-4 text-4xl sm:text-5xl">{calc.icon}</div>
      <h1 class="mb-1 sm:mb-2 text-2xl sm:text-4xl font-bold">{calc.label}</h1>
      <p class="text-sm sm:text-lg text-black/60 dark:text-white/60">{calc.description}</p>
    </div>

    <InputFlow calculatorSlug={slug} requiredFields={calc.fields} />

    <section class="calculator-info mt-12 max-w-4xl">
      <h2 class="mb-4 text-2xl font-bold">How much water should I drink per day?</h2>
      <p class="mb-6 text-black/70 dark:text-white/70">Daily water needs vary significantly by body weight, activity level, climate, and diet. The common "8 glasses a day" rule is not based on individual physiology. Your personal hydration target depends on your specific situation.</p>

      <h3 class="mb-3 text-xl font-semibold">General guidelines</h3>
      <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
        <li><strong>Baseline:</strong> Approximately 35 ml of water per kg of body weight per day.</li>
        <li><strong>Add for exercise:</strong> 500–1,000 ml extra for every hour of moderate-to-intense exercise.</li>
        <li><strong>Add for hot climate:</strong> 500–1,000 ml extra on hot or humid days.</li>
      </ul>

      <h3 class="mb-3 text-xl font-semibold">Signs you are not drinking enough</h3>
      <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
        <li>Dark yellow urine (target pale yellow)</li>
        <li>Fatigue or headaches mid-day</li>
        <li>Reduced exercise performance</li>
        <li>Feeling hungry when you may actually be thirsty</li>
      </ul>

      <h3 class="mb-3 text-xl font-semibold">Water from food</h3>
      <p class="text-black/70 dark:text-white/70">Approximately 20% of your daily water intake typically comes from food (fruits, vegetables, soups). This calculator gives your total water target from all sources.</p>
    </section>
  </div>
</Layout>

<script>
  // Breakdown section appears after result is calculated
  document.addEventListener('DOMContentLoaded', () => {
    const calculateBtn = document.getElementById('calculate-btn');
    if (calculateBtn) {
      calculateBtn.addEventListener('click', () => {
        setTimeout(() => {
          const breakdownSection = document.querySelector('.calculator-info');
          if (breakdownSection) {
            breakdownSection.scrollIntoView({ behavior: 'smooth' });
          }
        }, 300);
      });
    }
  });
</script>
