import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import HeartRateCalculator from '../../components/calculators/HeartRateCalculator.astro';

export const prerender = true;

const faqs = [
  {
    question: 'What are heart rate training zones?',
    answer: 'Heart rate training zones are percentage ranges of your maximum heart rate (MHR) or heart rate reserve (HRR) that correspond to different metabolic states and training adaptations. There are five standard zones: Zone 1 (Warm Up, 50-60%), Zone 2 (Fat Burn/Aerobic Base, 60-70%), Zone 3 (Tempo/Aerobic, 70-80%), Zone 4 (Anaerobic/Threshold, 80-90%), and Zone 5 (Peak/Sprint, 90-100%).',
  },
  {
    question: 'How does the Karvonen method calculate heart rate zones?',
    answer: 'The Karvonen method is a mathematical formula that calculates target heart rate zones by incorporating your resting heart rate (RHR). By calculating your Heart Rate Reserve (HRR = Max HR − Rest HR), it targets active training heart rates more accurately than simple max-percentage formulas, adjusting for individual cardiovascular fitness levels.',
  },
  {
    question: 'Why is Zone 2 training so popular?',
    answer: 'Zone 2 training (60–70% of HRR) is the foundation of endurance and aerobic health. Exercising in Zone 2 relies almost entirely on oxygen and fat oxidation for fuel rather than carbohydrates, building mitochondrial density and efficiency without creating excessive neural fatigue, allowing you to train longer and recover faster.',
  },
  {
    question: 'How do I find my actual resting heart rate (RHR)?',
    answer: 'For peak accuracy, measure your resting heart rate first thing in the morning, immediately after waking up and while still lying in bed. Place two fingers on your radial wrist artery or carotid neck artery, count the beats for 60 seconds, or take an average from a fitness tracker over several sleep cycles.',
  },
  {
    question: 'Does resting heart rate change with fitness?',
    answer: 'Yes. As your cardiovascular endurance improves through aerobic training, your heart muscle grows stronger and more efficient, pumping more blood per stroke (increased stroke volume). Because each pump delivers more oxygen, your heart doesn\'t need to beat as frequently, naturally lowering your resting heart rate over time.',
  },
  {
    question: 'What is a dangerous heart rate during exercise?',
    answer: 'While exercising near your maximum heart rate (Zone 5) is safe for short durations in healthy individuals, you should stop immediately if you experience dizziness, lightheadedness, chest tightness, extreme shortness of breath, or palpitations. If you have pre-existing cardiovascular conditions, always consult a cardiologist to establish safe training boundaries.',
  },
  {
    question: 'How do medications affect heart rate zones?',
    answer: 'Certain medications, particularly beta-blockers prescribed for high blood pressure or heart conditions, lower both your resting and maximum heart rate. If you are taking heart medications, standard mathematical formulas will overestimate your zones. In this case, use a Rating of Perceived Exertion (RPE) scale or consult your doctor.',
  },
  {
    question: 'How accurate is the 220 minus age formula?',
    answer: 'The classic "220 minus age" formula is a simple estimate that has a standard deviation of about ±10–12 beats per minute. This means that for a significant portion of the population, their actual maximum heart rate could be 10–15 bpm higher or lower than predicted. For more precise zones, we use the Karvonen method which adjusts for RHR.',
  },
