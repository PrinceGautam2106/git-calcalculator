---
import Layout from '../../layouts/Layout.astro';
import InputFlow from '../../components/calculators/InputFlow.astro';
import { calculatorRegistry } from '../../utils/calculators';

const slug = 'bmr';
const calc = calculatorRegistry[slug];
---

<Layout title={`${calc.label} — FitnessCalculator`} description={calc.metaDescription || calc.description}>
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6 py-8 sm:py-12">
    <a href="/" class="mb-4 sm:mb-6 inline-flex items-center gap-2 text-xs sm:text-sm text-black/60 transition-colors hover:text-black dark:text-white/60 dark:hover:text-white">
      ← Back to home
    </a>
    
    <div class="mb-6 sm:mb-8">
      <div class="mb-3 sm:mb-4 text-4xl sm:text-5xl">{calc.icon}</div>
      <h1 class="mb-1 sm:mb-2 text-2xl sm:text-4xl font-bold">{calc.label}</h1>
      <p class="text-sm sm:text-lg text-black/60 dark:text-white/60">{calc.description}</p>
    </div>

    <InputFlow calculatorSlug={slug} requiredFields={calc.fields} />

    <section class="calculator-info mt-12 max-w-4xl">
      <h2 class="mb-4 text-2xl font-bold">What is BMR?</h2>
      <p class="mb-6 text-black/70 dark:text-white/70">Your Basal Metabolic Rate (BMR) is the number of calories your body burns while completely at rest — just to keep your heart beating, lungs breathing, and organs functioning. It is the minimum energy your body needs to survive.</p>

      <h3 class="mb-3 text-xl font-semibold">The formula used (Mifflin-St Jeor)</h3>
      <p class="mb-2 text-black/70 dark:text-white/70"><strong>Men:</strong> BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) + 5</p>
      <p class="mb-6 text-black/70 dark:text-white/70"><strong>Women:</strong> BMR = (10 × weight in kg) + (6.25 × height in cm) − (5 × age) − 161</p>
      <p class="mb-6 text-black/70 dark:text-white/70">This is the most accurate BMR formula validated by clinical research for the general population.</p>

      <h3 class="mb-3 text-xl font-semibold">How to use your BMR</h3>
      <p class="mb-6 text-black/70 dark:text-white/70">BMR on its own only tells you what you burn doing nothing. To find the calories you actually need each day, you must factor in your activity level — that is your <a href="/calculator/tdee" class="text-blue-600 dark:text-blue-400 hover:underline">TDEE (Total Daily Energy Expenditure)</a>. Your BMR is the foundation of your TDEE calculation.</p>

      <h3 class="mb-3 text-xl font-semibold">BMR vs TDEE — what is the difference?</h3>
      <ul class="mb-6 space-y-2 text-black/70 dark:text-white/70">
        <li><strong>BMR</strong> = calories burned at complete rest (no movement at all)</li>
        <li><strong>TDEE</strong> = BMR × activity multiplier (accounts for your daily movement and exercise)</li>
      </ul>
      <p class="text-black/70 dark:text-white/70">Always use TDEE for calorie planning, not BMR alone.</p>
    </section>
  </div>
</Layout>

<script>
  // Breakdown section appears after result is calculated
  document.addEventListener('DOMContentLoaded', () => {
    const calculateBtn = document.getElementById('calculate-btn');
    if (calculateBtn) {
      calculateBtn.addEventListener('click', () => {
        setTimeout(() => {
          const breakdownSection = document.querySelector('.calculator-info');
          if (breakdownSection) {
            breakdownSection.scrollIntoView({ behavior: 'smooth' });
          }
        }, 300);
      });
    }
  });
</script>
