---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Calculation History — FitnessCalculator">
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6 py-8 sm:py-12">
    <div class="mb-6 sm:mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-bold text-black dark:text-white">History</h1>
          <p class="mt-2 text-sm sm:text-base text-black/60 dark:text-white/60">Your previous calculations and results</p>
        </div>
        <div class="flex gap-3">
          <button id="export-history" class="flex items-center gap-2 rounded-xl border border-black/10 dark:border-white/10 bg-[#50e3c2]/10 px-4 py-2.5 text-sm font-medium text-[#50e3c2] transition-all hover:bg-[#50e3c2] hover:text-black">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Export
          </button>
          <button id="clear-history" class="flex items-center gap-2 rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-2.5 text-sm font-medium text-red-500 transition-all hover:bg-red-500 hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            Clear All
          </button>
        </div>
      </div>
      <div id="history-stats" class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="rounded-xl bg-gray-50 dark:bg-white/5 border border-black/10 dark:border-white/10 p-4">
          <p class="text-xs text-black/40 dark:text-white/40 uppercase tracking-wider mb-1">Total</p>
          <p id="total-count" class="text-2xl font-bold text-black dark:text-white">0</p>
        </div>
        <div class="rounded-xl bg-gray-50 dark:bg-white/5 border border-black/10 dark:border-white/10 p-4">
          <p class="text-xs text-black/40 dark:text-white/40 uppercase tracking-wider mb-1">This Week</p>
          <p id="week-count" class="text-2xl font-bold text-black dark:text-white">0</p>
        </div>
        <div class="rounded-xl bg-gray-50 dark:bg-white/5 border border-black/10 dark:border-white/10 p-4">
          <p class="text-xs text-black/40 dark:text-white/40 uppercase tracking-wider mb-1">Most Used</p>
          <p id="most-used" class="text-sm font-bold text-black dark:text-white truncate">-</p>
        </div>
        <div class="rounded-xl bg-gray-50 dark:bg-white/5 border border-black/10 dark:border-white/10 p-4">
          <p class="text-xs text-black/40 dark:text-white/40 uppercase tracking-wider mb-1">Last Used</p>
          <p id="last-used" class="text-sm font-bold text-black dark:text-white truncate">-</p>
        </div>
      </div>
    </div>

    <div id="history-list" class="space-y-3 sm:space-y-4">
      <div class="animate-pulse space-y-3 sm:space-y-4">
        {[...Array(3)].map(() => (
          <div class="h-20 sm:h-24 w-full rounded-lg bg-black/5 dark:bg-white/5"></div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  function updateStats() {
    const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
    
    // Total count
    const totalEl = document.getElementById('total-count');
    if (totalEl) totalEl.textContent = history.length.toString();
    
    // This week count
    const weekAgo = new Date();
    weekAgo.setDate(weekAgo.getDate() - 7);
    const weekCount = history.filter((item: any) => new Date(item.timestamp || 0) > weekAgo).length;
    const weekEl = document.getElementById('week-count');
    if (weekEl) weekEl.textContent = weekCount.toString();
    
    // Most used calculator
    const calcCounts: Record<string, number> = {};
    history.forEach((item: any) => {
      calcCounts[item.calculator] = (calcCounts[item.calculator] || 0) + 1;
    });
    const mostUsed = Object.entries(calcCounts).sort((a, b) => b[1] - a[1])[0];
    const mostUsedEl = document.getElementById('most-used');
    if (mostUsedEl) mostUsedEl.textContent = mostUsed ? mostUsed[0] : '-';
    
    // Last used
    const lastUsedEl = document.getElementById('last-used');
    if (lastUsedEl && history.length > 0) {
      lastUsedEl.textContent = history[0].calculator;
    }
  }

  function renderHistory() {
    const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
    const container = document.getElementById('history-list');
    
    if (!container) return;

    if (history.length === 0) {
      container.innerHTML = `
        <div class="rounded-2xl border border-dashed border-black/10 dark:border-white/10 bg-gray-50/50 dark:bg-white/5 p-12 text-center">
          <div class="text-4xl mb-4">📊</div>
          <p class="text-lg font-medium text-black/60 dark:text-white/60 mb-2">No calculation history yet</p>
          <p class="text-sm text-black/40 dark:text-white/40 mb-6">Start using calculators to track your fitness journey</p>
          <a href="/calculators" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#50e3c2] text-black font-medium hover:bg-[#50e3c2]/90 transition">
            View Calculators →
          </a>
        </div>
      `;
      return;
    }

    container.innerHTML = history.map((item: any) => `
      <div class="group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4 rounded-xl border border-black/10 dark:border-white/10 bg-gray-50 dark:bg-[#111] p-4 sm:p-6 transition-all hover:border-[#50e3c2]/50 hover:shadow-lg">
        <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
          <div class="flex h-10 sm:h-12 w-10 sm:w-12 items-center justify-center rounded-full bg-black/5 dark:bg-white/5 text-xl sm:text-2xl flex-shrink-0 group-hover:bg-[#50e3c2]/10 transition-colors">
            ${getIcon(item.slug)}
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-sm sm:text-base text-black dark:text-white truncate">${item.calculator}</h3>
            <p class="text-xs sm:text-sm text-black/40 dark:text-white/40">${item.date}</p>
          </div>
        </div>
        <div class="flex items-center justify-between sm:justify-end gap-4">
          <div class="sm:text-right">
            <div class="font-mono text-lg sm:text-2xl font-bold text-black dark:text-white"><span>${item.value}</span> <span class="text-xs sm:text-sm font-normal text-black/40 dark:text-white/40">${item.unit || ''}</span></div>
          </div>
          <a href="/calculator/${item.slug}" class="flex-shrink-0 text-xs text-[#50e3c2] hover:text-black dark:hover:text-white transition font-medium">
            Recalculate →
          </a>
        </div>
      </div>
    `).join('');
  }

  function getIcon(slug: string) {
    const icons: Record<string, string> = {
      bmi: '⚖️',
      bmr: '🔥',
      tdee: '⚡',
      bodyfat: '📊',
      idealweight: '🎯',
      calories: '🍎',
      macros: '🥗',
      water: '💧',
      heartrate: '❤️',
      leanmass: '💪'
    };
    return icons[slug] || '📊';
  }

  // Export functionality
  const exportBtn = document.getElementById('export-history');
  if (exportBtn) {
    exportBtn.addEventListener('click', () => {
      const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
      if (history.length === 0) {
        alert('No history to export');
        return;
      }
      
      const dataStr = JSON.stringify(history, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `fitness-history-${new Date().toISOString().split('T')[0]}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      
      // Show feedback
      const btn = exportBtn as HTMLButtonElement;
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg> Exported!';
      btn.classList.add('bg-[#50e3c2]', 'text-black');
      setTimeout(() => {
        btn.innerHTML = originalHTML;
        btn.classList.remove('bg-[#50e3c2]', 'text-black');
      }, 2000);
    });
  }

  // Clear functionality
  const clearBtn = document.getElementById('clear-history');
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
      if (history.length === 0) {
        alert('No history to clear');
        return;
      }
      
      if (confirm(`⚠️ Are you sure you want to delete ${history.length} calculation${history.length > 1 ? 's' : ''}?\n\nThis action cannot be undone.`)) {
        localStorage.removeItem('fc_history');
        localStorage.removeItem('fc_last_results');
        updateStats();
        renderHistory();
        
        // Show notification
        const notification = document.createElement('div');
        notification.className = 'fixed bottom-4 right-4 bg-black dark:bg-white text-white dark:text-black px-6 py-3 rounded-xl font-medium shadow-lg z-50 animate-fade-in';
        notification.textContent = '✓ History cleared';
        document.body.appendChild(notification);
        setTimeout(() => notification.remove(), 2000);
      }
    });
  }

  updateStats();
  renderHistory();
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }
</style>
