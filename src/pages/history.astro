---
import Layout from '../layouts/Layout.astro';

---

<Layout title="Calculation History — FitnessCalculator">
  <div class="mx-auto max-w-7xl px-3 sm:px-4 md:px-6 py-8 sm:py-12">
    <div class="mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4">
      <div>
        <h1 class="text-3xl sm:text-4xl font-bold text-black dark:text-white">History</h1>
        <p class="mt-2 text-sm sm:text-base text-black/60 dark:text-white/60">Your previous calculations and results</p>
      </div>
      <button id="clear-history" class="rounded-lg border border-black/10 px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium transition-colors hover:bg-black/5 dark:border-white/10 dark:hover:bg-white/5 flex-shrink-0">
        Clear all
      </button>
    </div>

    <div id="history-list" class="space-y-3 sm:space-y-4">
      <div class="animate-pulse space-y-3 sm:space-y-4">
        {[...Array(3)].map(() => (
          <div class="h-20 sm:h-24 w-full rounded-lg bg-black/5 dark:bg-white/5"></div>
        ))}
      </div>
    </div>
  </div>
</Layout>

<script>
  function renderHistory() {
    const history = JSON.parse(localStorage.getItem('fc_history') || '[]');
    const container = document.getElementById('history-list');
    
    if (!container) return;

    if (history.length === 0) {
      container.innerHTML = `
        <div class="rounded-lg border border-dashed border-black/10 dark:border-white/10 p-12 text-center">
          <p class="text-black/40 dark:text-white/40">No history found yet. Try using one of our calculators!</p>
          <a href="/" class="mt-4 inline-block text-[#0070f3] hover:underline">View all calculators</a>
        </div>
      `;
      return;
    }

    container.innerHTML = history.map((item: any) => `
      <div class="group flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-4 rounded-lg border border-black/10 dark:border-white/10 bg-gray-50 dark:bg-[#111] p-4 sm:p-6 transition-colors hover:border-black/20 dark:hover:border-white/20">
        <div class="flex items-center gap-3 sm:gap-4 min-w-0">
          <div class="flex h-10 sm:h-12 w-10 sm:w-12 items-center justify-center rounded-full bg-black/5 dark:bg-white/5 text-xl sm:text-2xl flex-shrink-0">
            ${getIcon(item.slug)}
          </div>
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-sm sm:text-base text-black dark:text-white truncate">${item.calculator}</h3>
            <p class="text-xs sm:text-sm text-black/40 dark:text-white/40">${item.date}</p>
          </div>
        </div>
        <div class="sm:text-right">
          <div class="font-mono text-lg sm:text-2xl font-bold text-black dark:text-white break-words"><span>${item.value}</span> <span class="text-xs sm:text-sm font-normal text-black/40 dark:text-white/40">${item.unit}</span></div>
          <a href="/calculator/${item.slug}" class="text-xs text-[#0070f3] opacity-0 transition-opacity group-hover:opacity-100">Recalculate →</a>
        </div>
      </div>
    `).join('');
  }

  function getIcon(slug: string) {
    const icons: Record<string, string> = {
      bmi: '⚖️',
      bmr: '🔥',
      tdee: '⚡',
      bodyfat: '📊',
      idealweight: '🎯',
      calories: '🍎',
      macros: '🥗',
      water: '💧',
      heartrate: '❤️',
      leanmass: '💪'
    };
    return icons[slug] || '📊';
  }

  const clearBtn = document.getElementById('clear-history');
  if (clearBtn) {
    clearBtn.onclick = () => {
      if (confirm('Are you sure you want to clear all history?')) {
        localStorage.removeItem('fc_history');
        localStorage.removeItem('fc_last_results');
        renderHistory();
      }
    };
  }

  renderHistory();
</script>
