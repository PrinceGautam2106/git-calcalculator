---
/**
 * /history — Local History Dashboard
 * 100% private, on-device calculations logs viewer.
 * Uses client-side JS to load, filter, export, and manage localStorage data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaScript from '../components/seo/SchemaScript.astro';
import { generateTitle, generateDescription, generateCanonical } from '../utils/seo';

const TITLE     = generateTitle('Your Private History Dashboard');
const DESC      = generateDescription('Manage your locally saved health and fitness calculation logs. 100% private, on-device data storage.');
const CANONICAL = generateCanonical('/history');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: TITLE,
  description: DESC,
  url: CANONICAL,
};
---

<BaseLayout
  title={TITLE}
  description={DESC}
  canonical={CANONICAL}
>
  <SchemaScript slot="head" schema={schema} />

  <div class="container-site py-16 sm:py-24">

    <!-- Header -->
    <header class="mb-10 sm:mb-12">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <p class="text-label text-[var(--color-primary)] mb-2">Device Sandbox</p>
          <h1 class="text-display-md text-[var(--color-ink)] mb-3">Your Calculation History</h1>
          <p class="text-body-sm text-[var(--color-body)] max-w-2xl leading-relaxed">
            All records below are stored strictly on this device inside your browser's local sandbox.
            No data is ever uploaded to a server, keeping your health journey 100% private.
          </p>
        </div>
        <!-- Actions button box -->
        <div class="flex items-center gap-2 shrink-0 self-start sm:self-center" id="dashboard-actions">
          <button id="history-export-btn" class="dash-btn border-btn" type="button">
            📥 Export Data
          </button>
          <button id="history-clear-btn" class="dash-btn danger-btn" type="button">
            🗑️ Clear All
          </button>
        </div>
      </div>
    </header>

    <!-- Filters bar -->
    <div class="filter-panel mb-8" id="filter-panel">
      <div class="filter-input-wrap">
        <label for="history-filter" class="filter-label">Filter by Tool</label>
        <select id="history-filter" class="filter-select">
          <option value="all">All Calculations</option>
          <option value="TDEE">TDEE</option>
          <option value="BMI">BMI</option>
          <option value="Body Fat">Body Fat</option>
          <option value="1 Rep Max">1 Rep Max</option>
          <option value="Sleep Cycles">Sleep Cycles</option>
          <option value="Sleep Debt">Sleep Debt</option>
          <option value="Calorie Deficit">Calorie Deficit</option>
        </select>
      </div>
    </div>

    <!-- History Table -->
    <div class="table-wrapper border border-[var(--color-hairline)] rounded-sm" id="table-wrapper">
      <table class="history-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Calculator</th>
            <th>Result Value</th>
            <th>Parameters / Context</th>
            <th class="text-right">Action</th>
          </tr>
        </thead>
        <tbody id="history-tbody">
          <!-- Injected dynamically by Client JS -->
        </tbody>
      </table>
    </div>

    <!-- Empty State -->
    <div id="history-empty" class="empty-state hidden" role="status">
      <div class="empty-icon" aria-hidden="true">📊</div>
      <h2 class="empty-title">No calculation history found</h2>
      <p class="empty-desc">
        Your history log is empty. Save your results when using any of our tools to view and track your progress here.
      </p>
      <a href="/calculators" class="browse-btn">
        Browse Calculators →
      </a>
    </div>

  </div>
</BaseLayout>

<style>
/* Buttons styling */
.dash-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 16px;
  height: 36px;
  font-size: 0.8125rem;
  font-weight: 600;
  border-radius: 4px;
  cursor: pointer;
  transition: all 150ms ease;
}
.border-btn {
  background-color: transparent;
  border: 1px solid var(--color-hairline);
  color: var(--color-body);
}
.border-btn:hover {
  background-color: var(--color-canvas-soft);
  border-color: var(--color-border-strong);
  color: var(--color-ink);
}
.danger-btn {
  background-color: transparent;
  border: 1px solid color-mix(in srgb, var(--color-error) 35%, transparent);
  color: var(--color-error);
}
.danger-btn:hover {
  background-color: var(--color-error-muted);
  border-color: var(--color-error);
}

/* Filters */
.filter-panel {
  display: flex;
  justify-content: flex-start;
  border-bottom: 1px solid var(--color-hairline);
  padding-bottom: 16px;
}
.filter-input-wrap {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
  max-width: 240px;
}
.filter-label {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--color-mute);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.filter-select {
  height: 36px;
  padding-inline: 10px;
  font-size: 0.875rem;
  font-weight: 500;
  color: var(--color-ink);
  background-color: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  outline: none;
}
.filter-select:focus {
  border-color: var(--color-primary);
}

/* Table wrapper */
.table-wrapper {
  overflow-x: auto;
  background-color: var(--color-canvas);
}

.history-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
}
.history-table th,
.history-table td {
  padding: 12px 16px;
  text-align: left;
  border-bottom: 1px solid var(--color-hairline);
}
.history-table th {
  background-color: var(--color-canvas-soft);
  color: var(--color-mute);
  font-weight: 600;
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.history-table tr:last-child td {
  border-bottom: none;
}
.history-table tr:hover td {
  background-color: var(--color-canvas-soft);
}

.result-badge {
  display: inline-block;
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--color-primary);
  background-color: var(--color-primary-soft);
  padding: 2px 8px;
  border-radius: 4px;
}
.delete-row-btn {
  background: transparent;
  border: none;
  color: var(--color-mute);
  font-size: 0.8125rem;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 4px;
  transition: all 150ms ease;
}
.delete-row-btn:hover {
  background-color: var(--color-error-muted);
  color: var(--color-error);
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 64px 24px;
  border: 1px dashed var(--color-hairline);
  border-radius: 4px;
}
.empty-icon {
  font-size: 3rem;
  margin-bottom: 16px;
}
.empty-title {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 8px;
}
.empty-desc {
  font-size: 0.875rem;
  color: var(--color-body);
  max-width: 400px;
  margin-inline: auto;
  margin-bottom: 20px;
  line-height: 1.5;
}
.browse-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  height: 38px;
  background-color: var(--color-ink);
  color: var(--color-canvas);
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: 4px;
  text-decoration: none;
  transition: background-color 150ms ease;
}
.browse-btn:hover {
  background-color: var(--color-primary);
}

.text-right { text-align: right !important; }
.hidden { display: none !important; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tbody       = document.getElementById('history-tbody') as HTMLTableSectionElement;
    const emptyState  = document.getElementById('history-empty') as HTMLDivElement;
    const tableWrapper = document.getElementById('table-wrapper') as HTMLDivElement;
    const filterSelect = document.getElementById('history-filter') as HTMLSelectElement;
    const actionsPanel = document.getElementById('dashboard-actions') as HTMLDivElement;
    const filterPanel  = document.getElementById('filter-panel') as HTMLDivElement;

    const clearAllBtn  = document.getElementById('history-clear-btn') as HTMLButtonElement;
    const exportBtn    = document.getElementById('history-export-btn') as HTMLButtonElement;

    interface HistoryRecord {
      calculator: string;
      value: string;
      unit: string;
      category: string;
      date: string;
      timestamp: number;
      inputs?: Record<string, any>;
    }

    let records: HistoryRecord[] = [];

    // Load records from local storage
    function loadHistory() {
      try {
        records = JSON.parse(localStorage.getItem('fc_history') || '[]');
      } catch (_) {
        records = [];
      }
      render(filterSelect.value);
    }

    // Render table rows
    function render(filterValue: string) {
      // Filter records
      const filtered = filterValue === 'all'
        ? records
        : records.filter(r => r.calculator.toLowerCase() === filterValue.toLowerCase());

      if (records.length === 0) {
        // Entirely empty
        emptyState.classList.remove('hidden');
        tableWrapper.classList.add('hidden');
        actionsPanel.classList.add('hidden');
        filterPanel.classList.add('hidden');
        return;
      }

      emptyState.classList.add('hidden');
      tableWrapper.classList.remove('hidden');
      actionsPanel.classList.remove('hidden');
      filterPanel.classList.remove('hidden');

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; color: var(--color-mute); padding: 32px 16px;">
              No saved calculations found matching this filter.
            </td>
          </tr>
        `;
        return;
      }

      let html = '';
      filtered.forEach(record => {
        html += `
          <tr data-timestamp="${record.timestamp}">
            <td class="font-mono text-xs text-[var(--color-mute)]">${record.date}</td>
            <td class="font-semibold text-[var(--color-ink)]">${record.calculator}</td>
            <td><span class="result-badge">${record.value}</span></td>
            <td class="text-xs text-[var(--color-body)]">${record.category}</td>
            <td class="text-right">
              <button class="delete-row-btn" data-timestamp="${record.timestamp}" type="button" aria-label="Delete record">
                Delete
              </button>
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;

      // Add row delete listeners
      tbody.querySelectorAll('.delete-row-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const btnEl = e.currentTarget as HTMLButtonElement;
          const timestamp = parseInt(btnEl.getAttribute('data-timestamp') || '0', 10);
          deleteRecord(timestamp);
        });
      });
    }

    // Delete single record
    function deleteRecord(timestamp: number) {
      if (confirm('Are you sure you want to delete this calculation record?')) {
        records = records.filter(r => r.timestamp !== timestamp);
        localStorage.setItem('fc_history', JSON.stringify(records));
        render(filterSelect.value);
      }
    }

    // Clear all history
    clearAllBtn.addEventListener('click', () => {
      if (confirm('⚠️ WARNING: This will permanently delete all saved calculations from this device. This action cannot be undone. Proceed?')) {
        localStorage.removeItem('fc_history');
        localStorage.removeItem('fc_last_results');
        records = [];
        render('all');
      }
    });

    // Export history to JSON file
    exportBtn.addEventListener('click', () => {
      if (records.length === 0) return;
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(records, null, 2));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `calai_fitness_history_${new Date().toISOString().split('T')[0]}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    });

    // Filter listener
    filterSelect.addEventListener('change', () => {
      render(filterSelect.value);
    });

    // Run on load
    loadHistory();
  });
</script>
