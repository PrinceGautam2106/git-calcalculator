---
/**
 * /src/pages/index.astro — Homepage
 * Target keywords: fitness calculator, free health calculators, BMI TDEE calories calculator
 * Vercel-style design: dark hero, minimal, conversion-focused
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaScript from '../components/seo/SchemaScript.astro';
import { generateTitle, generateDescription, generateCanonical, generateWebSiteSchema, combineSchemas } from '../utils/seo';

const TITLE     = generateTitle('Free Fitness Calculators — BMI, TDEE, Calories & More');
const DESC      = generateDescription('Free science-backed fitness calculators: BMI, TDEE, BMR, body fat %, calories, macros, water intake and more. Results are instant, 100% private — nothing leaves your device.');
const CANONICAL = generateCanonical('/');

const websiteSchema = generateWebSiteSchema();
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: TITLE,
  description: DESC,
  url: CANONICAL,
  isPartOf: { '@id': 'https://www.calaifitness.com' },
  about: {
    '@type': 'Thing',
    name: 'Fitness Calculators',
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: CANONICAL },
    ],
  },
};
const schema = combineSchemas(websiteSchema, webPageSchema);

const calculators = [
  {
    slug: 'bmi',
    icon: '⚖️',
    name: 'BMI Calculator',
    desc: 'Body Mass Index from height & weight',
    href: '/calculator/bmi',
    keywords: 'body mass index',
  },
  {
    slug: 'tdee',
    icon: '⚡',
    name: 'TDEE Calculator',
    desc: 'Total daily energy expenditure',
    href: '/calculator/tdee',
    keywords: 'maintenance calories',
  },
  {
    slug: 'bmr',
    icon: '🔥',
    name: 'BMR Calculator',
    desc: 'Calories burned at complete rest',
    href: '/calculator/bmr',
    keywords: 'basal metabolic rate',
  },
  {
    slug: 'body-fat',
    icon: '📊',
    name: 'Body Fat %',
    desc: 'US Navy circumference method',
    href: '/calculator/body-fat',
    keywords: 'body fat percentage',
  },
  {
    slug: 'ideal-weight',
    icon: '🎯',
    name: 'Ideal Weight',
    desc: 'Based on 5 medical formulas',
    href: '/calculator/ideal-weight',
    keywords: 'healthy weight range',
  },
  {
    slug: 'calories',
    icon: '🍎',
    name: 'Calorie Target',
    desc: 'Daily calories for your goal',
    href: '/calculator/calories',
    keywords: 'calorie calculator',
  },
  {
    slug: 'macros',
    icon: '🥗',
    name: 'Macro Split',
    desc: 'Protein, carbs & fat breakdown',
    href: '/calculator/macros',
    keywords: 'macro calculator',
  },
  {
    slug: 'water',
    icon: '💧',
    name: 'Water Intake',
    desc: 'Daily hydration goal',
    href: '/calculator/water',
    keywords: 'water intake calculator',
  },
  {
    slug: 'heart-rate',
    icon: '❤️',
    name: 'Heart Rate Zones',
    desc: 'Training intensity zones',
    href: '/calculator/heart-rate',
    keywords: 'heart rate calculator',
  },
  {
    slug: 'lean-mass',
    icon: '💪',
    name: 'Lean Body Mass',
    desc: 'Muscle vs fat mass estimate',
    href: '/calculator/lean-mass',
    keywords: 'lean body mass calculator',
  },
];

const features = [
  {
    icon: '🔒',
    title: 'Private by Default',
    body: 'Every calculation runs entirely in your browser using JavaScript. No data is ever sent to our servers, logged, or sold. What you enter stays on your device — always.',
    stat: '0 bytes',
    statLabel: 'sent to servers',
  },
  {
    icon: '🧬',
    title: 'Medically Referenced',
    body: 'We use only peer-reviewed formulas: Mifflin-St Jeor for BMR/TDEE, the US Navy method for body fat, WHO BMI standards, and the Karvonen formula for heart rate zones.',
    stat: '10+',
    statLabel: 'validated formulas',
  },
  {
    icon: '📊',
    title: 'Track Over Time',
    body: 'Your results are saved automatically to your browser\'s local storage. Open the dashboard to see your history and track how your numbers change week over week.',
    stat: '100%',
    statLabel: 'on-device storage',
  },
];

const steps = [
  {
    num: '01',
    title: 'Choose a Calculator',
    body: 'Pick from 10 free calculators covering every key fitness metric — from BMI to body fat to daily calories.',
  },
  {
    num: '02',
    title: 'Enter Your Stats',
    body: 'Input your measurements in metric or imperial units. Our clean, distraction-free interface takes seconds to fill out.',
  },
  {
    num: '03',
    title: 'Get Your Result Instantly',
    body: 'Results appear immediately, with context, categories, and advice. Save to history to track your progress over time.',
  },
];

const faqs = [
  {
    q: 'What is TDEE and why does it matter?',
    a: 'TDEE (Total Daily Energy Expenditure) is the total calories your body burns each day, including activity. It\'s the most important number in nutrition — knowing it lets you set an exact calorie target for fat loss, maintenance, or muscle gain.',
    link: '/calculator/tdee',
  },
  {
    q: 'How accurate is a BMI calculator?',
    a: 'BMI is accurate as a population-level screening tool for adults. It has known limitations for athletes and older adults due to muscle mass differences. For a complete picture, pair it with body fat percentage.',
    link: '/calculator/bmi',
  },
  {
    q: 'Is my data private? Do you track anything?',
    a: 'Completely private. All calculations run in your browser — nothing is ever sent to our servers. We have no database of user data. Your history is stored in your browser\'s localStorage only.',
    link: '/privacy',
  },
];

const articles = [
  {
    title: 'How to Calculate Your TDEE (And Actually Use It)',
    excerpt: 'Your TDEE is the single most important number in nutrition. Here\'s how to find it and use it to lose fat or build muscle.',
    date: 'June 1, 2026',
    slug: 'how-to-calculate-tdee',
    category: 'Nutrition',
    readTime: 7,
  },
  {
    title: 'BMI vs Body Fat %: Which One Actually Matters?',
    excerpt: 'BMI is a blunt tool. Body fat percentage tells you far more. Here\'s when to use each and what the numbers really mean.',
    date: 'June 8, 2026',
    slug: 'bmi-vs-body-fat',
    category: 'Metrics',
    readTime: 6,
  },
  {
    title: 'How Much Protein Do You Actually Need?',
    excerpt: 'The research is clear, the internet is noisy. We break down the optimal protein intake for muscle gain, fat loss, and general health.',
    date: 'June 15, 2026',
    slug: 'how-much-protein-do-you-need',
    category: 'Nutrition',
    readTime: 8,
  },
];
---

<BaseLayout
  title={TITLE}
  description={DESC}
  canonical={CANONICAL}
>
  <SchemaScript slot="head" schema={schema} />

  <!-- ═══════════════════════════════════════════════════════
       SECTION 1 — HERO
       Dark background, grid pattern, bold headline, dual CTA
  ════════════════════════════════════════════════════════════ -->
  <section
    id="hero"
    class="hero-section relative isolate overflow-hidden"
    aria-labelledby="hero-headline"
  >
    <!-- CSS-only grid background -->
    <div class="hero-grid" aria-hidden="true"></div>
    <!-- Gradient fade at bottom -->
    <div class="hero-fade" aria-hidden="true"></div>
    <!-- Radial glow -->
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="container-site relative z-10 py-24 sm:py-32 md:py-40 text-center">

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 mb-8 border border-[var(--color-hairline)] rounded-sm bg-[var(--color-canvas)]/60 backdrop-blur-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] inline-block animate-pulse-glow" aria-hidden="true"></span>
        <span class="text-xs font-semibold text-[var(--color-body)] uppercase tracking-widest">14 Free Calculators · No Account Required</span>
      </div>

      <!-- Headline -->
      <h1
        id="hero-headline"
        class="text-hero-headline mb-6"
      >
        <span class="block text-[var(--color-ink)]">Your Body.</span>
        <span class="block text-[var(--color-ink)]">Your Numbers.</span>
        <span class="block gradient-text">Your Privacy.</span>
      </h1>

      <!-- Subheadline -->
      <p class="text-body-lg text-[var(--color-body)] max-w-xl mx-auto mb-10 leading-relaxed">
        Science-backed fitness calculators that run&nbsp;
        <strong class="text-[var(--color-ink)] font-medium">100% on your device.</strong>
        No ads, no tracking, no data sent to servers.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-10">
        <a
          href="/calculator/bmi"
          id="hero-cta-primary"
          class="cta-primary group"
        >
          Try BMI Calculator
          <svg class="w-4 h-4 transition-transform duration-150 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/calculators"
          id="hero-cta-secondary"
          class="cta-secondary group"
        >
          See All Tools
          <svg class="w-4 h-4 transition-transform duration-150 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Trust Badges -->
      <div
        class="flex flex-wrap items-center justify-center gap-3 sm:gap-5"
        role="list"
        aria-label="Trust signals"
      >
        {[
          { icon: '🔒', label: 'Private by Design' },
          { icon: '⚡', label: 'Instant Results' },
          { icon: '🧬', label: 'Science-Backed' },
          { icon: '🆓', label: 'Always Free' },
        ].map(badge => (
          <div
            role="listitem"
            class="flex items-center gap-1.5 text-xs font-medium text-[var(--color-mute)]"
          >
            <span aria-hidden="true">{badge.icon}</span>
            <span>{badge.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 2 — CALCULATOR GRID
  ════════════════════════════════════════════════════════════ -->
  <section
    id="calculators"
    class="container-site py-16 sm:py-20"
    aria-labelledby="calculators-heading"
  >
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <div class="flex items-center gap-2.5 mb-2">
          <h2
            id="calculators-heading"
            class="text-display-md text-[var(--color-ink)]"
          >
            14 Free Calculators
          </h2>
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-sm bg-[var(--color-primary)] text-white text-xs font-bold" aria-hidden="true">14</span>
        </div>
        <p class="text-body-sm text-[var(--color-mute)]">
          Every key fitness metric — one tool, zero friction
        </p>
      </div>
      <a
        href="/calculators"
        class="text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors duration-150 flex items-center gap-1 shrink-0"
        aria-label="View all calculators"
      >
        View all →
      </a>
    </div>

    <!-- Grid -->
    <div
      class="calc-grid"
      role="list"
      aria-label="Available calculators"
    >
      {calculators.map((calc, i) => (
        <a
          href={calc.href}
          role="listitem"
          id={`calc-card-${calc.slug}`}
          class="calc-card group"
          aria-label={`${calc.name}: ${calc.desc}`}
        >
          <!-- Icon -->
          <div class="calc-card-icon" aria-hidden="true">{calc.icon}</div>

          <!-- Text -->
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-[var(--color-ink)] leading-tight mb-0.5 truncate">
              {calc.name}
            </p>
            <p class="text-xs text-[var(--color-mute)] leading-tight line-clamp-2">
              {calc.desc}
            </p>
          </div>

          <!-- Arrow -->
          <div class="calc-card-arrow" aria-hidden="true">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section Divider -->
  <div class="container-site"><hr class="border-[var(--color-hairline)]" /></div>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 3 — WHY CHOOSE THIS
  ════════════════════════════════════════════════════════════ -->
  <section
    id="features"
    class="container-site py-16 sm:py-20"
    aria-labelledby="features-heading"
  >
    <div class="mb-10 text-center sm:text-left">
      <p class="text-label text-[var(--color-mute)] mb-2">Why CalaiFitness</p>
      <h2
        id="features-heading"
        class="text-display-md text-[var(--color-ink)]"
      >
        Built Different
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-[var(--color-hairline)] border border-[var(--color-hairline)] rounded-sm overflow-hidden">
      {features.map((f, i) => (
        <div class="feature-card">
          <!-- Icon -->
          <div class="text-3xl mb-4" aria-hidden="true">{f.icon}</div>

          <!-- Title -->
          <h3 class="text-display-sm mb-3 text-[var(--color-ink)]">{f.title}</h3>

          <!-- Body -->
          <p class="text-body-sm text-[var(--color-body)] leading-relaxed mb-6 flex-1">{f.body}</p>

          <!-- Stat -->
          <div class="feature-stat">
            <p class="text-2xl font-mono font-semibold text-[var(--color-ink)] leading-none">{f.stat}</p>
            <p class="text-xs text-[var(--color-mute)] mt-1">{f.statLabel}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section Divider -->
  <div class="container-site"><hr class="border-[var(--color-hairline)]" /></div>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 4 — HOW IT WORKS
  ════════════════════════════════════════════════════════════ -->
  <section
    id="how-it-works"
    class="container-site py-16 sm:py-20"
    aria-labelledby="how-heading"
  >
    <div class="mb-10 text-center sm:text-left">
      <p class="text-label text-[var(--color-mute)] mb-2">Simple by Design</p>
      <h2
        id="how-heading"
        class="text-display-md text-[var(--color-ink)]"
      >
        How It Works
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-0 sm:gap-px bg-transparent sm:bg-[var(--color-hairline)] border-0 sm:border sm:border-[var(--color-hairline)] sm:rounded-sm overflow-hidden">
      {steps.map((step, i) => (
        <div class="step-card">
          <!-- Step number -->
          <div class="step-number" aria-hidden="true">{step.num}</div>
          <div class="w-px h-6 bg-[var(--color-hairline)] my-4 hidden sm:block" aria-hidden="true"></div>

          <!-- Content -->
          <h3 class="text-display-sm mb-2 text-[var(--color-ink)]">{step.title}</h3>
          <p class="text-body-sm text-[var(--color-body)] leading-relaxed">{step.body}</p>

          {i < steps.length - 1 && (
            <div class="sm:hidden mt-6 border-b border-[var(--color-hairline)]" aria-hidden="true"></div>
          )}
        </div>
      ))}
    </div>

    <!-- CTA below steps -->
    <div class="mt-8 text-center sm:text-left">
      <a href="/calculator/bmi" class="cta-primary inline-flex">
        Start with BMI →
      </a>
    </div>
  </section>

  <!-- Section Divider -->
  <div class="container-site"><hr class="border-[var(--color-hairline)]" /></div>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 5 — FAQ PREVIEW
  ════════════════════════════════════════════════════════════ -->
  <section
    id="faq-preview"
    class="container-site py-16 sm:py-20"
    aria-labelledby="faq-heading"
  >
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="text-label text-[var(--color-mute)] mb-2">Quick Answers</p>
        <h2
          id="faq-heading"
          class="text-display-md text-[var(--color-ink)]"
        >
          Common Questions
        </h2>
      </div>
      <a
        href="/faq"
        class="text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors duration-150 shrink-0"
      >
        View all FAQs →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {faqs.map(faq => (
        <div class="faq-card">
          <h3 class="text-body-sm font-semibold text-[var(--color-ink)] mb-2 leading-snug">{faq.q}</h3>
          <p class="text-body-sm text-[var(--color-body)] leading-relaxed flex-1">{faq.a}</p>
          <a
            href={faq.link}
            class="inline-flex items-center gap-1 mt-4 text-xs font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors duration-150"
          >
            Learn more →
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Section Divider -->
  <div class="container-site"><hr class="border-[var(--color-hairline)]" /></div>

  <!-- ═══════════════════════════════════════════════════════
       SECTION 6 — BLOG PREVIEW
  ════════════════════════════════════════════════════════════ -->
  <section
    id="blog-preview"
    class="container-site py-16 sm:py-20"
    aria-labelledby="blog-heading"
  >
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-8">
      <div>
        <p class="text-label text-[var(--color-mute)] mb-2">Science-Based Articles</p>
        <h2
          id="blog-heading"
          class="text-display-md text-[var(--color-ink)]"
        >
          Evidence-Based Insights
        </h2>
      </div>
      <a
        href="/blog"
        class="text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors duration-150 shrink-0"
      >
        View all articles →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {articles.map(article => (
        <article class="blog-card group">
          <!-- Meta -->
          <div class="flex items-center gap-2 mb-3">
            <span class="text-xs font-semibold text-[var(--color-mute)] uppercase tracking-wider">{article.category}</span>
            <span class="text-[var(--color-hairline)]">·</span>
            <time class="text-xs text-[var(--color-mute)]">{article.date}</time>
            <span class="text-[var(--color-hairline)]">·</span>
            <span class="text-xs text-[var(--color-mute)]">{article.readTime}m</span>
          </div>

          <!-- Title -->
          <h3 class="text-display-sm mb-2 text-[var(--color-ink)] group-hover:text-[var(--color-primary)] transition-colors duration-150 leading-snug">
            <a href={`/blog/${article.slug}`} class="focus:outline-none focus-visible:underline">
              {article.title}
            </a>
          </h3>

          <!-- Excerpt -->
          <p class="text-body-sm text-[var(--color-body)] leading-relaxed flex-1">{article.excerpt}</p>

          <!-- Read link -->
          <a
            href={`/blog/${article.slug}`}
            class="inline-flex items-center gap-1 mt-4 text-xs font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] transition-colors duration-150"
            aria-label={`Read article: ${article.title}`}
          >
            Read article →
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       BOTTOM CTA STRIP
  ════════════════════════════════════════════════════════════ -->
  <section
    class="border-t border-[var(--color-hairline)] bg-[var(--color-canvas-soft)]"
    aria-label="Call to action"
  >
    <div class="container-site py-16 text-center">
      <h2 class="text-display-md text-[var(--color-ink)] mb-3">
        Ready to know your numbers?
      </h2>
      <p class="text-body-md text-[var(--color-body)] mb-8 max-w-md mx-auto">
        No sign-up. No ads. Results in under 30 seconds. Everything stays on your device.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/calculator/bmi" class="cta-primary group">
          Get Started Free
          <svg class="w-4 h-4 transition-transform duration-150 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/calculators" class="cta-secondary group">
          Browse All Tools →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* ═══════════════════════════════════════════════════════
   HERO SECTION
════════════════════════════════════════════════════════ */
.hero-section {
  background-color: var(--color-bg);
  min-height: 88dvh;
  display: flex;
  align-items: center;
}

/* CSS grid pattern */
.hero-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(var(--color-hairline) 1px, transparent 1px),
    linear-gradient(90deg, var(--color-hairline) 1px, transparent 1px);
  background-size: 40px 40px;
  mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, black 30%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 0%, black 30%, transparent 100%);
  opacity: 0.5;
}

/* Bottom fade to page bg */
.hero-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: linear-gradient(to bottom, transparent, var(--color-bg));
  pointer-events: none;
}

/* Subtle radial glow */
.hero-glow {
  position: absolute;
  top: -10%;
  left: 50%;
  transform: translateX(-50%);
  width: 700px;
  height: 400px;
  background: radial-gradient(
    ellipse at center,
    rgba(59, 130, 246, 0.08) 0%,
    transparent 70%
  );
  pointer-events: none;
}

/* Headline typography */
.text-hero-headline {
  font-family: var(--font-sans);
  font-size: clamp(2.5rem, 7vw, 5rem);
  font-weight: 600;
  line-height: 1.05;
  letter-spacing: -0.04em;
}

/* ═══════════════════════════════════════════════════════
   GRADIENT TEXT (hero last line)
════════════════════════════════════════════════════════ */
.gradient-text {
  background: linear-gradient(135deg, #3B82F6 0%, #06B6D4 40%, #8B5CF6 80%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* ═══════════════════════════════════════════════════════
   CTAs
════════════════════════════════════════════════════════ */
.cta-primary {
