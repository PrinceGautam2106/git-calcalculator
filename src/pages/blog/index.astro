---
/**
 * /blog/index.astro — Blog Index
 * Science-backed fitness insights index page with interactive tag filtering and featured post pinning.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchemaScript from '../../components/seo/SchemaScript.astro';
import { generateTitle, generateDescription, generateCanonical, combineSchemas } from '../../utils/seo';

const TITLE     = generateTitle('Fitness Blog — Science-Backed Health & Nutrition Articles');
const DESC      = generateDescription('Read science-backed articles on nutrition, training, fat loss, muscle building, and recovery. Practical guides written for real people with real goals.');
const CANONICAL = generateCanonical('/blog');

// Fetch and sort posts by date descending
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// Find featured post (explicit featured flag, fallback to latest)
const featuredPost = sortedPosts.find(p => p.data.featured) || sortedPosts[0];
const regularPosts = sortedPosts.filter(p => p.slug !== featuredPost?.slug);

const tags = ['All', 'Nutrition', 'Weight Loss', 'Fitness', 'Health'];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.calaifitness.com' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: CANONICAL },
  ],
};

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: TITLE,
  description: DESC,
  url: CANONICAL,
};

const schema = combineSchemas(breadcrumbSchema, webPageSchema);
---

<BaseLayout
  title={TITLE}
  description={DESC}
  canonical={CANONICAL}
>
  <SchemaScript slot="head" schema={schema} />

  <div class="container-site py-16 sm:py-20">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol role="list">
        <li>
          <a href="/" class="breadcrumb-link">Home</a>
          <span class="breadcrumb-sep" aria-hidden="true">›</span>
        </li>
        <li>
          <span class="breadcrumb-current" aria-current="page">Blog</span>
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10 sm:mb-12">
      <p class="text-label text-[var(--color-mute)] mb-2">Science-Based Insights</p>
      <h1 class="text-display-md text-[var(--color-ink)] mb-4">
        Evidence-Based Fitness Insights
      </h1>
      <p class="text-body-md text-[var(--color-body)] max-w-2xl leading-relaxed">
        No fitness fads, no sponsor-backed claims, and no pseudoscience. Just clear, peer-reviewed explanations
        of how the body operates, written by trainers and nutrition scientists.
      </p>
    </header>

    <!-- Interactive Tags Filter Bar -->
    <div class="filter-bar-wrap mb-10">
      <div class="filter-bar" role="tablist" aria-label="Filter blog posts by tag">
        {tags.map((tag, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? "true" : "false"}
            class={`filter-btn ${idx === 0 ? "active" : ""}`}
            data-filter={tag.toLowerCase().replace(' ', '-')}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>

    <!-- Featured Post (Pinned at top, large layout) -->
    {featuredPost && (
      <div class="featured-post-container mb-12" data-tags={featuredPost.data.tags.map(t => t.toLowerCase().replace(' ', '-')).join(',')}>
        <article class="featured-card group">
          <div class="featured-emoji" aria-hidden="true">
            {featuredPost.data.heroEmoji}
          </div>
          <div class="featured-content">
            <div class="meta-row">
              <span class="category-badge">{featuredPost.data.tags[0]}</span>
              <span class="meta-sep" aria-hidden="true">·</span>
              <time datetime={featuredPost.data.publishDate.toISOString()}>
                {featuredPost.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
              </time>
              <span class="meta-sep" aria-hidden="true">·</span>
              <span>{featuredPost.data.readTime || 5} min read</span>
              <span class="featured-badge">Featured</span>
            </div>
            <h2 class="featured-title group-hover:text-[var(--color-primary)]">
              <a href={`/blog/${featuredPost.slug}`}>
                {featuredPost.data.title}
              </a>
            </h2>
            <p class="featured-desc">
              {featuredPost.data.description}
            </p>
            <a href={`/blog/${featuredPost.slug}`} class="read-link" aria-label={`Read featured post: ${featuredPost.data.title}`}>
              Read article →
            </a>
          </div>
        </article>
      </div>
    )}

    <!-- Regular Posts Grid -->
    <div
      class="blog-grid"
      id="blog-posts-grid"
      role="list"
      aria-label="Blog posts list"
    >
      {regularPosts.map(post => (
        <article
          class="blog-card-item group"
          role="listitem"
          data-tags={post.data.tags.map(t => t.toLowerCase().replace(' ', '-')).join(',')}
        >
          <div class="card-emoji" aria-hidden="true">
            {post.data.heroEmoji || '📝'}
          </div>
          <div class="card-meta">
            <span class="category-badge">{post.data.tags[0]}</span>
            <span class="meta-sep" aria-hidden="true">·</span>
            <time datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span>{post.data.readTime || 5}m read</span>
          </div>
          <h3 class="card-title group-hover:text-[var(--color-primary)]">
            <a href={`/blog/${post.slug}`}>
              {post.data.title}
            </a>
          </h3>
          <p class="card-desc">
            {post.data.description}
          </p>
          <a href={`/blog/${post.slug}`} class="read-link" aria-label={`Read: ${post.data.title}`}>
            Read article →
          </a>
        </article>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="empty-state hidden" role="status">
      <p class="empty-state-text">No articles found in this category.</p>
    </div>

  </div>
</BaseLayout>

<style>
.breadcrumb {
  margin-bottom: 24px;
}
.breadcrumb ol {
  display: flex;
  align-items: center;
  list-style: none;
  padding: 0;
  margin: 0;
}
.breadcrumb-link {
  font-size: 0.8125rem;
  color: var(--color-mute);
  text-decoration: none;
}
.breadcrumb-link:hover { color: var(--color-ink); }
.breadcrumb-sep {
  font-size: 0.8125rem;
  color: var(--color-hairline-strong);
  padding-inline: 6px;
}
.breadcrumb-current {
  font-size: 0.8125rem;
  color: var(--color-body);
}

/* Filter bar */
.filter-bar-wrap {
  border-bottom: 1px solid var(--color-hairline);
  padding-bottom: 12px;
}
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}
.filter-btn {
  background: transparent;
  border: 1px solid transparent;
  color: var(--color-mute);
  font-size: 0.875rem;
  font-weight: 500;
  padding: 6px 14px;
  border-radius: 4px;
  cursor: pointer;
  transition: all 150ms ease;
}
.filter-btn:hover {
  color: var(--color-ink);
  background-color: var(--color-canvas-soft);
}
.filter-btn.active {
  border-color: var(--color-hairline-strong);
  color: var(--color-ink);
  background-color: var(--color-canvas);
}

/* Featured Card */
.featured-card {
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding: 24px;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  background-color: var(--color-canvas);
  transition: border-color 150ms ease;
}
@media (min-width: 768px) {
  .featured-card {
    flex-direction: row;
    padding: 32px;
    align-items: center;
  }
}
.featured-card:hover {
  border-color: var(--color-border-strong);
}
.featured-emoji {
  font-size: 4rem;
  line-height: 1;
  flex-shrink: 0;
  text-align: center;
}
.featured-content {
  flex: 1;
  min-width: 0;
}
.meta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--color-mute);
  margin-bottom: 12px;
}
.category-badge {
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-primary);
}
.meta-sep {
  color: var(--color-hairline-strong);
}
.featured-badge {
  margin-left: auto;
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 2px 6px;
  border: 1px solid var(--color-primary-deep);
  color: var(--color-primary-deep);
  border-radius: 3px;
}
.dark .featured-badge {
  color: var(--color-primary);
  border-color: var(--color-primary);
}
.featured-title {
  font-size: clamp(1.25rem, 3vw, 1.75rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  color: var(--color-ink);
  margin: 0 0 10px;
  line-height: 1.25;
  transition: color 150ms ease;
}
.featured-title a {
  text-decoration: none;
  color: inherit;
}
.featured-desc {
  font-size: 0.9375rem;
  color: var(--color-body);
  line-height: 1.6;
  margin: 0 0 16px;
}

/* Regular Grid */
.blog-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}
@media (min-width: 640px) {
  .blog-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (min-width: 1024px) {
  .blog-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.blog-card-item {
  display: flex;
  flex-direction: column;
  padding: 20px;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  background-color: var(--color-canvas);
  transition: border-color 150ms ease;
}
.blog-card-item:hover {
  border-color: var(--color-border-strong);
}
.card-emoji {
  font-size: 2.25rem;
  margin-bottom: 16px;
}
.card-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.75rem;
  color: var(--color-mute);
  margin-bottom: 8px;
}
.card-title {
  font-size: 1.0625rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--color-ink);
  margin: 0 0 8px;
  line-height: 1.35;
  transition: color 150ms ease;
}
.card-title a {
  text-decoration: none;
  color: inherit;
}
.card-desc {
  font-size: 0.8125rem;
  color: var(--color-body);
  line-height: 1.5;
  margin: 0 0 16px;
  flex: 1;
}

.read-link {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--color-primary);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  transition: color 150ms ease;
}
.read-link:hover {
  color: var(--color-primary-hover);
}

.empty-state {
  text-align: center;
  padding: 48px 24px;
  border: 1px dashed var(--color-hairline);
  border-radius: 4px;
}
.empty-state-text {
  font-size: 0.875rem;
  color: var(--color-mute);
}

.hidden { display: none !important; }
</style>

<script>
  // Client-side instant tag filtering
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.filter-btn');
    const featuredContainer = document.querySelector('.featured-post-container') as HTMLElement | null;
    const gridItems = document.querySelectorAll('.blog-card-item');
    const emptyState = document.getElementById('empty-state');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active button state
        buttons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-selected', 'true');

        const activeTag = btn.getAttribute('data-filter') || 'all';

        let visibleCount = 0;

        // 1. Handle Featured Post
        if (featuredContainer) {
          const featuredTags = featuredContainer.getAttribute('data-tags')?.split(',') || [];
          if (activeTag === 'all' || featuredTags.includes(activeTag)) {
            featuredContainer.classList.remove('hidden');
            visibleCount++;
          } else {
            featuredContainer.classList.add('hidden');
          }
        }

        // 2. Handle Regular Cards
        gridItems.forEach(item => {
          const itemTags = item.getAttribute('data-tags')?.split(',') || [];
          if (activeTag === 'all' || itemTags.includes(activeTag)) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        // 3. Handle Empty State
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    });
  });
</script>
