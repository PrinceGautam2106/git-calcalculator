---
/**
 * 404.astro — Custom 404 Page
 * Features a friendly fitness message, an instant client-side filtered search box,
 * and a list of popular calculators for easy navigation back.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SchemaScript from '../components/seo/SchemaScript.astro';
import { generateTitle, generateDescription, generateCanonical } from '../utils/seo';

const TITLE     = generateTitle('Page Not Found');
const DESC      = generateDescription('This page got lost on its fitness journey. Search our free tools to find what you need.');
const CANONICAL = generateCanonical('/404');

const calculators = [
  { title: 'TDEE Calculator', description: 'Total Daily Energy Expenditure baseline.', icon: '⚡', href: '/calculator/tdee' },
  { title: 'Calorie Target', description: 'Set daily calories for fat loss or muscle gain.', icon: '🍎', href: '/calculator/calories' },
  { title: 'Macro Split', description: 'Grams of protein, carbs, and fat daily.', icon: '🥗', href: '/calculator/macros' },
  { title: 'BMI Calculator', description: 'Standard height-weight health screening.', icon: '⚖️', href: '/calculator/bmi' },
  { title: 'Body Fat %', description: 'US Navy circumference body composition estimate.', icon: '📊', href: '/calculator/body-fat' },
  { title: 'BMR Calculator', description: 'Your resting basal metabolic calorie burn.', icon: '🔥', href: '/calculator/bmr' },
  { title: 'Ideal Weight', description: 'Target weights using 5 clinical formulas.', icon: '🎯', href: '/calculator/ideal-weight' },
  { title: 'Protein Intake', description: 'Daily protein targets based on lean mass.', icon: '🥩', href: '/calculator/protein' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: TITLE,
  description: DESC,
  url: CANONICAL,
};
---

<BaseLayout
  title={TITLE}
  description={DESC}
  canonical={CANONICAL}
>
  <SchemaScript slot="head" schema={schema} />

  <div class="container-site py-16 sm:py-24 text-center">

    <!-- Header Section -->
    <header class="mb-10 sm:mb-12 max-w-xl mx-auto">
      <div class="text-6xl mb-6" aria-hidden="true">🏃‍♂️</div>
      <h1 class="text-display-md text-[var(--color-ink)] mb-4">
        This page got lost on its fitness journey
      </h1>
      <p class="text-body-md text-[var(--color-body)] leading-relaxed">
        Don't worry — deviations happen. Let's get you back on track. Use the search below to find any of our tools, or browse popular choices.
      </p>
    </header>

    <!-- Search box -->
    <div class="search-box-container mb-12">
      <div class="search-input-wrap">
        <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="search"
          id="calc-search"
          class="search-input"
          placeholder="Search calculators... (e.g. TDEE, fat, calorie)"
          aria-label="Search calculators"
          autocomplete="off"
        />
      </div>
    </div>

    <!-- Calculators Grid -->
    <div class="grid-section max-w-4xl mx-auto">
      <h2 class="grid-section-h2">Popular Calculators</h2>

      <div
        class="calculators-grid"
        id="404-calculators-grid"
        role="list"
        aria-label="Calculators list"
      >
        {calculators.map(calc => (
          <a
            href={calc.href}
            role="listitem"
            class="calculator-card group"
            data-title={calc.title.toLowerCase()}
            data-desc={calc.description.toLowerCase()}
            aria-label={`${calc.title}: ${calc.description}`}
          >
            <div class="card-icon" aria-hidden="true">{calc.icon}</div>
            <div class="card-content">
              <h3 class="card-title">{calc.title}</h3>
              <p class="card-desc">{calc.description}</p>
            </div>
            <div class="card-arrow" aria-hidden="true">→</div>
          </a>
        ))}
      </div>

      <!-- No results state -->
      <div id="no-results-msg" class="no-results hidden" role="status">
        <p>No calculators matched your search.</p>
      </div>
    </div>

    <!-- Back Home Button -->
    <div class="mt-14">
      <a href="/" class="home-btn-link">
        ← Go Back Home
      </a>
    </div>

  </div>
</BaseLayout>

<style>
.search-box-container {
  max-width: 480px;
  margin-inline: auto;
}

.search-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.search-icon {
  position: absolute;
  left: 12px;
  width: 16px;
  height: 16px;
  color: var(--color-mute);
  pointer-events: none;
}

.search-input {
  width: 100%;
  height: 42px;
  padding: 0 16px 0 38px;
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--color-ink);
  background-color: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  outline: none;
  transition: border-color 150ms ease, box-shadow 150ms ease;
}

.search-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

/* Grid styles */
.grid-section {
  text-align: left;
}
.grid-section-h2 {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-mute);
  margin: 0 0 16px;
  text-align: center;
}

.calculators-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12px;
}

@media (min-width: 640px) {
  .calculators-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.calculator-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  background-color: var(--color-canvas);
  text-decoration: none;
  transition: border-color 150ms ease, background-color 150ms ease;
  position: relative;
}

.calculator-card:hover {
  border-color: var(--color-border-strong);
  background-color: var(--color-canvas-soft);
}

.calculator-card:hover .card-arrow {
  opacity: 1;
  transform: translateX(0);
}

.card-icon {
  font-size: 1.5rem;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 2px;
  line-height: 1.2;
}

.card-desc {
  font-size: 0.75rem;
  color: var(--color-body);
  margin: 0;
  line-height: 1.3;
}

.card-arrow {
  color: var(--color-mute);
  font-size: 0.875rem;
  font-weight: 600;
  opacity: 0;
  transform: translateX(-4px);
  transition: opacity 150ms ease, transform 150ms ease;
}

.no-results {
  text-align: center;
  padding: 32px 16px;
  color: var(--color-mute);
  font-size: 0.875rem;
}

/* Home link */
.home-btn-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20px;
  height: 38px;
  background-color: transparent;
  color: var(--color-body);
  font-size: 0.875rem;
  font-weight: 500;
  border: 1px solid var(--color-hairline);
  border-radius: 4px;
  text-decoration: none;
  transition: border-color 150ms ease, color 150ms ease;
}

.home-btn-link:hover {
  border-color: var(--color-border-strong);
  color: var(--color-ink);
}

.hidden { display: none !important; }
</style>

<script>
  // Client-side filtering for 404 search
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('calc-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('#404-calculators-grid .calculator-card');
    const noResults = document.getElementById('no-results-msg');
    const grid = document.getElementById('404-calculators-grid');

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        const query = searchInput.value.toLowerCase().trim();
        let matchCount = 0;

        cards.forEach(card => {
          const title = card.getAttribute('data-title') || '';
          const desc = card.getAttribute('data-desc') || '';

          if (title.includes(query) || desc.includes(query)) {
            card.classList.remove('hidden');
            matchCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (noResults && grid) {
          if (matchCount === 0) {
            noResults.classList.remove('hidden');
            grid.classList.add('hidden');
          } else {
            noResults.classList.add('hidden');
            grid.classList.remove('hidden');
          }
        }
      });
    }
  });
</script>
